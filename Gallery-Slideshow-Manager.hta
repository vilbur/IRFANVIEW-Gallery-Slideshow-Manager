<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta charset="utf-8" />
<title>Gallery Slideshow Manager 1.02</title>
<hta:application
    id="galleryApp"
    applicationname="Gallery Slideshow Manager"
    border="thin"
    borderstyle="normal"
    caption="yes"
    contextmenu="no"
    icon="Gallery-Slideshow-Manager.ico"
    maximizebutton="yes"
    minimizebutton="yes"
    navigable="no"
    scroll="yes"
    selection="yes"
    showintaskbar="yes"
    singleinstance="yes"
    sysmenu="yes"
    windowstate="normal"
/>
<style>
html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    min-height: 100%;
    overflow: hidden;
    background: #101216;
    color: #edf2f8;
    font-family: "Segoe UI", Arial, sans-serif;
}
body {
    overflow: hidden;
}
* {
    box-sizing: border-box;
}
button, input {
    font-family: "Segoe UI", Arial, sans-serif;
}
button {
    border: 1px solid #3d4654;
    border-radius: 7px;
    background: #252b34;
    color: #edf2f8;
    padding: 8px 13px;
    cursor: pointer;
}
button:hover {
    background: #303846;
    border-color: #587099;
}
button.primary {
    background: #2f6fda;
    border-color: #4382ec;
}
button.primary:hover {
    background: #397be8;
}
button.danger {
    background: #5b2930;
    border-color: #8c424d;
}
input[type=text] {
    border: 1px solid #343c48;
    border-radius: 7px;
    background: #171a20;
    color: #edf2f8;
    padding: 9px 11px;
    outline: none;
}
input[type=text]:focus {
    border-color: #4d88e6;
}
#appShell {
    position: relative;
    min-width: 880px;
    width: 100%;
    height: 100%;
    overflow: hidden;
}
#fixedControls {
    position: fixed;
    z-index: 40;
    left: 0;
    top: 0;
    right: 0;
    background: #171a20;
    box-shadow: 0 4px 14px rgba(0,0,0,0.30);
}
#topBar {
    padding: 16px 18px 10px 18px;
    background: #171a20;
    border-bottom: 1px solid #2b313b;
}
#optionsRollout,
#keywordsRollout {
    margin-bottom: 10px;
    border: 1px solid #303844;
    border-radius: 9px;
    overflow: hidden;
    background: #15191f;
}
#optionsRolloutHeader,
#keywordsRolloutHeader {
    display: flex;
    align-items: center;
    width: 100%;
    height: 38px;
    padding: 0 12px;
    border: 0;
    border-radius: 0;
    background: #202630;
    color: #edf2f8;
    text-align: left;
}
#optionsRolloutHeader:hover,
#keywordsRolloutHeader:hover {
    background: #272e39;
}
#optionsRolloutArrow,
#keywordsRolloutArrow {
    width: 18px;
    color: #8fbfff;
    font-size: 17px;
    font-weight: 700;
    text-align: center;
}
#optionsRolloutTitle,
#keywordsRolloutTitle {
    margin-left: 5px;
    font-size: 13px;
    font-weight: 700;
}
#optionsRolloutSummary,
#keywordsRolloutSummary {
    margin-left: 10px;
    color: #8e9aaa;
    font-size: 11px;
    font-weight: 400;
}
#optionsRolloutBody,
#keywordsRolloutBody {
    display: none;
    padding: 10px 12px 1px 12px;
    border-top: 1px solid #303844;
}
#optionsRollout.open #optionsRolloutBody,
#keywordsRollout.open #keywordsRolloutBody {
    display: block;
}
.row {
    display: flex;
    align-items: center;
    gap: 0;
    margin-bottom: 9px;
}
.row > * + * {
    margin-left: 16px;
}
.row:last-child {
    margin-bottom: 0;
}
.grow {
    flex: 1 1 auto;
}
#rootPath {
    width: 100%;
}
#remoteTimeoutSeconds {
    width: 74px;
    text-align: right;
}
#remoteTimeoutHint {
    color: #8e9aaa;
    font-size: 11px;
}
#keywordName {
    width: 210px;
}
#searchInput {
    width: 180px;
}
#filterPresetSelect {
    width: 230px;
    border: 1px solid #343c48;
    border-radius: 7px;
    background: #171a20;
    color: #edf2f8;
    padding: 8px 9px;
}
#filterPresetName {
    width: 210px;
}
#filterPresetHint {
    color: #8e9aaa;
    font-size: 11px;
}
button:disabled,
input:disabled {
    opacity: 0.45;
    cursor: default;
}
.label {
    color: #9ea9b8;
    font-size: 12px;
    margin-right: 4px;
}
#keywordFilters {
    display: block;
    width: 100%;
    min-width: 0;
}
.keywordFilterGroup {
    display: flex;
    align-items: flex-start;
    width: 100%;
    margin: 0;
}
.keywordFilterGroup + .keywordFilterGroup {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid #2c3440;
}
.keywordFilterPrefix {
    flex: 0 0 28px;
    box-sizing: border-box;
    padding: 7px 6px 0 2px;
    color: #aeb9c8;
    font-family: "Segoe UI Symbol", "Segoe UI", sans-serif;
    font-size: 18px;
    font-weight: 800;
    line-height: 24px;
    text-align: left;
}
.keywordFilterButtons {
    display: flex;
    flex: 1 1 auto;
    flex-wrap: wrap;
    column-gap: 0;
    row-gap: 7px;
    min-width: 0;
}
.keywordFilterButton {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    box-sizing: border-box;
    margin-right: 0;
    margin-left: 0;
    padding: 7px 12px;
    border: 1px solid #3a4350;
    border-radius: 8px;
    background: #20252d;
    color: #d2dae5;
    cursor: pointer;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 14px;
    font-weight: 600;
    line-height: 18px;
    text-align: left;
}
.keywordFilterButton:hover {
    border-color: #60738d;
    background: #29313c;
}
.keywordFilterButton.include {
    border-color: #4ab978;
    background: #202b26;
    color: #6fe09b;
    box-shadow: 0 0 0 1px rgba(74,185,120,0.18);
}
.keywordFilterButton.exclude {
    border-color: #d66b75;
    background: #302226;
    color: #ff7f8d;
    box-shadow: 0 0 0 1px rgba(214,107,117,0.18);
}
.keywordFilterButton.include:hover {
    border-color: #65d28f;
    background: #26352d;
}
.keywordFilterButton.exclude:hover {
    border-color: #ed7d88;
    background: #3a282d;
}
.keywordFilterWord {
    white-space: nowrap;
}
#ratingFilters {
    display: flex;
    align-items: center;
    gap: 0;
    min-height: 38px;
}
#ratingFilters .ratingFilterStar + .ratingFilterStar {
    margin-left: 16px;
}
.ratingFilterStar {
    position: relative;
    width: 34px;
    height: 36px;
    min-width: 34px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: #566171;
    cursor: pointer;
    font-family: "Segoe UI Symbol", "Segoe UI", sans-serif;
    font-size: 25px;
    line-height: 31px;
    text-align: center;
}
.ratingFilterStar:hover {
    border-color: #596577;
    background: #20262f;
    color: #f1c94a;
}
.ratingFilterStar.active {
    color: #ffd34d;
    text-shadow: 0 0 8px rgba(255, 211, 77, 0.28);
}
.ratingFilterStar.selected {
    border-color: #d7aa25;
    background: #332b16;
}
.ratingFilterStar.exact {
    border-color: #65a8ff;
    background: #18385f;
    color: #ffe063;
    box-shadow: 0 0 0 1px rgba(101,168,255,0.25);
}
#ratingFilters.unratedOnly .ratingFilterStar {
    border-color: transparent;
    background: transparent;
    color: #566171;
    box-shadow: none;
    text-shadow: none;
}
#ratingFilters.unratedOnly .ratingFilterStar:hover {
    border-color: #596577;
    background: #20262f;
    color: #f1c94a;
}
.ratingFilterNumber {
    position: absolute;
    right: 2px;
    bottom: 0;
    min-width: 11px;
    color: #aeb9c8;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 9px;
    font-weight: 700;
    line-height: 11px;
}
#ratingFilterHint {
    margin-left: 16px;
    color: #8e9aaa;
    font-size: 11px;
}
#toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    min-height: 62px;
    padding: 10px 18px;
    background: #14171c;
    border-bottom: 1px solid #292f38;
}
.toolbarZone {
    display: flex;
    align-items: center;
    align-self: center;
    flex: 0 1 auto;
    flex-wrap: nowrap;
    min-width: 0;
    height: 42px;
    min-height: 42px;
}
.toolbarZone.left {
    justify-content: flex-start;
}
.toolbarZone.right {
    justify-content: flex-end;
}
#slideshowActions {
    display: flex;
    align-self: center;
    align-items: center;
    justify-content: center;
    flex: 0 1 auto;
    flex-wrap: nowrap;
    margin: 0 16px;
    height: 42px;
    min-height: 42px;
}
.toolbarZone .toolbarControl + .toolbarControl {
    margin-left: 16px;
}
#slideshowActions .toolbarControl + .toolbarControl {
    margin-left: 16px;
}
.toolbarControl {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    height: 42px;
    min-height: 42px;
    margin: 0;
    line-height: 1.1;
    vertical-align: middle;
    white-space: nowrap;
    flex: 0 0 auto;
}
.toolbarCheckButton {
    padding: 8px 13px;
    border: 1px solid #3d4654;
    border-radius: 8px;
    background: #20252d;
    color: #aeb8c6;
    font-size: 13px;
    font-weight: 650;
    box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.04),
        0 2px 7px rgba(0,0,0,0.18);
}
.toolbarCheckButton:hover {
    border-color: #587099;
    background: #2a313c;
    color: #edf2f8;
}
.toolbarCheckButton.active {
    border-color: #4f95e8;
    background: #1f4f82;
    color: #ffffff;
    box-shadow:
        inset 0 0 0 1px rgba(145,196,255,0.16),
        0 0 0 1px rgba(79,149,232,0.14),
        0 3px 9px rgba(0,0,0,0.24);
}
.toolbarCheckButton .checkbuttonMark {
    display: inline-block;
    width: 17px;
    margin-right: 4px;
    color: #697687;
    font-weight: 900;
    text-align: center;
}
.toolbarCheckButton.active .checkbuttonMark {
    color: #bfe0ff;
}
.slideshowActionButton {
    min-width: 162px;
    padding: 9px 17px;
    font-size: 14px;
    font-weight: 850;
    letter-spacing: 0.6px;
    text-transform: uppercase;
}
@media screen and (max-width: 1180px) {
    #toolbar {
        padding-right: 10px;
        padding-left: 10px;
    }
    #slideshowActions {
        margin-right: 16px;
        margin-left: 16px;
    }
    .toolbarZone .toolbarControl + .toolbarControl,
    #slideshowActions .toolbarControl + .toolbarControl {
        margin-left: 16px;
    }
    .toolbarControl,
    .toolbarCheckButton,
    .slideshowActionButton {
        min-width: 0;
        padding-right: 8px;
        padding-left: 8px;
        font-size: 11px;
        letter-spacing: 0;
    }
    .toolbarCheckButton .checkbuttonMark {
        width: 13px;
        margin-right: 2px;
    }
}

.toggle {
    color: #cbd3dd;
    font-size: 13px;
}
#content {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 42px;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 16px 18px 48px 18px;
}
#summaryBar {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 13px;
}
#summaryTitle {
    font-size: 22px;
    font-weight: 600;
}
#summaryText {
    color: #98a4b4;
    font-size: 13px;
}
#parentGrid {
    display: block;
    margin: 0;
}
#parentGrid.tileView {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    margin: -7px;
}
#parentGrid.sectionView {
    display: block;
    margin: 0;
}
.letterRollout {
    margin: 0 0 10px 0;
    border: 1px solid #303844;
    border-radius: 10px;
    overflow: hidden;
    background: #171b21;
}
.letterRolloutHeader {
    display: flex;
    align-items: center;
    min-height: 42px;
    padding: 0 13px;
    background: #202630;
    border-bottom: 1px solid transparent;
    cursor: pointer;
    user-select: none;
}
.letterRolloutHeader:hover {
    background: #272e39;
}
.letterRollout.open .letterRolloutHeader {
    border-bottom-color: #303844;
}
.letterRolloutArrow {
    width: 18px;
    margin-right: 7px;
    color: #78a9ef;
    font-size: 15px;
    font-weight: 700;
}
.letterRolloutName {
    font-size: 17px;
    font-weight: 700;
}
.letterRolloutCount {
    margin-left: 9px;
    color: #98a4b4;
    font-size: 12px;
}
.letterRolloutHint {
    margin-left: auto;
    color: #697585;
    font-size: 11px;
}
.letterRolloutBody {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    padding: 7px;
}
.parentTile {
    width: 250px;
    margin: 7px;
    border: 1px solid #2e3540;
    border-radius: 11px;
    overflow: hidden;
    background: #1a1e25;
    box-shadow: 0 5px 14px rgba(0,0,0,0.22);
    cursor: pointer;
    position: relative;
}
.parentTile:hover {
    border-color: #5076aa;
    transform: translateY(-1px);
}
.parentTile.selected {
    border-color: #46c879;
    background: #183d2a;
    box-shadow: 0 0 0 2px rgba(70,200,121,0.28), 0 7px 17px rgba(0,0,0,0.28);
}
.parentTile:focus {
    outline: none;
    border-color: #7eb6ff;
    box-shadow:
        0 0 0 3px rgba(83,154,247,0.34),
        0 8px 20px rgba(0,0,0,0.34);
}
.parentTile.selected:focus {
    border-color: #70e39b;
    box-shadow:
        0 0 0 3px rgba(70,200,121,0.38),
        0 8px 20px rgba(0,0,0,0.34);
}
.parentTile.running:after {
    content: "RUNNING";
    position: absolute;
    top: 9px;
    right: 9px;
    background: #277b4c;
    color: white;
    border-radius: 10px;
    padding: 3px 7px;
    font-size: 10px;
    font-weight: 700;
}
.parentCover {
    height: 160px;
    background-color: #252c36;
    background-position: center top;
    background-repeat: no-repeat;
    background-size: cover;
    position: relative;
    overflow: hidden;
}
.parentCover .placeholder {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #243451, #19202a);
    color: #7faaf0;
    font-size: 54px;
    font-weight: 700;
}
.letterBadge {
    position: absolute;
    left: 9px;
    top: 9px;
    padding: 3px 7px;
    border-radius: 10px;
    background: rgba(8,10,13,0.78);
    color: #f1f4f8;
    font-size: 11px;
    font-weight: 700;
}
.parentBody {
    padding: 11px 12px 14px 12px;
}
.parentName {
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.parentHeading {
    display: flex;
    align-items: center;
    margin-top: 5px;
}
.parentHeading .parentName {
    flex: 1 1 auto;
    min-width: 0;
}
.parentHeading .ratingBadge {
    flex: 0 0 auto;
}
.parentStats {
    display: flex;
    margin-top: 8px;
    border: 1px solid #303844;
    border-radius: 7px;
    overflow: hidden;
    background: #15191f;
}
.parentStat {
    flex: 1 1 33.333%;
    min-width: 0;
    padding: 5px 3px 6px 3px;
    border-left: 1px solid #303844;
    text-align: center;
    color: #98a4b4;
    font-size: 10px;
    line-height: 13px;
}
.parentStat:first-child {
    border-left: 0;
}
.parentStatCount {
    display: block;
    color: #e7ebf1;
    font-size: 14px;
    font-weight: 700;
}
.parentStat.pairs .parentStatCount {
    color: #75d18d;
}
.parentStat.galleries .parentStatCount {
    color: #7eb6ff;
}
.parentStat.videos .parentStatCount {
    color: #d49aff;
}
.ratingBadge {
    display: inline-block;
    margin-left: auto;
    padding: 2px 7px;
    border-radius: 10px;
    background: rgba(255, 193, 7, 0.16);
    color: #ffd34d;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
}
.ratingBadge.zero {
    background: rgba(148, 163, 184, 0.10);
    color: #8491a2;
}
.keywordBadges {
    margin-top: 8px;
    min-height: 22px;
    max-height: 48px;
    overflow: hidden;
}
.keywordMatchModeButton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 94px;
    white-space: nowrap;
}
.keywordMatchModeChoice {
    opacity: 0.38;
    transition: opacity 0.12s ease, color 0.12s ease;
}
.keywordMatchModeSeparator {
    margin: 0 6px;
    color: #697586;
}
.keywordMatchModeButton.matchAll .matchAll,
.keywordMatchModeButton.matchAny .matchAny {
    color: #6fe09b;
    opacity: 1;
}
.keywordBadge {
    display: inline-block;
    margin: 0 5px 5px 0;
    padding: 3px 7px;
    border-radius: 10px;
    background: #2a3443;
    color: #c7d6ea;
    font-size: 10px;
    line-height: 12px;
}
#emptyState {
    display: none;
    padding: 60px 20px;
    text-align: center;
    color: #8f9aaa;
}
#statusBar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    min-height: 42px;
    padding: 10px 18px;
    background: #171a20;
    border-top: 1px solid #303742;
    color: #aeb8c6;
    font-size: 12px;
    z-index: 20;
}
#shortcutHelpOverlay {
    display: none;
    position: fixed;
    z-index: 160;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background: rgba(4,6,9,0.82);
}
#shortcutHelpDialog {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 760px;
    max-width: calc(100% - 40px);
    max-height: calc(100% - 40px);
    transform: translate(-50%, -50%);
    border: 1px solid #46505f;
    border-radius: 12px;
    background: #171b21;
    box-shadow: 0 20px 60px rgba(0,0,0,0.62);
    overflow: hidden;
}
#shortcutHelpHeader {
    display: flex;
    align-items: center;
    min-height: 52px;
    padding: 8px 12px 8px 18px;
    border-bottom: 1px solid #303844;
    background: #202630;
}
#shortcutHelpTitle {
    font-size: 18px;
    font-weight: 700;
}
#shortcutHelpClose {
    margin-left: auto;
}
#shortcutHelpText {
    max-height: calc(100vh - 125px);
    margin: 0;
    padding: 18px 22px 22px 22px;
    overflow: auto;
    color: #dce4ee;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    line-height: 1.55;
    white-space: pre-wrap;
}
#galleryOverlay {
    display: none;
    position: fixed;
    z-index: 100;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background: rgba(4,6,9,0.76);
}
#galleryDialog {
    position: absolute;
    box-sizing: border-box;
    width: 560px;
    height: 300px;
    border: 1px solid #3a4452;
    border-radius: 12px;
    background: #161a20;
    box-shadow: 0 18px 50px rgba(0,0,0,0.55);
    overflow: hidden;
}
#galleryHeader {
    min-height: 76px;
    box-sizing: border-box;
    padding: 10px 12px;
    border-bottom: 1px solid #2c333e;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
}
#galleryHeader > * + * {
    margin-left: 16px;
}
#galleryHeader button {
    flex: 0 0 auto;
    padding-left: 10px;
    padding-right: 10px;
}
#galleryHeaderText {
    flex: 1 1 auto;
    min-width: 0;
}
#galleryTitle {
    font-size: 20px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
#galleryKeywords {
    margin-top: 4px;
    color: #9ba7b7;
    font-size: 12px;
}
#galleryGrid {
    position: absolute;
    left: 0;
    right: 0;
    top: 92px;
    bottom: 0;
    overflow-y: auto;
    padding: 12px;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    align-items: flex-start;
}
.galleryCard {
    flex: 0 0 210px;
    width: 210px;
    height: 184px;
    box-sizing: border-box;
    align-self: flex-start;
    margin: 7px;
    background: #1d222a;
    border: 2px solid #4e8dd9;
    border-radius: 9px;
    overflow: hidden;
    cursor: pointer;
}
.galleryCard.video {
    border-color: #62b779;
}
.galleryCard:hover {
    background: #252c36;
}
.galleryCard.selected {
    border-color: #ffd34d;
    background: #2e2a1e;
    box-shadow:
        0 0 0 2px rgba(255,211,77,0.28),
        0 0 18px rgba(255,211,77,0.16);
}
.galleryCard:focus {
    outline: none;
    border-color: #7eb6ff;
    box-shadow:
        0 0 0 3px rgba(83,154,247,0.34),
        0 8px 20px rgba(0,0,0,0.32);
}
.galleryCard.selected.video {
    border-color: #ffd34d;
}
#startSelectedRandomButton[disabled] {
    border-color: #343b45;
    background: #242930;
    color: #6f7986;
    cursor: default;
    opacity: 0.72;
}
.galleryImage {
    flex: 0 0 125px;
    width: 100%;
    height: 125px;
    min-height: 125px;
    max-height: 125px;
    background-color: #252b34;
    background-position: center top;
    background-repeat: no-repeat;
    background-size: cover;
    overflow: hidden;
}
.galleryImage .placeholder {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #7f8a99;
}
.galleryInfo {
    height: 55px;
    box-sizing: border-box;
    overflow: hidden;
    padding: 9px 10px 8px 10px;
}
.galleryName {
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.galleryFlags {
    margin-top: 4px;
    color: #8f9baa;
    font-size: 11px;
}
.keywordMenuSurface {
    display: none;
    position: fixed;
    z-index: 200;
    min-width: 300px;
    max-width: 460px;
    overflow: visible;
    box-sizing: border-box;
    padding: 9px;
    border: 1px solid #46505f;
    border-radius: 9px;
    background: #1c2128;
    box-shadow: 0 12px 28px rgba(0,0,0,0.48);
}
.contextTitle {
    display: flex;
    align-items: center;
    padding: 6px 8px 10px 8px;
    color: #aeb9c8;
    font-size: 12px;
    font-weight: 700;
    border-bottom: 1px solid #313844;
    margin-bottom: 7px;
}
.contextRatingStars {
    margin-left: 8px;
    color: #ffd24a;
    font-size: 23px;
    line-height: 24px;
    letter-spacing: 1px;
    text-shadow: 0 1px 4px rgba(255, 194, 32, 0.28);
}
.contextRatingCount {
    margin-left: 8px;
    color: #f8e7a3;
    font-size: 16px;
    line-height: 20px;
    font-weight: 800;
}
.contextKeywordGroup {
    margin: 0;
}
.contextKeywordGroup + .contextKeywordGroup {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid #303946;
}
.contextKeywordButtons {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}
.contextKeywordButton {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    box-sizing: border-box;
    padding: 6px 11px;
    border: 1px solid #394452;
    border-radius: 7px;
    background: #222830;
    color: #d9e0e8;
    cursor: pointer;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    font-weight: 600;
}
.contextKeywordButton:hover {
    border-color: #66788f;
    background: #2b333e;
}
.contextKeywordButton.active {
    border-color: #4d8fe9;
    background: #255a9f;
    color: #ffffff;
}
.contextKeywordButton.mixed {
    border-color: #c3943e;
    background: #594820;
    color: #fff2cf;
}
.smallMuted {
    color: #7f8998;
    font-size: 11px;
}
</style>
<script type="text/javascript">
var fso = new ActiveXObject("Scripting.FileSystemObject");
var shell = new ActiveXObject("WScript.Shell");
var shellApp = new ActiveXObject("Shell.Application");

var APP_VERSION = "1.02";
var APP_NAME = "Gallery-Slideshow-Manager";
var appDir = getApplicationDirectory();
var tempDir = shell.ExpandEnvironmentStrings("%TEMP%");
var sharedDataDir = tempDir + "\\" + APP_NAME;
var settingsPath = sharedDataDir + "\\" + APP_NAME + ".ini";
var cachePath = sharedDataDir + "\\" + APP_NAME + ".cache";
var CACHE_VERSION = "2";
var thumbnailDir = sharedDataDir + "\\thumbnails";
var thumbnailQueuePath = sharedDataDir + "\\" + APP_NAME + "-thumbnail-queue.txt";
var thumbnailDonePath = sharedDataDir + "\\" + APP_NAME + "-thumbnail-done.ini";
var bridgePath = appDir + "\\Gallery-Slideshow-Manager-Bridge.ahk";
var keywordIniName = "gallery-keywords.ini";
var ratingIniName = "gallery-ratings.ini";
var commandPath = sharedDataDir + "\\" + APP_NAME + "-command.ini";
var sessionPath = sharedDataDir + "\\" + APP_NAME + "-session.ini";
var filteredNavigationPath =
    sharedDataDir + "\\" + APP_NAME + "-filtered-navigation.ini";

var managerInstanceToken = "";

var state = {
    root: "",
    backupDir: "",
    rememberedParentPath: "",
    videoMode: "paired",
    remoteTimeoutMs: 4000,
    optionsExpanded: false,
    keywordsExpanded: false,
    uniqueRandom: false,
    parents: [],
    keywords: [],
    activeFilters: {},
    keywordMatchMode: "any",
    filterPresets: [],
    matchedFilterPresetId: "",
    searchText: "",
    ratingFilterValue: -1,
    ratingFilterMode: "all",
    ratingFilterValues: {},
    ratingFilterClickTimer: 0,
    parentClickTimer: 0,
    displayMode: "section",
    expandedLetter: "",
    selectedParent: null,
    selectedParentPaths: {},
    selectedGallery: null,
    activeSlideshowType: "random",
    filteredQueueSignature: null,
    navigationOrderMode: "random",
    randomMembershipSignature: "",
    randomParentOrder: [],
    randomGalleryOrders: {},
    randomUniqueSessionActive: false,
    randomUniqueParentSeenPaths: {},
    randomUniqueParentSeenSignature: "",
    persistentRandomUniqueParentSeenText: "",
    randomUniqueActiveParentPath: "",
    randomUniquePendingParentPath: "",
    currentParentPath: "",
    currentGalleryPath: "",
    keywordRevision: "",
    ratingRevision: "",
    thumbnailQueue: [],
    thumbnailQueueMap: {},
    thumbnailBuildRunning: false,
    thumbnailBatchSize: 250,
    thumbnailCompletedCount: 0,
    thumbnailFailedCount: 0,
    thumbnailQueueScope: "",
    thumbnailRefreshTimer: 0,
    libraryCacheDirty: false,
    libraryCacheSaveTimer: 0
};

var sharedFileTextCache = {};
var deferredFileWrites = {};
var keywordPopup = null;
var keywordPopupCssText = "";
var keywordGroupCacheSignature = "";
var keywordGroupCache = [];
var keywordMenuMarkupSignature = "";
var keywordMenuMarkupCache = "";
var keywordMenuWordCache = [];
var versionRestartCandidate = "";
var versionRestartStableChecks = 0;
var versionRestartInProgress = false;
var managerExitRequested = false;

function getApplicationDirectory() {
    var path = unescape(window.location.pathname).replace(/\//g, "\\");
    if (/^\\[A-Za-z]:/.test(path)) {
        path = path.substr(1);
    }
    return fso.GetParentFolderName(path);
}

function ensureSharedDataDirectory() {
    if (!fso.FolderExists(sharedDataDir)) {
        fso.CreateFolder(sharedDataDir);
    }

    if (fso.FolderExists(sharedDataDir) && !fso.FolderExists(thumbnailDir)) {
        fso.CreateFolder(thumbnailDir);
    }

    return fso.FolderExists(sharedDataDir)
        && fso.FolderExists(thumbnailDir);
}

function getNewestLegacyDataFile(fileName) {
    var candidates = [];
    var directPath = appDir + "\\" + fileName;

    if (fso.FileExists(directPath)) {
        candidates.push(directPath);
    }

    var parentDir = fso.GetParentFolderName(appDir);

    if (parentDir && fso.FolderExists(parentDir)) {
        var parentFolder = fso.GetFolder(parentDir);
        var folders = new Enumerator(parentFolder.SubFolders);

        for (; !folders.atEnd(); folders.moveNext()) {
            var folder = folders.item();
            var folderName = lower(folder.Name);

            if (folderName.indexOf("gallery-slideshow-manager-html_") !== 0
                && folderName.indexOf("gallery-slideshow-manager-html-") !== 0) {
                continue;
            }

            var candidatePath = folder.Path + "\\" + fileName;

            if (fso.FileExists(candidatePath)) {
                candidates.push(candidatePath);
            }
        }
    }

    var newestPath = "";
    var newestTime = 0;
    var i;

    for (i = 0; i < candidates.length; i++) {
        try {
            var file = fso.GetFile(candidates[i]);
            var modifiedTime = new Date(file.DateLastModified).getTime();

            if (!newestPath || modifiedTime > newestTime) {
                newestPath = candidates[i];
                newestTime = modifiedTime;
            }
        } catch (error) {
        }
    }

    return newestPath;
}

function migrateLegacyDataToSharedTemp() {
    if (!ensureSharedDataDirectory()) {
        alert("Could not create shared data directory:\n\n" + sharedDataDir);
        return false;
    }

    var migrations = [
        { name: APP_NAME + ".ini", destination: settingsPath },
        { name: APP_NAME + ".cache", destination: cachePath }
    ];

    var i;

    for (i = 0; i < migrations.length; i++) {
        if (fso.FileExists(migrations[i].destination)) {
            continue;
        }

        var sourcePath = getNewestLegacyDataFile(migrations[i].name);

        if (!sourcePath) {
            continue;
        }

        try {
            fso.CopyFile(sourcePath, migrations[i].destination, false);
        } catch (error) {
        }
    }

    return true;
}

function normalizePath(path) {
    if (!path) {
        return "";
    }
    path = String(path).replace(/^["\s]+|["\s]+$/g, "");
    if (/^[A-Za-z]:\\$/.test(path)) {
        return path;
    }
    return path.replace(/[\\\/]+$/, "");
}

function lower(text) {
    return String(text || "").toLowerCase();
}

function escapeHtml(text) {
    return String(text || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
}

function fileUrl(path) {
    var url = normalizePath(path).replace(/\\/g, "/");
    var encoded = encodeURI("file:///" + url);

    // In local filenames, # and ? are characters rather than URL syntax.
    encoded = encoded.replace(/#/g, "%23");
    encoded = encoded.replace(/\?/g, "%3F");
    return encoded;
}

function removeCoverPlaceholder(element) {
    var children = element.childNodes;
    var removeList = [];
    var i;

    for (i = 0; i < children.length; i++) {
        var child = children[i];
        var className = child.className || "";

        if ((" " + className + " ").indexOf(" coverPlaceholder ") >= 0) {
            removeList.push(child);
        }
    }

    for (i = 0; i < removeList.length; i++) {
        element.removeChild(removeList[i]);
    }
}

function showCoverPlaceholder(element, fallbackText) {
    removeCoverPlaceholder(element);

    var placeholder = document.createElement("div");
    placeholder.className = "placeholder coverPlaceholder";
    placeholder.innerText = fallbackText || "No preview";
    element.appendChild(placeholder);
}

function applyCoverBackground(element, imagePath, fallbackText, forceRepaint) {
    removeCoverPlaceholder(element);

    if (imagePath && fso.FileExists(imagePath)) {
        var imageUrl =
            'url("'
            + fileUrl(imagePath).replace(/"/g, "%22")
            + '")';

        if (forceRepaint) {
            element.style.backgroundImage = "none";

            // Reading offsetHeight forces the HTA browser to complete the
            // previous style change before the local background is reapplied.
            var repaintHeight = element.offsetHeight;
        }

        element.style.backgroundImage = imageUrl;
        element._appliedCoverPath = lower(imagePath);
        return true;
    }

    element.style.backgroundImage = "none";
    element._appliedCoverPath = "";
    showCoverPlaceholder(element, fallbackText);
    return false;
}

function configureLazyCover(
    element,
    thumbnailPath,
    sourcePath,
    fallbackText
) {
    if ((" " + element.className + " ").indexOf(" lazyCover ") < 0) {
        element.className += " lazyCover";
    }

    element._thumbnailPath = thumbnailPath || "";
    element._sourcePath = sourcePath || "";
    element._coverFallbackText = fallbackText || "No preview";
    element._appliedCoverPath = "";
    element._wasNearViewport = false;
    element.style.backgroundImage = "none";
    showCoverPlaceholder(
        element,
        element._coverFallbackText
    );
}

function isElementNearVisibleArea(element) {
    if (!element || element.offsetWidth < 1 || element.offsetHeight < 1) {
        return false;
    }

    var rectangle = element.getBoundingClientRect();
    var viewportHeight =
        document.documentElement.clientHeight
        || document.body.clientHeight
        || 0;
    var viewportWidth =
        document.documentElement.clientWidth
        || document.body.clientWidth
        || 0;
    var preloadMargin = 360;

    return rectangle.bottom >= -preloadMargin
        && rectangle.top <= viewportHeight + preloadMargin
        && rectangle.right >= -preloadMargin
        && rectangle.left <= viewportWidth + preloadMargin;
}

function refreshVisibleThumbnails() {
    state.thumbnailRefreshTimer = 0;

    var covers = document.getElementsByTagName("div");
    var i;

    for (i = 0; i < covers.length; i++) {
        var element = covers[i];
        var className = element.className || "";

        if ((" " + className + " ").indexOf(" lazyCover ") < 0) {
            continue;
        }

        var isNear = isElementNearVisibleArea(element);

        if (!isNear) {
            element._wasNearViewport = false;
            continue;
        }

        var displayPath = getDisplayThumbnail(
            element._thumbnailPath,
            element._sourcePath
        );
        var normalizedDisplayPath = lower(displayPath);
        var enteredVisibleArea = !element._wasNearViewport;
        var pathChanged =
            normalizedDisplayPath !== (element._appliedCoverPath || "");

        if (enteredVisibleArea || pathChanged) {
            applyCoverBackground(
                element,
                displayPath,
                element._coverFallbackText,
                true
            );
        }

        element._wasNearViewport = true;
    }
}

function updateFixedControlsLayout() {
    var fixedControls = document.getElementById("fixedControls");
    var content = document.getElementById("content");

    if (!fixedControls || !content) {
        return false;
    }

    var controlsHeight = fixedControls.offsetHeight;

    if (controlsHeight < 1) {
        controlsHeight = 1;
    }

    content.style.top = controlsHeight + "px";
    scheduleVisibleThumbnailRefresh();
    return true;
}

function toggleOptionsRollout() {
    var rollout = document.getElementById("optionsRollout");
    var header = document.getElementById("optionsRolloutHeader");
    var arrow = document.getElementById("optionsRolloutArrow");

    state.optionsExpanded = !state.optionsExpanded;
    rollout.className = state.optionsExpanded ? "open" : "";
    header.setAttribute(
        "aria-expanded",
        state.optionsExpanded ? "true" : "false"
    );
    arrow.innerText = state.optionsExpanded ? "\u25BE" : "\u25B8";
    updateFixedControlsLayout();
    return false;
}

function toggleKeywordsRollout() {
    var rollout = document.getElementById("keywordsRollout");
    var header = document.getElementById("keywordsRolloutHeader");
    var arrow = document.getElementById("keywordsRolloutArrow");

    state.keywordsExpanded = !state.keywordsExpanded;
    rollout.className = state.keywordsExpanded ? "open" : "";
    header.setAttribute(
        "aria-expanded",
        state.keywordsExpanded ? "true" : "false"
    );
    arrow.innerText = state.keywordsExpanded ? "\u25BE" : "\u25B8";
    updateFixedControlsLayout();
    return false;
}

function scheduleVisibleThumbnailRefresh() {
    if (state.thumbnailRefreshTimer) {
        window.clearTimeout(state.thumbnailRefreshTimer);
    }

    state.thumbnailRefreshTimer = window.setTimeout(
        refreshVisibleThumbnails,
        45
    );
}

function sharedFileKey(path) {
    return String(path || "")
        .replace(/\//g, "\\")
        .toLowerCase();
}

function waitForSharedFile(milliseconds) {
    var until = new Date().getTime() + milliseconds;

    while (new Date().getTime() < until) {
    }
}

function closeTextFileQuietly(file) {
    if (!file) {
        return;
    }

    try {
        file.Close();
    } catch (error) {
    }
}

function readText(path) {
    var key = sharedFileKey(path);
    var attempt;
    var file = null;

    for (attempt = 0; attempt < 10; attempt++) {
        try {
            if (!fso.FileExists(path)) {
                return "";
            }

            file = fso.OpenTextFile(path, 1, false, -2);
            var text = file.ReadAll();
            file.Close();
            file = null;

            sharedFileTextCache[key] = text;
            return text;
        } catch (error) {
            closeTextFileQuietly(file);
            file = null;

            if (attempt < 9) {
                waitForSharedFile(15 + (attempt * 10));
            }
        }
    }

    if (sharedFileTextCache.hasOwnProperty(key)) {
        return sharedFileTextCache[key];
    }

    return "";
}

function tryWriteTextNow(path, text) {
    var attempt;
    var file = null;

    for (attempt = 0; attempt < 10; attempt++) {
        try {
            file = fso.OpenTextFile(path, 2, true, -2);
            file.Write(text);
            file.Close();
            file = null;
            return true;
        } catch (error) {
            closeTextFileQuietly(file);
            file = null;

            if (attempt < 9) {
                waitForSharedFile(15 + (attempt * 10));
            }
        }
    }

    return false;
}

function scheduleDeferredFileWrite(key, path, text) {
    var entry = deferredFileWrites[key];

    if (!entry) {
        entry = {
            path: path,
            text: text,
            attempts: 0,
            timer: 0
        };
        deferredFileWrites[key] = entry;
    } else {
        entry.path = path;
        entry.text = text;
    }

    if (entry.timer) {
        return;
    }

    entry.timer = window.setTimeout(function() {
        flushDeferredFileWrite(key);
    }, 200);
}

function flushDeferredFileWrite(key) {
    var entry = deferredFileWrites[key];

    if (!entry) {
        return true;
    }

    entry.timer = 0;

    if (tryWriteTextNow(entry.path, entry.text)) {
        delete deferredFileWrites[key];
        return true;
    }

    entry.attempts++;

    if (entry.attempts >= 30) {
        delete deferredFileWrites[key];

        try {
            setStatus(
                "A shared settings file remained locked and could not be updated."
            );
        } catch (error) {
        }

        return false;
    }

    entry.timer = window.setTimeout(function() {
        flushDeferredFileWrite(key);
    }, Math.min(1500, 200 + (entry.attempts * 75)));

    return false;
}

function writeText(path, text, allowDeferredWrite) {
    var key = sharedFileKey(path);
    var output = String(text == null ? "" : text);

    sharedFileTextCache[key] = output;

    if (tryWriteTextNow(path, output)) {
        if (deferredFileWrites[key]) {
            delete deferredFileWrites[key];
        }

        return true;
    }

    if (allowDeferredWrite !== false) {
        scheduleDeferredFileWrite(key, path, output);
    }

    return false;
}

function nonEmptyFileExists(path) {
    try {
        return fso.FileExists(path)
            && Number(fso.GetFile(path).Size) > 0;
    } catch (error) {
        return false;
    }
}

function tryWriteUnicodeTextNow(path, text) {
    var file = null;

    try {
        file = fso.CreateTextFile(path, true, true);
        file.Write(String(text == null ? "" : text));
        file.Close();
        file = null;
        return true;
    } catch (error) {
        closeTextFileQuietly(file);
        return false;
    }
}

function writeTextAtomically(path, text) {
    var output = String(text == null ? "" : text);
    var tempPath =
        path
        + ".write-"
        + String(new Date().getTime())
        + "-"
        + String(Math.floor(Math.random() * 100000))
        + ".tmp";
    var attempt;

    /*
     * Navigation paths can contain characters outside the Windows ANSI code
     * page. An ANSI TextStream creates the file and then fails during Write,
     * leaving a zero-byte queue file and the last valid parent set in use.
     */
    if (!tryWriteUnicodeTextNow(tempPath, output)) {
        try {
            if (fso.FileExists(tempPath)) {
                fso.DeleteFile(tempPath, true);
            }
        } catch (cleanupError) {
        }

        return false;
    }

    for (attempt = 0; attempt < 10; attempt++) {
        try {
            if (fso.FileExists(path)) {
                fso.DeleteFile(path, true);
            }

            fso.MoveFile(tempPath, path);
            sharedFileTextCache[sharedFileKey(path)] =
                output;
            return true;
        } catch (error) {
            if (attempt < 9) {
                waitForSharedFile(15 + (attempt * 10));
            }
        }
    }

    try {
        if (fso.FileExists(tempPath)) {
            fso.DeleteFile(tempPath, true);
        }
    } catch (cleanupError) {
    }

    return false;
}

function parseIni(text) {
    var result = {};
    var section = "";
    var lines = String(text || "").replace(/\r/g, "").split("\n");
    var i;
    for (i = 0; i < lines.length; i++) {
        var line = lines[i];
        var trimmed = line.replace(/^\s+|\s+$/g, "");
        if (!trimmed || trimmed.charAt(0) === ";" || trimmed.charAt(0) === "#") {
            continue;
        }
        if (trimmed.charAt(0) === "[" && trimmed.charAt(trimmed.length - 1) === "]") {
            section = trimmed.substring(1, trimmed.length - 1);
            if (!result[section]) {
                result[section] = {};
            }
            continue;
        }
        var equals = line.indexOf("=");
        if (equals < 0 || !section) {
            continue;
        }
        var key = line.substring(0, equals).replace(/^\s+|\s+$/g, "");
        var value = line.substring(equals + 1);
        result[section][key] = value;
    }
    return result;
}

function serializeIni(data) {
    var sections = [];
    var sectionName;
    for (sectionName in data) {
        if (data.hasOwnProperty(sectionName)) {
            sections.push(sectionName);
        }
    }
    sections.sort(function(a, b) {
        if (a === "Keywords") { return -1; }
        if (b === "Keywords") { return 1; }
        return lower(a) < lower(b) ? -1 : 1;
    });

    var output = [];
    var i;
    for (i = 0; i < sections.length; i++) {
        sectionName = sections[i];
        output.push("[" + sectionName + "]");
        var keys = [];
        var key;
        for (key in data[sectionName]) {
            if (data[sectionName].hasOwnProperty(key)) {
                keys.push(key);
            }
        }
        keys.sort();
        var j;
        for (j = 0; j < keys.length; j++) {
            key = keys[j];
            output.push(key + "=" + data[sectionName][key]);
        }
        output.push("");
    }
    return output.join("\r\n");
}

function readIni(path) {
    return parseIni(readText(path));
}

function writeIni(path, data) {
    return writeText(path, serializeIni(data));
}

function setIniValue(path, section, key, value) {
    var data = readIni(path);
    if (!data[section]) {
        data[section] = {};
    }
    data[section][key] = value;
    return writeIni(path, data);
}

function getIniValue(data, section, key, fallback) {
    if (data[section] && typeof data[section][key] !== "undefined") {
        return data[section][key];
    }
    return fallback;
}

function parseKeywordList(text) {
    var parts = String(text || "").split("|");
    var result = [];
    var seen = {};
    var i;
    for (i = 0; i < parts.length; i++) {
        var word = parts[i].replace(/^\s+|\s+$/g, "");
        var key = lower(word);
        if (word && !seen[key]) {
            seen[key] = true;
            result.push(word);
        }
    }
    return result;
}

function joinKeywords(words) {
    return words.join("|");
}

function normalizeKeywordFilterMode(value) {
    if (value === "exclude") {
        return "exclude";
    }

    return value ? "include" : "";
}

function normalizeKeywordMatchMode(value) {
    return lower(value) === "all" ? "all" : "any";
}

function getActiveFilterWords(mode) {
    var words = [];
    var requestedMode = mode || "include";
    var i;

    for (i = 0; i < state.keywords.length; i++) {
        if (
            normalizeKeywordFilterMode(
                state.activeFilters[lower(state.keywords[i])]
            ) === requestedMode
        ) {
            words.push(state.keywords[i]);
        }
    }

    return words;
}

function normalizedKeywordSignature(words) {
    var normalized = [];
    var seen = {};
    var i;

    for (i = 0; i < words.length; i++) {
        var key = lower(words[i]).replace(/^\s+|\s+$/g, "");

        if (key && !seen[key]) {
            seen[key] = true;
            normalized.push(key);
        }
    }

    normalized.sort();
    return normalized.join("|");
}

function filterSignature(includeWords, excludeWords, matchMode) {
    return "mode:"
        + normalizeKeywordMatchMode(matchMode)
        + "||include:"
        + normalizedKeywordSignature(includeWords || [])
        + "||exclude:"
        + normalizedKeywordSignature(excludeWords || []);
}

function presetIniKey(presetName) {
    return "Preset." + encodeURIComponent(presetName);
}

function presetExcludeIniKey(presetName) {
    return "PresetExclude." + encodeURIComponent(presetName);
}

function presetMatchModeIniKey(presetName) {
    return "PresetMatchMode." + encodeURIComponent(presetName);
}

function presetNameFromIniKey(keyName) {
    if (keyName.indexOf("Preset.") !== 0) {
        return "";
    }

    try {
        return decodeURIComponent(keyName.substr(7));
    } catch (error) {
        return "";
    }
}

function loadFilterPresets() {
    var data = readIni(settingsPath);
    var section = data.KeywordFilterPresets || {};
    var presets = [];
    var key;

    for (key in section) {
        if (!section.hasOwnProperty(key) || key.indexOf("Preset.") !== 0) {
            continue;
        }

        var name = presetNameFromIniKey(key);

        if (!name) {
            continue;
        }

        var includeWords = parseKeywordList(section[key]);
        var excludeWords = parseKeywordList(
            section["PresetExclude." + key.substr(7)] || ""
        );
        var matchMode = normalizeKeywordMatchMode(
            section["PresetMatchMode." + key.substr(7)] || "any"
        );
        presets.push({
            id: key,
            name: name,
            includeKeywords: includeWords,
            excludeKeywords: excludeWords,
            matchMode: matchMode,
            signature: filterSignature(
                includeWords,
                excludeWords,
                matchMode
            )
        });
    }

    presets.sort(function(a, b) {
        return lower(a.name) < lower(b.name) ? -1 :
            (lower(a.name) > lower(b.name) ? 1 : 0);
    });

    state.filterPresets = presets;
    updateFilterPresetControls();
}

function findMatchingFilterPreset() {
    var signature = filterSignature(
        getActiveFilterWords("include"),
        getActiveFilterWords("exclude"),
        state.keywordMatchMode
    );
    var i;

    for (i = 0; i < state.filterPresets.length; i++) {
        if (state.filterPresets[i].signature === signature) {
            return state.filterPresets[i];
        }
    }

    return null;
}

function findFilterPresetById(presetId) {
    var i;

    for (i = 0; i < state.filterPresets.length; i++) {
        if (state.filterPresets[i].id === presetId) {
            return state.filterPresets[i];
        }
    }

    return null;
}

function updateFilterPresetControls() {
    var select = document.getElementById("filterPresetSelect");
    var nameInput = document.getElementById("filterPresetName");
    var saveButton = document.getElementById("saveFilterPresetButton");
    var deleteButton = document.getElementById("deleteFilterPresetButton");
    var hint = document.getElementById("filterPresetHint");

    if (!select || !nameInput || !saveButton || !deleteButton || !hint) {
        return;
    }

    var currentValue = select.value;
    select.innerHTML = "";

    var customOption = document.createElement("option");
    customOption.value = "__custom__";
    customOption.innerText = "Current custom combination";
    select.appendChild(customOption);

    var noneOption = document.createElement("option");
    noneOption.value = "__none__";
    noneOption.innerText = "No keyword filter";
    select.appendChild(noneOption);

    var i;
    for (i = 0; i < state.filterPresets.length; i++) {
        var option = document.createElement("option");
        option.value = state.filterPresets[i].id;
        option.innerText = state.filterPresets[i].name;
        select.appendChild(option);
    }

    var includeWords = getActiveFilterWords("include");
    var excludeWords = getActiveFilterWords("exclude");
    var activeCount = includeWords.length + excludeWords.length;
    var matchedPreset = findMatchingFilterPreset();
    state.matchedFilterPresetId = matchedPreset ? matchedPreset.id : "";

    if (matchedPreset) {
        select.value = matchedPreset.id;
        hint.innerText = "Matches saved preset: " + matchedPreset.name;
    } else if (!activeCount) {
        select.value = "__none__";
        hint.innerText = "Select include or exclude filters to create a named preset.";
    } else {
        select.value = "__custom__";
        hint.innerText = "This ALL/ANY filter combination is not saved.";
    }

    var canSave = activeCount > 0 && !matchedPreset;
    nameInput.disabled = !canSave;
    saveButton.disabled = !canSave;
    deleteButton.disabled = !matchedPreset;

    if (!canSave && matchedPreset) {
        nameInput.value = "";
    }
}

function loadSelectedFilterPreset() {
    var presetId = document.getElementById("filterPresetSelect").value;

    if (presetId === "__custom__") {
        updateFilterPresetControls();
        return;
    }

    state.activeFilters = {};

    if (presetId !== "__none__") {
        var preset = findFilterPresetById(presetId);

        if (preset) {
            state.keywordMatchMode = normalizeKeywordMatchMode(
                preset.matchMode
            );
            var available = {};
            var i;

            for (i = 0; i < state.keywords.length; i++) {
                available[lower(state.keywords[i])] = state.keywords[i];
            }

            for (i = 0; i < preset.includeKeywords.length; i++) {
                var key = lower(preset.includeKeywords[i]);

                if (available[key]) {
                    state.activeFilters[key] = "include";
                }
            }

            for (i = 0; i < preset.excludeKeywords.length; i++) {
                key = lower(preset.excludeKeywords[i]);

                if (available[key]) {
                    state.activeFilters[key] = "exclude";
                }
            }
        }
    }

    updateKeywordMatchModeButton();
    setIniValue(
        settingsPath,
        "Options",
        "KeywordMatchMode",
        state.keywordMatchMode
    );
    renderKeywordFilters();
    renderParents();
    updateFilterPresetControls();
}

function saveCurrentFilterPreset() {
    var includeWords = getActiveFilterWords("include");
    var excludeWords = getActiveFilterWords("exclude");
    var matchedPreset = findMatchingFilterPreset();

    if (!includeWords.length && !excludeWords.length) {
        alert("Select at least one keyword before creating a preset.");
        return false;
    }

    if (matchedPreset) {
        alert("This filter combination already matches preset: " + matchedPreset.name);
        updateFilterPresetControls();
        return false;
    }

    var input = document.getElementById("filterPresetName");
    var presetName = input.value.replace(/^\s+|\s+$/g, "");

    if (!presetName) {
        alert("Enter a preset name.");
        input.focus();
        return false;
    }

    var i;
    for (i = 0; i < state.filterPresets.length; i++) {
        if (lower(state.filterPresets[i].name) === lower(presetName)) {
            alert("A preset with this name already exists.");
            return false;
        }
    }

    var data = readIni(settingsPath);

    if (!data.KeywordFilterPresets) {
        data.KeywordFilterPresets = {};
    }

    var key = presetIniKey(presetName);
    var excludeKey = presetExcludeIniKey(presetName);
    var matchModeKey = presetMatchModeIniKey(presetName);
    data.KeywordFilterPresets[key] = joinKeywords(includeWords);

    if (excludeWords.length) {
        data.KeywordFilterPresets[excludeKey] = joinKeywords(excludeWords);
    } else {
        delete data.KeywordFilterPresets[excludeKey];
    }

    if (state.keywordMatchMode === "all") {
        data.KeywordFilterPresets[matchModeKey] = "all";
    } else {
        delete data.KeywordFilterPresets[matchModeKey];
    }

    writeIni(settingsPath, data);

    input.value = "";
    loadFilterPresets();
    document.getElementById("filterPresetSelect").value = key;
    updateFilterPresetControls();
    setStatus("Keyword filter preset saved: " + presetName);
    return true;
}

function deleteSelectedFilterPreset() {
    var select = document.getElementById("filterPresetSelect");
    var preset = findFilterPresetById(select.value);

    if (!preset) {
        alert("Select a saved filter preset to delete.");
        updateFilterPresetControls();
        return false;
    }

    if (!confirm('Delete filter preset "' + preset.name + '"?')) {
        return false;
    }

    var data = readIni(settingsPath);

    if (!data.KeywordFilterPresets) {
        data.KeywordFilterPresets = {};
    }

    var encodedName = preset.id.substr(7);
    delete data.KeywordFilterPresets[preset.id];
    delete data.KeywordFilterPresets["PresetExclude." + encodedName];
    delete data.KeywordFilterPresets["PresetMatchMode." + encodedName];

    if (!writeIni(settingsPath, data)) {
        alert("The filter preset could not be deleted.");
        return false;
    }

    loadFilterPresets();
    setStatus("Keyword filter preset deleted: " + preset.name);
    return true;
}

function encodeParentSection(parentPath) {
    var root = normalizePath(state.root);
    var parent = normalizePath(parentPath);
    var relative = parent;
    if (lower(parent).indexOf(lower(root + "\\")) === 0) {
        relative = parent.substr(root.length + 1);
    }
    relative = relative.replace(/%/g, "%25");
    relative = relative.replace(/\\/g, "%5C");
    relative = relative.replace(/\//g, "%2F");
    relative = relative.replace(/\[/g, "%5B");
    relative = relative.replace(/\]/g, "%5D");
    return "Parent." + relative;
}

function keywordIniPath() {
    return state.root ? state.root + "\\" + keywordIniName : "";
}

function ratingIniPath() {
    return state.root ? state.root + "\\" + ratingIniName : "";
}

function getParentRating(parentPath) {
    if (!state.root || !parentPath) {
        return 0;
    }

    var data = readIni(ratingIniPath());
    var section = encodeParentSection(parentPath);
    var rating = parseInt(
        getIniValue(data, section, "Rating", "0"),
        10
    );

    if (isNaN(rating) || rating < 0 || rating > 9) {
        return 0;
    }

    return rating;
}

function refreshParentRatings() {
    var i;

    for (i = 0; i < state.parents.length; i++) {
        state.parents[i].rating = getParentRating(state.parents[i].path);
    }

    renderParents();
}

function assignSelectedParentRating(rating) {
    var value = parseInt(rating, 10);
    var selectedParents = getSelectedParents();
    var path = ratingIniPath();
    var data;
    var i;

    if (isNaN(value) || value < 0 || value > 9) {
        return false;
    }

    if (!path || !selectedParents.length) {
        setStatus("Select a parent thumbnail before assigning a rating.");
        return false;
    }

    data = readIni(path);

    for (i = 0; i < selectedParents.length; i++) {
        var section = encodeParentSection(selectedParents[i].path);

        if (value === 0) {
            if (data[section]) {
                delete data[section].Rating;

                var hasSectionValues = false;
                var sectionKey;
                for (sectionKey in data[section]) {
                    if (data[section].hasOwnProperty(sectionKey)) {
                        hasSectionValues = true;
                        break;
                    }
                }

                if (!hasSectionValues) {
                    delete data[section];
                }
            }
        } else {
            if (!data[section]) {
                data[section] = {};
            }
            data[section].Rating = String(value);
        }
    }

    if (!writeIni(path, data)) {
        setStatus("The selected parent rating could not be saved.");
        return false;
    }

    for (i = 0; i < selectedParents.length; i++) {
        selectedParents[i].rating = value;
    }

    var revision = String(new Date().getTime());
    var sessionData = readIni(sessionPath);
    if (!sessionData.Session) {
        sessionData.Session = {};
    }
    sessionData.Session.RatingRevision = revision;

    for (i = 0; i < selectedParents.length; i++) {
        if (
            lower(normalizePath(selectedParents[i].path))
            === lower(normalizePath(state.currentParentPath))
        ) {
            sessionData.Session.CurrentParentRating = String(value);
            break;
        }
    }

    writeIni(sessionPath, sessionData);
    state.ratingRevision = revision;
    renderParents();

    setStatus(
        (value === 0 ? "Rating cleared for " : value + "★ assigned to ")
        + selectedParents.length
        + (selectedParents.length === 1 ? " selected parent." : " selected parents.")
    );
    return true;
}

function ratingStarsText(rating) {
    var value = parseInt(rating, 10) || 0;
    var result = "";
    var i;

    if (value < 1) {
        return "0★";
    }

    if (value > 9) {
        value = 9;
    }

    for (i = 0; i < value; i++) {
        result += "★";
    }

    return result;
}

function ratingText(rating) {
    var value = parseInt(rating, 10) || 0;

    if (value === 1) {
        return "1 star";
    }

    return value + " stars";
}

function loadSettings() {
    var data = readIni(settingsPath);
    state.root = normalizePath(getIniValue(data, "Galleries", "RootPath", ""));
    state.backupDir = normalizePath(
        getIniValue(
            data,
            "Backup",
            "Directory",
            getIniValue(
                data,
                "Backup",
                "DatabaseDirectory",
                getIniValue(
                    data,
                    "Backup",
                    "ConfigurationDirectory",
                    ""
                )
            )
        )
    );
    state.rememberedParentPath = normalizePath(
        getIniValue(data, "Selection", "ParentPath", "")
    );
    state.videoMode = lower(
        getIniValue(data, "Options", "VideoMode", "")
    );

    if (
        state.videoMode !== "none"
        && state.videoMode !== "paired"
        && state.videoMode !== "all"
        && state.videoMode !== "auto"
    ) {
        // Preserve the former AutoVlc checkbox setting during migration.
        state.videoMode = String(
            getIniValue(data, "Options", "AutoVlc", "1")
        ) !== "0" ? "paired" : "none";
    }
    state.remoteTimeoutMs = parseInt(
        getIniValue(data, "Options", "RemoteTimeoutMs", "4000"),
        10
    );
    state.uniqueRandom = String(getIniValue(data, "Options", "UniqueRandom", "0")) !== "0";
    state.persistentRandomUniqueParentSeenText = String(
        getIniValue(
            data,
            "Options",
            "UniqueRandomParentSeen",
            ""
        )
    );

    if (
        lower(state.persistentRandomUniqueParentSeenText) === "error"
        || state.persistentRandomUniqueParentSeenText === "__EMPTY__"
    ) {
        state.persistentRandomUniqueParentSeenText = "";
    }
    state.keywordMatchMode = normalizeKeywordMatchMode(
        getIniValue(data, "Options", "KeywordMatchMode", "any")
    );
    state.displayMode = lower(
        getIniValue(data, "Options", "DisplayMode", "section")
    );
    state.ratingFilterValue = parseInt(
        getIniValue(data, "Options", "RatingFilter", "-1"),
        10
    );
    state.ratingFilterMode = lower(
        getIniValue(
            data,
            "Options",
            "RatingFilterMode",
            state.ratingFilterValue >= 0 ? "upto" : "all"
        )
    );
    state.ratingFilterValues = {};

    var savedRatingFilterValues = String(
        getIniValue(
            data,
            "Options",
            "RatingFilterValues",
            ""
        )
    ).split("|");
    var savedRatingIndex;

    for (
        savedRatingIndex = 0;
        savedRatingIndex < savedRatingFilterValues.length;
        savedRatingIndex++
    ) {
        var savedRating = parseInt(
            savedRatingFilterValues[savedRatingIndex],
            10
        );

        if (savedRating >= 1 && savedRating <= 9) {
            state.ratingFilterValues[savedRating] = true;
        }
    }

    if (isNaN(state.ratingFilterValue)
        || state.ratingFilterValue < -1
        || state.ratingFilterValue > 9) {
        state.ratingFilterValue = -1;
    }

    if (
        state.ratingFilterMode === "multiple"
        && getSelectedRatingValues().length
    ) {
        if (state.ratingFilterValue < 1) {
            state.ratingFilterValue =
                getSelectedRatingValues()[0];
        }
    } else if (state.ratingFilterValue < 0) {
        state.ratingFilterMode = "all";
    } else if (
        state.ratingFilterMode !== "upto"
        && state.ratingFilterMode !== "exact"
    ) {
        state.ratingFilterMode = "upto";
    }

    if (state.ratingFilterMode !== "multiple") {
        state.ratingFilterValues = {};
    }

    if (state.displayMode !== "tile" && state.displayMode !== "section") {
        state.displayMode = "section";
    }

    if (isNaN(state.remoteTimeoutMs)
        || state.remoteTimeoutMs < 1000
        || state.remoteTimeoutMs > 60000) {
        state.remoteTimeoutMs = 4000;
    }

    document.getElementById("rootPath").value = state.root;
    document.getElementById("backupPath").value = state.backupDir;
    updateRemoteTimeoutOption();
    updateVideoModeButton();
    updateUniqueRandomButton();
    updateKeywordMatchModeButton();
    updateDisplayModeButton();
    updateSlideshowModeButtons();
    loadFilterPresets();
}

function formatRemoteTimeoutSeconds(timeoutMs) {
    var seconds = timeoutMs / 1000;

    if (seconds === Math.floor(seconds)) {
        return String(seconds);
    }

    return String(Math.round(seconds * 10) / 10);
}

function formatRemoteTimeoutLabel(timeoutMs) {
    return formatRemoteTimeoutSeconds(timeoutMs)
        + (timeoutMs === 1000 ? " second" : " seconds");
}

function updateRemoteTimeoutOption() {
    var input = document.getElementById("remoteTimeoutSeconds");
    var hint = document.getElementById("remoteTimeoutHint");

    if (input) {
        input.value = formatRemoteTimeoutSeconds(state.remoteTimeoutMs);
    }

    if (hint) {
        hint.innerText = "1–60 seconds; default 4.";
    }

    return true;
}

function saveRemoteTimeout() {
    var input = document.getElementById("remoteTimeoutSeconds");
    var hint = document.getElementById("remoteTimeoutHint");
    var rawValue = String(input.value || "")
        .replace(/^\s+|\s+$/g, "")
        .replace(",", ".");
    var seconds = parseFloat(
        rawValue
    );

    if (!/^\d+(?:\.\d)?$/.test(rawValue)
        || isNaN(seconds)
        || seconds < 1
        || seconds > 60) {
        hint.innerText = "Enter 1–60 seconds; value not saved.";
        return false;
    }

    seconds = Math.round(seconds * 10) / 10;
    state.remoteTimeoutMs = Math.round(seconds * 1000);
    var saved = setIniValue(
        settingsPath,
        "Options",
        "RemoteTimeoutMs",
        String(state.remoteTimeoutMs)
    );

    hint.innerText = saved
        ? "Saved live · 1–60 seconds."
        : "Could not save; retrying.";
    return saved;
}

function saveRoot() {
    var value = normalizePath(document.getElementById("rootPath").value);
    if (!value || !fso.FolderExists(value)) {
        alert("Select an existing galleries root folder.");
        return false;
    }
    var rootChanged = lower(value) !== lower(state.root);
    state.root = value;
    setIniValue(settingsPath, "Galleries", "RootPath", state.root);

    if (rootChanged) {
        state.rememberedParentPath = "";
        setIniValue(settingsPath, "Selection", "ParentPath", "");
    }

    scanLibrary();
    return true;
}

function browseRoot() {
    var startFolder = state.root || 0;
    var folder = shellApp.BrowseForFolder(0, "Select galleries root folder", 0x11, startFolder);
    if (!folder) {
        return;
    }
    var path = normalizePath(folder.Self.Path);
    document.getElementById("rootPath").value = path;
    saveRoot();
}

function browseBackupDirectory() {
    var input = document.getElementById("backupPath");
    var startFolder = normalizePath(input.value) || state.root || 0;
    var folder = shellApp.BrowseForFolder(
        0,
        "Select backup directory",
        0x11,
        startFolder
    );

    if (!folder) {
        return false;
    }

    input.value = normalizePath(folder.Self.Path);
    return true;
}

function saveBackupSettings() {
    var backupDirectory = normalizePath(
        document.getElementById("backupPath").value
    );

    if (backupDirectory && !fso.FolderExists(backupDirectory)) {
        alert("Select an existing backup directory.");
        return false;
    }

    state.backupDir = backupDirectory;

    var data = readIni(settingsPath);

    if (!data.Backup) {
        data.Backup = {};
    }

    data.Backup.Directory = state.backupDir;
    delete data.Backup.DatabaseDirectory;
    delete data.Backup.ConfigurationDirectory;

    if (!writeIni(settingsPath, data)) {
        alert("The backup directory settings could not be saved.");
        return false;
    }

    setStatus("Backup directory saved.");
    return true;
}

function backupDatabaseManifestPath() {
    return state.backupDir
        + "\\"
        + APP_NAME
        + "-database-backup.ini";
}

function backupConfigurationFilePath() {
    return state.backupDir
        + "\\"
        + APP_NAME
        + ".ini";
}

function sameFilePath(firstPath, secondPath) {
    return lower(normalizePath(firstPath))
        === lower(normalizePath(secondPath));
}

function copyFileForBackup(sourcePath, destinationPath) {
    if (!sourcePath
        || !destinationPath
        || !fso.FileExists(sourcePath)
        || sameFilePath(sourcePath, destinationPath)) {
        return false;
    }

    try {
        fso.CopyFile(sourcePath, destinationPath, true);
        return fso.FileExists(destinationPath);
    } catch (error) {
        return false;
    }
}

function flushAllDeferredFileWrites() {
    var keys = [];
    var key;
    var i;
    var success = true;

    for (key in deferredFileWrites) {
        if (deferredFileWrites.hasOwnProperty(key)) {
            keys.push(key);
        }
    }

    for (i = 0; i < keys.length; i++) {
        var entry = deferredFileWrites[keys[i]];

        if (!entry) {
            continue;
        }

        if (entry.timer) {
            window.clearTimeout(entry.timer);
            entry.timer = 0;
        }

        if (tryWriteTextNow(entry.path, entry.text)) {
            delete deferredFileWrites[keys[i]];
        } else {
            success = false;
        }
    }

    return success;
}

function cancelDeferredFileWrite(path) {
    var key = sharedFileKey(path);
    var entry = deferredFileWrites[key];

    if (entry && entry.timer) {
        window.clearTimeout(entry.timer);
    }

    if (entry) {
        delete deferredFileWrites[key];
    }

    if (sharedFileTextCache.hasOwnProperty(key)) {
        delete sharedFileTextCache[key];
    }
}

function createBackups() {
    if (!saveBackupSettings()) {
        return false;
    }

    if (!state.backupDir) {
        alert("Select the backup directory first.");
        return false;
    }

    if (!state.root || !fso.FolderExists(state.root)) {
        alert("Select an existing galleries root before creating a backup.");
        return false;
    }

    flushLibraryCacheIfDirty();
    saveWindowPlacement();

    if (!flushAllDeferredFileWrites()) {
        alert("A data file is busy. Close its other user and try the backup again.");
        return false;
    }

    var databaseFiles = [
        {
            key: "Cache",
            source: cachePath,
            destination:
                state.backupDir
                + "\\"
                + APP_NAME
                + ".cache"
        },
        {
            key: "Keywords",
            source: keywordIniPath(),
            destination:
                state.backupDir
                + "\\"
                + keywordIniName
        },
        {
            key: "Ratings",
            source: ratingIniPath(),
            destination:
                state.backupDir
                + "\\"
                + ratingIniName
        }
    ];
    var manifest = {
        Backup: {
            RootPath: state.root,
            Created: String(new Date())
        }
    };
    var copiedDatabaseFiles = 0;
    var i;

    for (i = 0; i < databaseFiles.length; i++) {
        var databaseFile = databaseFiles[i];
        var sourceExists = fso.FileExists(databaseFile.source);

        manifest.Backup["Has" + databaseFile.key] =
            sourceExists ? "1" : "0";

        if (sourceExists) {
            if (!copyFileForBackup(
                databaseFile.source,
                databaseFile.destination
            )) {
                alert(
                    "Could not back up:\n\n"
                    + databaseFile.source
                    + "\n\nto:\n\n"
                    + databaseFile.destination
                );
                return false;
            }

            copiedDatabaseFiles++;
        }
    }

    if (!copiedDatabaseFiles) {
        alert("No database files are available to back up.");
        return false;
    }

    if (!tryWriteTextNow(
        backupDatabaseManifestPath(),
        serializeIni(manifest)
    )) {
        alert("The database backup manifest could not be written.");
        return false;
    }

    if (!copyFileForBackup(
        settingsPath,
        backupConfigurationFilePath()
    )) {
        alert("The configuration file could not be backed up.");
        return false;
    }

    setStatus(
        "Backup complete: "
        + copiedDatabaseFiles
        + " database file(s) and configuration saved."
    );
    return true;
}

function restoreBackupFile(sourcePath, destinationPath) {
    cancelDeferredFileWrite(destinationPath);

    if (!copyFileForBackup(sourcePath, destinationPath)) {
        return false;
    }

    cancelDeferredFileWrite(destinationPath);
    return true;
}

function revertFromBackups() {
    if (!saveBackupSettings()) {
        return false;
    }

    if (!state.backupDir) {
        alert("Select the backup directory before reverting.");
        return false;
    }

    var databaseManifestPath = backupDatabaseManifestPath();
    var configurationBackupPath = backupConfigurationFilePath();

    if (!fso.FileExists(databaseManifestPath)
        || !fso.FileExists(configurationBackupPath)) {
        alert(
            "A complete backup was not found in the selected directory. "
            + "Use Back up now first or select a directory containing "
            + "an existing backup."
        );
        return false;
    }

    var manifest = readIni(databaseManifestPath);
    var backedUpRoot = normalizePath(
        getIniValue(manifest, "Backup", "RootPath", "")
    );
    var configurationData = readIni(configurationBackupPath);
    var configuredRoot = normalizePath(
        getIniValue(configurationData, "Galleries", "RootPath", "")
    );

    if (!backedUpRoot || !fso.FolderExists(backedUpRoot)) {
        alert("The galleries root recorded by the backup is unavailable.");
        return false;
    }

    if (lower(backedUpRoot) !== lower(configuredRoot)) {
        alert(
            "The database and configuration backups belong to different "
            + "gallery roots and cannot be safely restored together."
        );
        return false;
    }

    var databaseFiles = [
        {
            key: "Cache",
            source:
                state.backupDir
                + "\\"
                + APP_NAME
                + ".cache",
            destination: cachePath
        },
        {
            key: "Keywords",
            source:
                state.backupDir
                + "\\"
                + keywordIniName,
            destination:
                backedUpRoot
                + "\\"
                + keywordIniName
        },
        {
            key: "Ratings",
            source:
                state.backupDir
                + "\\"
                + ratingIniName,
            destination:
                backedUpRoot
                + "\\"
                + ratingIniName
        }
    ];
    var restorableFiles = [];
    var filesToRemove = [];
    var i;

    for (i = 0; i < databaseFiles.length; i++) {
        if (
            getIniValue(
                manifest,
                "Backup",
                "Has" + databaseFiles[i].key,
                "0"
            ) === "1"
        ) {
            if (!fso.FileExists(databaseFiles[i].source)) {
                alert(
                    "The backup is incomplete. Missing:\n\n"
                    + databaseFiles[i].source
                );
                return false;
            }

            restorableFiles.push(databaseFiles[i]);
        } else {
            filesToRemove.push(databaseFiles[i].destination);
        }
    }

    if (!restorableFiles.length) {
        alert("The selected database backup contains no restorable files.");
        return false;
    }

    if (!confirm(
        "Restore the database and configuration from the selected backups?"
        + "\n\nGallery root:\n"
        + backedUpRoot
        + "\n\nCurrent values will be replaced."
    )) {
        return false;
    }

    if (state.libraryCacheSaveTimer) {
        window.clearTimeout(state.libraryCacheSaveTimer);
        state.libraryCacheSaveTimer = 0;
    }

    state.libraryCacheDirty = false;

    for (i = 0; i < restorableFiles.length; i++) {
        if (!restoreBackupFile(
            restorableFiles[i].source,
            restorableFiles[i].destination
        )) {
            alert(
                "Restore stopped because this file could not be replaced:\n\n"
                + restorableFiles[i].destination
            );
            return false;
        }
    }

    for (i = 0; i < filesToRemove.length; i++) {
        cancelDeferredFileWrite(filesToRemove[i]);

        try {
            if (fso.FileExists(filesToRemove[i])) {
                fso.DeleteFile(filesToRemove[i], true);
            }
        } catch (removeError) {
            alert(
                "Restore stopped because this newer database file "
                + "could not be removed:\n\n"
                + filesToRemove[i]
            );
            return false;
        }
    }

    if (!restoreBackupFile(configurationBackupPath, settingsPath)) {
        alert("The configuration file could not be restored.");
        return false;
    }

    closeGalleryDialog();
    state.parents = [];
    state.selectedParent = null;
    state.selectedParentPaths = {};
    state.activeFilters = {};
    loadSettings();
    loadKeywords();
    renderKeywordFilters();
    renderRatingFilters();

    if (!loadLibraryCache()) {
        scanLibrary();
    }

    primeKeywordMenu();
    setStatus(
        "Database and configuration restored from backup."
    );
    return true;
}

function updateSlideshowModeButtons() {
    var normalButton = document.getElementById(
        "mainSlideshowButton"
    );
    var randomButton = document.getElementById(
        "mainRandomSlideshowButton"
    );

    if (normalButton) {
        normalButton.className =
            "toolbarControl toolbarCheckButton slideshowActionButton"
            + (
                state.activeSlideshowType === "normal"
                ? " active"
                : ""
            );
        normalButton.setAttribute(
            "aria-pressed",
            state.activeSlideshowType === "normal"
                ? "true"
                : "false"
        );
    }

    if (randomButton) {
        randomButton.className =
            "toolbarControl toolbarCheckButton slideshowActionButton"
            + (
                state.activeSlideshowType === "random"
                ? " active"
                : ""
            );
        randomButton.setAttribute(
            "aria-pressed",
            state.activeSlideshowType === "random"
                ? "true"
                : "false"
        );
    }

    return true;
}

function setActiveSlideshowType(slideshowType) {
    state.activeSlideshowType =
        slideshowType === "random"
        ? "random"
        : (
            slideshowType === "normal"
            ? "normal"
            : ""
        );
    updateSlideshowModeButtons();
    return true;
}

function restoreActiveSlideshowType() {
    var sessionData = readIni(sessionPath);
    var currentGallery = normalizePath(
        getIniValue(
            sessionData,
            "Session",
            "CurrentGallery",
            ""
        )
    );

    if (!currentGallery) {
        setActiveSlideshowType("random");
        return false;
    }

    var navigationData = readIni(
        filteredNavigationPath
    );
    var runningMode = lower(
        getIniValue(
            navigationData,
            "Queue",
            "Mode",
            "random"
        )
    );

    setActiveSlideshowType(
        runningMode === "random"
            ? "random"
            : "normal"
    );
    return true;
}

function videoModeLabel(mode) {
    if (mode === "all") {
        return "ALL VIDEOS";
    }

    if (mode === "auto") {
        return "AUTO VIDEOS";
    }

    return "VIDEOS";
}

function videoModeDescription(mode) {
    if (mode === "none") {
        return "No videos";
    }

    if (mode === "all") {
        return "All videos when the parent gallery changes";
    }

    if (mode === "auto") {
        return "Use pairs, or all parent videos when pairs are missing";
    }

    return "Paired video for each gallery";
}

function updateVideoModeButton() {
    var button = document.getElementById(
        "videoModeButton"
    );

    if (!button) {
        return false;
    }

    button.className =
        "toolbarControl toolbarCheckButton"
        + (state.videoMode !== "none" ? " active" : "");
    button.setAttribute(
        "aria-pressed",
        state.videoMode !== "none" ? "true" : "false"
    );
    button.setAttribute("data-video-mode", state.videoMode);
    button.getElementsByTagName("span")[1].innerText =
        videoModeLabel(state.videoMode);
    button.title =
        "Video mode (click to change)\n\n"
        + "No videos - do not use VLC\n"
        + "Videos - use gallery/video pairs\n"
        + "All videos - load the parent's videos when its gallery changes\n"
        + "Auto videos - use pairs; if that parent has no pairs, load all its videos\n\n"
        + "Current: " + videoModeDescription(state.videoMode);
    button.setAttribute(
        "aria-label",
        "Video mode: " + videoModeDescription(state.videoMode)
    );
    return true;
}

function updateUniqueRandomButton() {
    var button = document.getElementById(
        "uniqueRandomButton"
    );

    if (!button) {
        return false;
    }

    button.className =
        "toolbarControl toolbarCheckButton"
        + (state.uniqueRandom ? " active" : "");
    button.setAttribute(
        "aria-pressed",
        state.uniqueRandom ? "true" : "false"
    );
    button.title = state.uniqueRandom
        ? "Only parent galleries not yet used in this random round are displayed."
        : "Random parent galleries may repeat before every parent has been used.";
    return true;
}

function toggleUniqueRandom() {
    state.uniqueRandom = !state.uniqueRandom;
    updateUniqueRandomButton();
    setIniValue(
        settingsPath,
        "Options",
        "UniqueRandom",
        state.uniqueRandom ? "1" : "0"
    );

    // UNIQUE is a pause/resume filter. Its completed-parent round remains
    // intact while the button is off and returns when it is enabled again.
    if (state.uniqueRandom) {
        state.randomUniqueParentSeenPaths =
            randomUniqueParentSeenMap(
                getPersistentRandomUniqueParentSeenText()
            );
        state.randomUniqueParentSeenSignature =
            randomUniqueParentSeenSignature(
                state.randomUniqueParentSeenPaths
            );
    } else {
        pauseRandomUniqueAvailability();
    }

    if (state.activeSlideshowType === "random") {
        state.randomUniqueSessionActive =
            state.uniqueRandom;

        if (state.uniqueRandom) {
            var currentParentKey =
                uniqueParentPathKey(
                    state.currentParentPath
                );
            state.randomUniqueActiveParentPath =
                currentParentKey;
            state.randomUniquePendingParentPath =
                currentParentKey;
        }

        ensureBridge();
        sendCommand(
            state.uniqueRandom
            ? "uniqueon"
            : "uniqueoff",
            ""
        );
    }

    refreshUniqueAvailabilityPresentation();

    setStatus(
        "Unique random "
        + (state.uniqueRandom ? "enabled." : "disabled.")
    );
    return true;
}

function toggleVideoMode() {
    var modeOrder = ["none", "paired", "all", "auto"];
    var currentIndex = 0;
    var i;

    for (i = 0; i < modeOrder.length; i++) {
        if (modeOrder[i] === state.videoMode) {
            currentIndex = i;
            break;
        }
    }

    state.videoMode = modeOrder[(currentIndex + 1) % modeOrder.length];
    updateVideoModeButton();
    setIniValue(
        settingsPath,
        "Options",
        "VideoMode",
        state.videoMode
    );
    // Keep the legacy flag meaningful for older builds using this INI.
    setIniValue(
        settingsPath,
        "Options",
        "AutoVlc",
        state.videoMode === "none" ? "0" : "1"
    );
    ensureBridge();
    sendCommand("videomodechanged", "");
    setStatus(
        "Video mode: "
        + videoModeDescription(state.videoMode)
        + "."
    );
    return true;
}

function updateDisplayModeButton() {
    var button = document.getElementById(
        "displayModeButton"
    );

    if (!button) {
        return false;
    }

    button.className =
        "toolbarControl toolbarCheckButton"
        + (
            state.displayMode === "tile"
            ? " active"
            : ""
        );
    button.setAttribute(
        "aria-pressed",
        state.displayMode === "tile"
            ? "true"
            : "false"
    );
    button.title =
        state.displayMode === "tile"
        ? "Tile view is active. Click for section view."
        : "Section view is active. Click for tile view.";
    return true;
}

function displayModeChanged() {
    state.displayMode =
        state.displayMode === "tile"
        ? "section"
        : "tile";

    updateDisplayModeButton();

    setIniValue(
        settingsPath,
        "Options",
        "DisplayMode",
        state.displayMode
    );

    renderParents();
    setStatus(
        state.displayMode === "tile"
        ? "Main list changed to Tile view."
        : "Main list changed to By section view."
    );
}

function saveRatingFilter() {
    setIniValue(
        settingsPath,
        "Options",
        "RatingFilter",
        String(state.ratingFilterValue)
    );
    setIniValue(
        settingsPath,
        "Options",
        "RatingFilterMode",
        state.ratingFilterMode
    );
    setIniValue(
        settingsPath,
        "Options",
        "RatingFilterValues",
        getSelectedRatingValues().join("|")
    );
}

function getSelectedRatingValues() {
    var values = [];
    var rating;

    for (rating = 1; rating <= 9; rating++) {
        if (state.ratingFilterValues[rating]) {
            values.push(rating);
        }
    }

    return values;
}

function applyRatingFilter(mode, value) {
    state.ratingFilterValue = value;
    state.ratingFilterMode = mode;

    if (mode !== "multiple") {
        state.ratingFilterValues = {};
    }

    saveRatingFilter();
    renderRatingFilters();
    renderParents();
    updateFixedControlsLayout();

    if (mode === "all") {
        setStatus(
            "Showing parent galleries of every rating."
        );
    } else if (mode === "multiple") {
        setStatus(
            "Showing selected parent-gallery ratings: "
            + getSelectedRatingValues().join("★, ")
            + "★."
        );
    } else if (mode === "exact" && value === 0) {
        setStatus(
            "Showing only non-starred parent galleries."
        );
    } else if (mode === "exact") {
        setStatus(
            "Showing only parent galleries rated "
            + value
            + (value === 1 ? " star." : " stars.")
        );
    } else {
        setStatus(
            value >= 9
            ? "Showing parent galleries of every rating."
            : "Showing non-starred through "
                + value
                + "-star parent galleries."
        );
    }
}

function scheduleRatingFilterToggle(value) {
    if (state.ratingFilterClickTimer) {
        window.clearTimeout(state.ratingFilterClickTimer);
    }

    state.ratingFilterClickTimer = window.setTimeout(function() {
        state.ratingFilterClickTimer = 0;

        if (state.ratingFilterMode !== "multiple") {
            state.ratingFilterValues = {};
        }

        if (state.ratingFilterValues[value]) {
            delete state.ratingFilterValues[value];
        } else {
            state.ratingFilterValues[value] = true;
        }

        if (!getSelectedRatingValues().length) {
            applyRatingFilter("all", -1);
        } else {
            applyRatingFilter("multiple", value);
        }
    }, 260);
}

function toggleRatingFilterMode(value) {
    if (state.ratingFilterClickTimer) {
        window.clearTimeout(state.ratingFilterClickTimer);
        state.ratingFilterClickTimer = 0;
    }

    applyRatingFilter(
        state.ratingFilterMode === "upto"
        ? "exact"
        : "upto",
        value
    );
}

function renderRatingFilters() {
    var container = document.getElementById("ratingFilters");
    var hint = document.getElementById("ratingFilterHint");

    if (!container) {
        return;
    }

    container.innerHTML = "";

    var unratedOnly =
        state.ratingFilterMode === "exact"
        && state.ratingFilterValue === 0;

    container.className =
        unratedOnly
        ? "unratedOnly"
        : "";

    var rating;

    for (rating = 1; rating <= 9; rating++) {
        (function(value) {
            var star = document.createElement("button");
            var isExact =
                state.ratingFilterMode === "exact"
                && value === state.ratingFilterValue;
            var isMultiple =
                state.ratingFilterMode === "multiple"
                && !!state.ratingFilterValues[value];
            var isActive =
                state.ratingFilterMode === "upto"
                ? (
                    state.ratingFilterValue >= 1
                    && value <= state.ratingFilterValue
                )
                : (isExact || isMultiple);
            var isSelected =
                !unratedOnly
                && (
                    isMultiple
                    || value === state.ratingFilterValue
                );

            star.type = "button";
            star.className =
                "ratingFilterStar"
                + (isActive ? " active" : "")
                + (isSelected ? " selected" : "")
                + (isExact ? " exact" : "");
            star.title =
                "Single click: add or remove "
                + value
                + "★ from the selected ratings. Double click: switch between "
                + "ratings up to "
                + value
                + "★ and only "
                + value
                + "★.";
            star.innerHTML =
                '<span class="ratingFilterGlyph">★</span>'
                + '<span class="ratingFilterNumber">'
                + value
                + '</span>';

            star.onclick = function() {
                scheduleRatingFilterToggle(value);

                window.event.cancelBubble = true;
                window.event.returnValue = false;
                return false;
            };

            star.ondblclick = function() {
                toggleRatingFilterMode(value);

                window.event.cancelBubble = true;
                window.event.returnValue = false;
                return false;
            };

            container.appendChild(star);
        })(rating);
    }

    if (hint) {
        if (unratedOnly) {
            hint.innerText = "Non-starred only";
        } else if (state.ratingFilterMode === "exact") {
            hint.innerText =
                "Only rating: "
                + state.ratingFilterValue
                + "★";
        } else if (state.ratingFilterMode === "multiple") {
            hint.innerText =
                "Selected ratings: "
                + getSelectedRatingValues().join("★, ")
                + "★";
        } else if (state.ratingFilterMode === "upto") {
            hint.innerText =
                state.ratingFilterValue >= 9
                ? "All ratings"
                : "Non-starred through "
                    + state.ratingFilterValue
                    + "★";
        } else {
            hint.innerText = "All ratings";
        }
    }

    updateFixedControlsLayout();
}

function loadKeywords() {
    state.keywords = [];
    if (!state.root) {
        renderKeywordFilters();
        return;
    }
    var path = keywordIniPath();
    var data = readIni(path);
    if (!data.Keywords) {
        data.Keywords = { List: "" };
        writeIni(path, data);
    }
    state.keywords = parseKeywordList(getIniValue(data, "Keywords", "List", ""));
    data.Keywords.List = joinKeywords(state.keywords);
    writeIni(path, data);
    pruneActiveFilters();
    renderKeywordFilters();
}

function getParentKeywords(parentPath) {
    var data = readIni(keywordIniPath());
    var section = encodeParentSection(parentPath);
    return parseKeywordList(getIniValue(data, section, "Keywords", ""));
}

function saveParentKeywords(parentPath, words) {
    var path = keywordIniPath();
    var data = readIni(path);
    var section = encodeParentSection(parentPath);
    if (!words.length) {
        delete data[section];
    } else {
        if (!data[section]) {
            data[section] = {};
        }
        data[section].Keywords = joinKeywords(words);
    }
    writeIni(path, data);
}

function addKeyword() {
    var input = document.getElementById("keywordName");
    var word = keywordFromEditText(input.value);
    if (!state.root) {
        alert("Select a galleries root first.");
        return;
    }
    if (!word) {
        alert("Enter a keyword.");
        return;
    }
    if (word.indexOf("|") >= 0) {
        alert("A keyword cannot contain |.");
        return;
    }
    var i;
    for (i = 0; i < state.keywords.length; i++) {
        if (
            lower(keywordFromEditText(state.keywords[i]))
            === lower(word)
        ) {
            alert("This keyword already exists.");
            return;
        }
    }
    state.keywords.push(word);
    var data = readIni(keywordIniPath());
    if (!data.Keywords) {
        data.Keywords = {};
    }
    data.Keywords.List = joinKeywords(state.keywords);
    writeIni(keywordIniPath(), data);

    if (state.selectedParent) {
        var assigned = getParentKeywords(state.selectedParent.path);
        assigned.push(word);
        saveParentKeywords(state.selectedParent.path, parseKeywordList(joinKeywords(assigned)));
        state.selectedParent.keywords = getParentKeywords(state.selectedParent.path);
    }

    input.value = "";
    renderKeywordFilters();
    renderParents();
    saveLibraryCache();
    setStatus("Keyword added" + (state.selectedParent ? " and assigned to " + state.selectedParent.name : "") + ": " + word);
}

function replaceKeywordInList(words, oldWord, newWord) {
    var oldKey = lower(oldWord);
    var result = [];
    var i;

    for (i = 0; i < words.length; i++) {
        result.push(
            lower(words[i]) === oldKey
            ? newWord
            : words[i]
        );
    }

    return parseKeywordList(joinKeywords(result));
}

function renameKeyword() {
    if (!state.root) {
        alert("Select a galleries root first.");
        return false;
    }

    var input = document.getElementById("keywordName");
    var requestedWord = keywordFromEditText(input.value);

    if (!requestedWord) {
        alert("Enter the current keyword in the Keyword field.");
        input.focus();
        return false;
    }

    var existingIndex = -1;
    var i;

    for (i = 0; i < state.keywords.length; i++) {
        if (
            lower(keywordFromEditText(state.keywords[i]))
            === lower(requestedWord)
        ) {
            existingIndex = i;
            break;
        }
    }

    if (existingIndex < 0) {
        alert("Keyword not found: " + requestedWord);
        return false;
    }

    var oldWord = state.keywords[existingIndex];
    var oldEditText = keywordEditText(oldWord);
    var newWord = prompt(
        "Rename keyword \"" + oldEditText + "\" to:",
        oldEditText
    );

    if (newWord === null) {
        return false;
    }

    newWord = keywordFromEditText(newWord);

    if (!newWord) {
        alert("Enter a new keyword name.");
        return false;
    }

    if (newWord.indexOf("|") >= 0) {
        alert("A keyword cannot contain |.");
        return false;
    }

    if (newWord === oldWord) {
        setStatus("Keyword name is unchanged: " + oldWord);
        return false;
    }

    for (i = 0; i < state.keywords.length; i++) {
        if (
            i !== existingIndex
            && lower(keywordFromEditText(state.keywords[i]))
                === lower(newWord)
        ) {
            alert("This keyword already exists.");
            return false;
        }
    }

    var oldKey = lower(oldWord);
    var newKey = lower(newWord);
    var keywordData = readIni(keywordIniPath());
    var section;

    state.keywords[existingIndex] = newWord;

    if (!keywordData.Keywords) {
        keywordData.Keywords = {};
    }

    keywordData.Keywords.List = joinKeywords(state.keywords);

    for (section in keywordData) {
        if (
            keywordData.hasOwnProperty(section)
            && section.indexOf("Parent.") === 0
        ) {
            var sectionWords = parseKeywordList(
                getIniValue(
                    keywordData,
                    section,
                    "Keywords",
                    ""
                )
            );
            keywordData[section].Keywords = joinKeywords(
                replaceKeywordInList(
                    sectionWords,
                    oldWord,
                    newWord
                )
            );
        }
    }

    writeIni(keywordIniPath(), keywordData);

    var settingsData = readIni(settingsPath);
    var presetSection =
        settingsData.KeywordFilterPresets || {};
    var presetsChanged = false;
    var presetKey;

    for (presetKey in presetSection) {
        if (
            presetSection.hasOwnProperty(presetKey)
            && (
                presetKey.indexOf("Preset.") === 0
                || presetKey.indexOf("PresetExclude.") === 0
            )
        ) {
            var presetWords = parseKeywordList(
                presetSection[presetKey]
            );
            var renamedPresetWords = replaceKeywordInList(
                presetWords,
                oldWord,
                newWord
            );
            var renamedPresetText =
                joinKeywords(renamedPresetWords);

            if (renamedPresetText !== presetSection[presetKey]) {
                presetSection[presetKey] = renamedPresetText;
                presetsChanged = true;
            }
        }
    }

    if (presetsChanged) {
        settingsData.KeywordFilterPresets = presetSection;
        writeIni(settingsPath, settingsData);
    }

    var activeMode = normalizeKeywordFilterMode(
        state.activeFilters[oldKey]
    );
    delete state.activeFilters[oldKey];

    if (activeMode) {
        state.activeFilters[newKey] = activeMode;
    }

    for (i = 0; i < state.parents.length; i++) {
        state.parents[i].keywords = replaceKeywordInList(
            state.parents[i].keywords || [],
            oldWord,
            newWord
        );
    }

    if (state.selectedParent) {
        state.selectedParent.keywords = replaceKeywordInList(
            state.selectedParent.keywords || [],
            oldWord,
            newWord
        );

        var galleryKeywords =
            document.getElementById("galleryKeywords");

        if (galleryKeywords) {
            galleryKeywords.innerText =
                state.selectedParent.keywords.join(", ");
        }
    }

    input.value = "";
    loadFilterPresets();
    renderKeywordFilters();
    renderParents();
    saveLibraryCache();
    setStatus(
        "Keyword renamed: "
        + oldWord
        + " → "
        + newWord
    );
    return true;
}

function clearUnusedKeywords() {
    if (!state.root) {
        return;
    }
    var data = readIni(keywordIniPath());
    var used = {};
    var section;
    for (section in data) {
        if (data.hasOwnProperty(section) && section.indexOf("Parent.") === 0) {
            var words = parseKeywordList(getIniValue(data, section, "Keywords", ""));
            var i;
            for (i = 0; i < words.length; i++) {
                used[lower(words[i])] = true;
            }
        }
    }
    var retained = [];
    var removed = [];
    var j;
    for (j = 0; j < state.keywords.length; j++) {
        if (used[lower(state.keywords[j])]) {
            retained.push(state.keywords[j]);
        } else {
            removed.push(state.keywords[j]);
        }
    }
    state.keywords = retained;
    if (!data.Keywords) {
        data.Keywords = {};
    }
    data.Keywords.List = joinKeywords(retained);
    writeIni(keywordIniPath(), data);
    pruneActiveFilters();
    renderKeywordFilters();
    renderParents();
    setStatus(removed.length ? removed.length + " unused keyword(s) removed." : "All keywords are assigned.");
}

function pruneActiveFilters() {
    var available = {};
    var i;
    for (i = 0; i < state.keywords.length; i++) {
        available[lower(state.keywords[i])] = true;
    }
    var clean = {};
    var key;
    for (key in state.activeFilters) {
        if (state.activeFilters.hasOwnProperty(key) && available[key]) {
            var mode = normalizeKeywordFilterMode(
                state.activeFilters[key]
            );

            if (mode) {
                clean[key] = mode;
            }
        }
    }
    state.activeFilters = clean;
}

function isCasedKeywordCharacter(character) {
    if (!character) {
        return false;
    }

    return character.toUpperCase() !== character.toLowerCase();
}

function keywordHasCasedCharacter(word) {
    var text = String(word || "");
    var i;

    for (i = 0; i < text.length; i++) {
        if (isCasedKeywordCharacter(text.charAt(i))) {
            return true;
        }
    }

    return false;
}

function firstCasedKeywordCharacter(word) {
    var text = String(word || "");
    var i;

    for (i = 0; i < text.length; i++) {
        if (isCasedKeywordCharacter(text.charAt(i))) {
            return text.charAt(i);
        }
    }

    return "";
}

function keywordCasePattern(word) {
    var text = String(word || "");

    if (keywordHasCasedCharacter(text)
        && text === text.toUpperCase()) {
        return "uppercase";
    }

    if (keywordHasCasedCharacter(text)
        && text === text.toLowerCase()) {
        return "lowercase";
    }

    var firstLetter = firstCasedKeywordCharacter(text);

    if (firstLetter
        && firstLetter === firstLetter.toUpperCase()) {
        return "capital";
    }

    return "other";
}

function keywordFormattingType(word) {
    var text = String(word || "");
    var firstCharacter = text.charAt(0);
    var hasSpecialPrefix =
        firstCharacter
        && !isCasedKeywordCharacter(firstCharacter)
        && !/[0-9]/.test(firstCharacter);
    var caseText =
        hasSpecialPrefix
        ? text.substring(1)
        : text;

    return {
        isSpecial: !!hasSpecialPrefix,
        specialCharacter:
            hasSpecialPrefix
            ? firstCharacter
            : "",
        casePattern: keywordCasePattern(caseText)
    };
}

function keywordControlText(word) {
    var text = String(word || "");
    var formatting = keywordFormattingType(text);

    return formatting.isSpecial
        ? text.substring(1).replace(/^\s+/, "")
        : text;
}

function keywordEditText(word) {
    var text = String(word || "").replace(/^\s+|\s+$/g, "");
    var formatting = keywordFormattingType(text);

    if (!formatting.isSpecial) {
        return text;
    }

    var name = keywordControlText(text);
    return formatting.specialCharacter
        + (name ? " " + name : "");
}

function keywordFromEditText(value) {
    var text = String(value || "").replace(/^\s+|\s+$/g, "");
    var formatting = keywordFormattingType(text);

    if (!formatting.isSpecial) {
        return text;
    }

    return formatting.specialCharacter
        + text.substring(1).replace(/^\s+/, "");
}

function sortKeywordWordsCaseInsensitive(words) {
    words.sort(function(leftWord, rightWord) {
        var leftKey = lower(leftWord);
        var rightKey = lower(rightWord);

        if (leftKey < rightKey) {
            return -1;
        }

        if (leftKey > rightKey) {
            return 1;
        }

        if (leftWord < rightWord) {
            return -1;
        }

        if (leftWord > rightWord) {
            return 1;
        }

        return 0;
    });

    return words;
}

function sortSpecialKeywordCharacters(characters) {
    var preferredOrder = "~@!#$%&";

    characters.sort(function(leftCharacter, rightCharacter) {
        var leftRank = preferredOrder.indexOf(leftCharacter);
        var rightRank = preferredOrder.indexOf(rightCharacter);

        if (leftRank >= 0 || rightRank >= 0) {
            if (leftRank < 0) {
                return 1;
            }

            if (rightRank < 0) {
                return -1;
            }

            return leftRank - rightRank;
        }

        if (leftCharacter < rightCharacter) {
            return -1;
        }

        if (leftCharacter > rightCharacter) {
            return 1;
        }

        return 0;
    });

    return characters;
}

function groupedKeywords(words) {
    var patternOrder = [
        "uppercase",
        "capital",
        "lowercase",
        "other"
    ];
    var specialGroups = {};
    var specialCharacters = [];
    var plainGroups = {};
    var i;

    for (i = 0; i < patternOrder.length; i++) {
        var patternName = patternOrder[i];

        plainGroups[patternName] = {
            key: "plain:" + patternName,
            isSpecial: false,
            specialCharacter: "",
            words: []
        };
    }

    for (i = 0; i < words.length; i++) {
        var word = words[i];
        var formatting = keywordFormattingType(word);
        var casePattern = formatting.casePattern;

        if (formatting.isSpecial) {
            var specialCharacter =
                formatting.specialCharacter;

            if (!specialGroups[specialCharacter]) {
                specialGroups[specialCharacter] = {};
                specialCharacters.push(specialCharacter);
            }

            if (!specialGroups[specialCharacter][casePattern]) {
                specialGroups[specialCharacter][casePattern] = {
                    key:
                        "special:"
                        + casePattern
                        + ":"
                        + specialCharacter,
                    words: []
                };
            }

            specialGroups[specialCharacter][casePattern].words.push(word);
        } else {
            plainGroups[casePattern].words.push(word);
        }
    }

    var result = [];

    // Keep every special prefix in one stable symbol-first sequence.
    // Inside each symbol, retain UPPERCASE, Capital, lowercase, Other.
    sortSpecialKeywordCharacters(specialCharacters);

    for (i = 0; i < specialCharacters.length; i++) {
        var orderedCharacter = specialCharacters[i];
        var specialPatternIndex;
        var combinedSpecialGroup = {
            key: "special:" + orderedCharacter,
            isSpecial: true,
            specialCharacter: orderedCharacter,
            words: []
        };

        for (
            specialPatternIndex = 0;
            specialPatternIndex < patternOrder.length;
            specialPatternIndex++
        ) {
            var specialPattern = patternOrder[specialPatternIndex];
            var patternGroup =
                specialGroups[orderedCharacter][specialPattern];

            if (patternGroup && patternGroup.words.length) {
                sortKeywordWordsCaseInsensitive(
                    patternGroup.words
                );

                var patternWordIndex;
                for (
                    patternWordIndex = 0;
                    patternWordIndex < patternGroup.words.length;
                    patternWordIndex++
                ) {
                    combinedSpecialGroup.words.push(
                        patternGroup.words[patternWordIndex]
                    );
                }
            }
        }

        result.push(combinedSpecialGroup);
    }

    // Then plain patterns:
    // UPPERCASE, Capital, lowercase, then Other.
    for (i = 0; i < patternOrder.length; i++) {
        var plainPattern = patternOrder[i];

        if (plainGroups[plainPattern].words.length) {
            sortKeywordWordsCaseInsensitive(
                plainGroups[plainPattern].words
            );
            result.push(plainGroups[plainPattern]);
        }
    }

    return result;
}

function setKeywordFilterState(word, mode) {
    if (mode === "include" || mode === "exclude") {
        state.activeFilters[lower(word)] = mode;
    } else {
        delete state.activeFilters[lower(word)];
    }

    renderKeywordFilters();
    renderParents();
}

function updateKeywordMatchModeButton() {
    var button = document.getElementById("keywordMatchModeButton");

    if (!button) {
        return;
    }

    state.keywordMatchMode = normalizeKeywordMatchMode(
        state.keywordMatchMode
    );
    button.className =
        "keywordMatchModeButton "
        + (state.keywordMatchMode === "all"
            ? "matchAll"
            : "matchAny");
    button.title = state.keywordMatchMode === "all"
        ? "ALL: every included keyword must match. Click for ANY."
        : "ANY: at least one included keyword must match. Click for ALL.";
}

function toggleKeywordMatchMode() {
    state.keywordMatchMode = state.keywordMatchMode === "all"
        ? "any"
        : "all";
    setIniValue(
        settingsPath,
        "Options",
        "KeywordMatchMode",
        state.keywordMatchMode
    );
    updateKeywordMatchModeButton();
    updateFilterPresetControls();
    renderParents();
    setStatus(
        "Keyword matching: "
        + state.keywordMatchMode.toUpperCase()
    );
    return false;
}

function createKeywordFilterButton(word) {
    var mode = normalizeKeywordFilterMode(
        state.activeFilters[lower(word)]
    );
    var button = document.createElement("button");
    var clickTimer = 0;
    var leftClickMode = mode === "include" ? "" : "include";
    var rightClickMode = mode === "exclude" ? "" : "exclude";

    button.type = "button";
    button.className =
        "keywordFilterButton"
        + (mode ? " " + mode : "");
    button.title =
        "LMB include · RMB exclude · Double-click rename: "
        + keywordEditText(word);
    button.innerHTML =
        '<span class="keywordFilterWord">'
        + escapeHtml(keywordControlText(word))
        + '</span>';

    button.onclick = function() {
        if (clickTimer) {
            window.clearTimeout(clickTimer);
        }

        clickTimer = window.setTimeout(function() {
            clickTimer = 0;
            setKeywordFilterState(word, leftClickMode);
        }, 260);

        window.event.cancelBubble = true;
        window.event.returnValue = false;
        return false;
    };

    button.oncontextmenu = function() {
        if (clickTimer) {
            window.clearTimeout(clickTimer);
            clickTimer = 0;
        }

        setKeywordFilterState(word, rightClickMode);

        window.event.cancelBubble = true;
        window.event.returnValue = false;
        return false;
    };

    button.ondblclick = function() {
        if (clickTimer) {
            window.clearTimeout(clickTimer);
            clickTimer = 0;
        }

        var input = document.getElementById("keywordName");
        input.value = keywordEditText(word);
        input.focus();
        input.select();
        setStatus(
            "Keyword ready to rename: "
            + word
        );

        window.event.cancelBubble = true;
        window.event.returnValue = false;
        return false;
    };

    return button;
}

function renderKeywordFilters() {
    var container = document.getElementById("keywordFilters");
    container.innerHTML = "";

    if (!state.keywords.length) {
        container.innerHTML =
            '<span class="smallMuted">No keywords defined.</span>';
        updateFilterPresetControls();
        updateFixedControlsLayout();
        return;
    }

    var groups = groupedKeywords(state.keywords);
    var groupIndex;

    for (groupIndex = 0; groupIndex < groups.length; groupIndex++) {
        var group = groups[groupIndex];
        var groupElement = document.createElement("div");
        groupElement.className = "keywordFilterGroup";

        var prefix = document.createElement("div");
        prefix.className = "keywordFilterPrefix";
        prefix.innerText = group.isSpecial
            ? group.specialCharacter
            : "";
        groupElement.appendChild(prefix);

        var buttons = document.createElement("div");
        buttons.className = "keywordFilterButtons";

        var wordIndex;

        for (wordIndex = 0; wordIndex < group.words.length; wordIndex++) {
            buttons.appendChild(
                createKeywordFilterButton(group.words[wordIndex])
            );
        }

        groupElement.appendChild(buttons);
        container.appendChild(groupElement);
    }

    updateFilterPresetControls();
    updateFixedControlsLayout();
}

function enumerateSubfolders(folderPath) {
    var result = [];
    if (!fso.FolderExists(folderPath)) {
        return result;
    }
    var folder = fso.GetFolder(folderPath);
    var e = new Enumerator(folder.SubFolders);
    for (; !e.atEnd(); e.moveNext()) {
        result.push(e.item().Path);
    }
    result.sort(function(a, b) {
        return lower(fso.GetFileName(a)) < lower(fso.GetFileName(b)) ? -1 : 1;
    });
    return result;
}

function enumerateFiles(folderPath) {
    var result = [];
    if (!fso.FolderExists(folderPath)) {
        return result;
    }
    var folder = fso.GetFolder(folderPath);
    var e = new Enumerator(folder.Files);
    for (; !e.atEnd(); e.moveNext()) {
        result.push(e.item().Path);
    }
    result.sort(function(a, b) {
        return lower(fso.GetFileName(a)) < lower(fso.GetFileName(b)) ? -1 : 1;
    });
    return result;
}

function unsignedHex(value) {
    var unsignedValue = value < 0 ? value + 4294967296 : value;
    var hex = unsignedValue.toString(16);

    while (hex.length < 8) {
        hex = "0" + hex;
    }

    return hex;
}

function thumbnailHash(text) {
    var hashOne = 5381;
    var hashTwo = 0x45d9f3b;
    var i;

    for (i = 0; i < text.length; i++) {
        var code = text.charCodeAt(i);
        hashOne = (((hashOne << 5) + hashOne) ^ code) | 0;
        hashTwo = (
            hashTwo
            ^ ((hashTwo << 5) + (hashTwo >> 2) + code)
        ) | 0;
    }

    return unsignedHex(hashOne) + unsignedHex(hashTwo);
}

function getThumbnailPath(sourcePath) {
    if (!sourcePath || !fso.FileExists(sourcePath)) {
        return "";
    }

    try {
        var file = fso.GetFile(sourcePath);
        var identity =
            lower(normalizePath(sourcePath))
            + "|"
            + String(file.Size)
            + "|"
            + String(new Date(file.DateLastModified).getTime());

        return thumbnailDir + "\\" + thumbnailHash(identity) + ".jpg";
    } catch (error) {
        return "";
    }
}

function resetThumbnailQueue() {
    state.thumbnailQueue = [];
    state.thumbnailQueueMap = {};
    state.thumbnailCompletedCount = 0;
    state.thumbnailFailedCount = 0;
}

function queueThumbnail(sourcePath, thumbnailPath) {
    if (!sourcePath || !thumbnailPath || fso.FileExists(thumbnailPath)) {
        return false;
    }

    var key = lower(thumbnailPath);

    if (state.thumbnailQueueMap[key]) {
        return false;
    }

    state.thumbnailQueueMap[key] = true;
    state.thumbnailQueue.push({
        source: sourcePath,
        destination: thumbnailPath
    });
    return true;
}

function getDisplayThumbnail(thumbnailPath, sourcePath) {
    if (thumbnailPath && fso.FileExists(thumbnailPath)) {
        return thumbnailPath;
    }

    if (sourcePath && fso.FileExists(sourcePath) && isPreviewImage(sourcePath)) {
        return sourcePath;
    }

    return "";
}

function synchronizeParentCover(parent) {
    if (!parent || !parent.path) {
        return false;
    }

    var currentCover = normalizePath(parent.path + "\\folder.jpg");
    var coverExists = fso.FileExists(currentCover);
    var changed = false;

    if (coverExists) {
        var expectedThumbnail = getThumbnailPath(currentCover);

        if (lower(normalizePath(parent.cover || "")) !== lower(currentCover)) {
            parent.cover = currentCover;
            changed = true;
        }

        if (lower(normalizePath(parent.thumbnail || ""))
            !== lower(normalizePath(expectedThumbnail))) {
            parent.thumbnail = expectedThumbnail;
            changed = true;
        }
    } else {
        var cachedCoverName = parent.cover
            ? lower(fso.GetFileName(parent.cover))
            : "";

        if (cachedCoverName === "folder.jpg") {
            parent.cover = "";
            parent.thumbnail = "";
            changed = true;
        }
    }

    return changed;
}

function collectMissingParentThumbnails() {
    resetThumbnailQueue();
    state.thumbnailQueueScope = "main";

    var parentIndex;

    for (parentIndex = 0; parentIndex < state.parents.length; parentIndex++) {
        var parent = state.parents[parentIndex];

        synchronizeParentCover(parent);

        if (!parent.cover) {
            continue;
        }

        var expectedThumbnail = getThumbnailPath(parent.cover);

        if (lower(normalizePath(parent.thumbnail || ""))
            !== lower(normalizePath(expectedThumbnail))) {
            parent.thumbnail = expectedThumbnail;
        }

        queueThumbnail(parent.cover, parent.thumbnail);
    }

    return state.thumbnailQueue.length;
}

function collectMissingGalleryThumbnails(parent) {
    resetThumbnailQueue();
    state.thumbnailQueueScope = "detail";

    if (!parent || !parent.galleries) {
        return 0;
    }

    var galleryIndex;

    for (galleryIndex = 0; galleryIndex < parent.galleries.length; galleryIndex++) {
        var gallery = parent.galleries[galleryIndex];

        if (!gallery.cover) {
            continue;
        }

        if (!gallery.thumbnail) {
            gallery.thumbnail = getThumbnailPath(gallery.cover);
        }

        queueThumbnail(gallery.cover, gallery.thumbnail);
    }

    return state.thumbnailQueue.length;
}

function writeThumbnailQueueFile(queueItems) {
    var queueFile = null;

    try {
        // CreateTextFile(..., true) writes UTF-16LE and avoids passing one
        // enormous BSTR through TextStream.Write, which can fail in HTA.
        queueFile = fso.CreateTextFile(thumbnailQueuePath, true, true);

        var i;

        for (i = 0; i < queueItems.length; i++) {
            queueFile.WriteLine(
                queueItems[i].source
                + "|"
                + queueItems[i].destination
            );
        }

        queueFile.Close();
        queueFile = null;
        return true;
    } catch (error) {
        if (queueFile) {
            try {
                queueFile.Close();
            } catch (closeError) {
            }
        }

        throw error;
    }
}

function startThumbnailGeneration() {
    if (state.thumbnailBuildRunning || !state.thumbnailQueue.length) {
        return false;
    }

    if (!ensureSharedDataDirectory()) {
        return false;
    }

    var batchCount = Math.min(
        state.thumbnailBatchSize,
        state.thumbnailQueue.length
    );
    var batchItems = state.thumbnailQueue.slice(0, batchCount);

    try {
        writeThumbnailQueueFile(batchItems);

        if (fso.FileExists(thumbnailDonePath)) {
            fso.DeleteFile(thumbnailDonePath, true);
        }
    } catch (error) {
        setStatus(
            "Could not create thumbnail queue: "
            + error.message
            + " ["
            + (error.number || "no code")
            + "]"
        );
        return false;
    }

    var command =
        '"'
        + bridgePath
        + '" --thumbnails "'
        + thumbnailQueuePath
        + '" "'
        + thumbnailDonePath
        + '"';

    try {
        shell.Run(command, 0, false);
    } catch (error) {
        setStatus("Could not start thumbnail worker: " + error.message);
        return false;
    }

    // Remove only the batch that was successfully handed to the worker.
    state.thumbnailQueue.splice(0, batchCount);
    state.thumbnailBuildRunning = true;

    var scopeLabel = state.thumbnailQueueScope === "detail"
        ? "detail"
        : "main-list";

    setStatus(
        "Generating "
        + scopeLabel
        + " thumbnail batch of "
        + batchCount
        + "; "
        + state.thumbnailQueue.length
        + " remain queued..."
    );
    return true;
}

function pollThumbnailGeneration() {
    if (!state.thumbnailBuildRunning || !fso.FileExists(thumbnailDonePath)) {
        return false;
    }

    var data = readIni(thumbnailDonePath);
    var created = parseInt(
        getIniValue(data, "Thumbnails", "Created", "0"),
        10
    ) || 0;
    var skipped = parseInt(
        getIniValue(data, "Thumbnails", "Skipped", "0"),
        10
    ) || 0;
    var failed = parseInt(
        getIniValue(data, "Thumbnails", "Failed", "0"),
        10
    ) || 0;
    var errorText = getIniValue(data, "Thumbnails", "Error", "");

    try {
        fso.DeleteFile(thumbnailDonePath, true);

        if (fso.FileExists(thumbnailQueuePath)) {
            fso.DeleteFile(thumbnailQueuePath, true);
        }
    } catch (error) {
    }

    state.thumbnailBuildRunning = false;
    state.thumbnailCompletedCount += created + skipped;
    state.thumbnailFailedCount += failed;

    renderParents();

    if (isGalleryDialogOpen() && state.selectedParent) {
        openGalleryDialog(state.selectedParent);
    }

    scheduleVisibleThumbnailRefresh();
    saveLibraryCache();

    if (errorText) {
        setStatus("Thumbnail worker error: " + errorText);
        return true;
    }

    if (state.thumbnailQueue.length > 0) {
        setStatus(
            "Thumbnail cache: "
            + state.thumbnailCompletedCount
            + " completed, "
            + state.thumbnailFailedCount
            + " failed; starting next batch..."
        );
        startThumbnailGeneration();
    } else {
        var finishedScope = state.thumbnailQueueScope === "detail"
            ? "Detail"
            : "Main-list";

        setStatus(
            finishedScope
            + " thumbnail cache updated: "
            + state.thumbnailCompletedCount
            + " completed, "
            + state.thumbnailFailedCount
            + " failed."
        );

        state.thumbnailQueueMap = {};
        state.thumbnailQueueScope = "";
    }

    return true;
}

function imageExtension(path) {
    return lower(fso.GetExtensionName(path));
}

function isSupportedImage(path) {
    var ext = imageExtension(path);
    return /^(jpg|jpeg|png|gif|bmp|tif|tiff|webp|heic|jfif)$/.test(ext);
}

function isPreviewImage(path) {
    var ext = imageExtension(path);
    return /^(jpg|jpeg|png|gif|bmp)$/.test(ext);
}

function getGalleryImageInfo(folderPath) {
    var files = enumerateFiles(folderPath);
    var info = {
        hasImages: false,
        preview: ""
    };
    var i;

    for (i = 0; i < files.length; i++) {
        if (!isSupportedImage(files[i])) {
            continue;
        }

        info.hasImages = true;

        // The generated-thumbnail worker can convert all supported formats.
        if (!info.preview) {
            info.preview = files[i];
        }
    }

    return info;
}

function firstInteger(nameOrPath) {
    var name = fso.GetBaseName(nameOrPath);
    if (fso.FolderExists(nameOrPath)) {
        name = fso.GetFileName(nameOrPath);
    }
    var match = String(name).match(/\d+/);
    return match ? parseInt(match[0], 10) : null;
}

function findPairedVideo(parentPath, galleryPath) {
    var number = firstInteger(galleryPath);
    if (number === null) {
        return "";
    }
    var files = enumerateFiles(parentPath);
    var matches = [];
    var i;
    for (i = 0; i < files.length; i++) {
        var ext = lower(fso.GetExtensionName(files[i]));
        if ((ext === "mp4" || ext === "wmv") && firstInteger(files[i]) === number) {
            matches.push(files[i]);
        }
    }
    return matches.length ? matches[0] : "";
}

function isSupportedVideo(path) {
    var ext = lower(fso.GetExtensionName(path || ""));
    return ext === "mp4" || ext === "wmv";
}

function getParentMediaCounts(parent, galleries) {
    if (!parent) {
        return {
            pairs: 0,
            galleries: 0,
            videos: 0
        };
    }

    if (parent._mediaCounts) {
        return parent._mediaCounts;
    }

    galleries = galleries || getAvailableParentGalleries(parent);

    var pairedVideoPaths = {};
    var pairCount = 0;
    var galleryCount = 0;
    var videoCount = 0;
    var i;

    for (i = 0; i < galleries.length; i++) {
        var pairedVideo = normalizePath(galleries[i].video || "");

        if (pairedVideo && fso.FileExists(pairedVideo)) {
            pairCount++;
            pairedVideoPaths[lower(pairedVideo)] = true;
        } else {
            galleryCount++;
        }
    }

    var parentFiles = enumerateFiles(parent.path);

    for (i = 0; i < parentFiles.length; i++) {
        if (
            isSupportedVideo(parentFiles[i])
            && !pairedVideoPaths[lower(normalizePath(parentFiles[i]))]
        ) {
            videoCount++;
        }
    }

    parent._mediaCounts = {
        pairs: pairCount,
        galleries: galleryCount,
        videos: videoCount
    };

    return parent._mediaCounts;
}

function encodeCacheField(value) {
    return encodeURIComponent(String(value || ""));
}

function decodeCacheField(value) {
    try {
        return decodeURIComponent(String(value || ""));
    } catch (error) {
        return "";
    }
}

function saveLibraryCache() {
    if (!state.root || !state.parents.length) {
        if (fso.FileExists(cachePath)) {
            try {
                fso.DeleteFile(cachePath, true);
            } catch (error) {
            }
        }
        return false;
    }

    var lines = [];
    lines.push("GallerySlideshowCache\t" + CACHE_VERSION);
    lines.push("Root\t" + encodeCacheField(state.root));

    var parentIndex;
    for (parentIndex = 0; parentIndex < state.parents.length; parentIndex++) {
        var parent = state.parents[parentIndex];

        lines.push([
            "P",
            String(parentIndex),
            encodeCacheField(parent.letter),
            encodeCacheField(parent.name),
            encodeCacheField(parent.path),
            encodeCacheField(parent.cover),
            encodeCacheField(parent.thumbnail),
            encodeCacheField(joinKeywords(parent.keywords))
        ].join("\t"));

        var galleryIndex;
        for (galleryIndex = 0; galleryIndex < parent.galleries.length; galleryIndex++) {
            var gallery = parent.galleries[galleryIndex];

            lines.push([
                "G",
                String(parentIndex),
                encodeCacheField(gallery.name),
                encodeCacheField(gallery.path),
                encodeCacheField(gallery.cover),
                encodeCacheField(gallery.thumbnail),
                encodeCacheField(gallery.video)
            ].join("\t"));
        }
    }

    try {
        writeText(cachePath, lines.join("\r\n"));
        return true;
    } catch (error) {
        setStatus("Library loaded, but cache could not be written: " + error.message);
        return false;
    }
}

function scheduleLibraryCacheSave(delayMs) {
    state.libraryCacheDirty = true;

    if (state.libraryCacheSaveTimer) {
        window.clearTimeout(state.libraryCacheSaveTimer);
    }

    state.libraryCacheSaveTimer = window.setTimeout(function() {
        state.libraryCacheSaveTimer = 0;

        if (!state.libraryCacheDirty) {
            return;
        }

        state.libraryCacheDirty = false;

        if (!saveLibraryCache()) {
            state.libraryCacheDirty = true;
        }
    }, Math.max(0, parseInt(delayMs, 10) || 0));
}

function flushLibraryCacheIfDirty() {
    if (state.libraryCacheSaveTimer) {
        window.clearTimeout(state.libraryCacheSaveTimer);
        state.libraryCacheSaveTimer = 0;
    }

    if (!state.libraryCacheDirty) {
        return true;
    }

    state.libraryCacheDirty = false;

    if (!saveLibraryCache()) {
        state.libraryCacheDirty = true;
        return false;
    }

    return true;
}

function loadLibraryCache() {
    if (!state.root || !fso.FileExists(cachePath)) {
        return false;
    }

    var lines = readText(cachePath).replace(/\r/g, "").split("\n");

    if (lines.length < 2 || lines[0] !== "GallerySlideshowCache\t" + CACHE_VERSION) {
        return false;
    }

    var rootParts = lines[1].split("\t");

    if (rootParts.length < 2
        || lower(normalizePath(decodeCacheField(rootParts[1]))) !== lower(state.root)) {
        return false;
    }

    var parentsByIndex = {};
    var cachedParents = [];
    var i;

    for (i = 2; i < lines.length; i++) {
        if (!lines[i]) {
            continue;
        }

        var fields = lines[i].split("\t");

        if (fields[0] === "P" && fields.length >= 8) {
            var parentIndex = parseInt(fields[1], 10);

            if (isNaN(parentIndex)) {
                continue;
            }

            var parent = {
                letter: decodeCacheField(fields[2]),
                name: decodeCacheField(fields[3]),
                path: decodeCacheField(fields[4]),
                cover: decodeCacheField(fields[5]),
                thumbnail: decodeCacheField(fields[6]),
                keywords: parseKeywordList(decodeCacheField(fields[7])),
                galleries: []
            };

            parentsByIndex[parentIndex] = parent;
            cachedParents.push(parent);
        } else if (fields[0] === "G" && fields.length >= 7) {
            var ownerIndex = parseInt(fields[1], 10);

            if (isNaN(ownerIndex) || !parentsByIndex[ownerIndex]) {
                continue;
            }

            parentsByIndex[ownerIndex].galleries.push({
                name: decodeCacheField(fields[2]),
                path: decodeCacheField(fields[3]),
                cover: decodeCacheField(fields[4]),
                thumbnail: decodeCacheField(fields[5]),
                video: decodeCacheField(fields[6])
            });
        }
    }

    if (!cachedParents.length) {
        return false;
    }

    state.parents = cachedParents;
    state.selectedParent = null;
    state.selectedParentPaths = {};
    restoreRememberedParentSelection();

    var missingParentThumbnailCount = collectMissingParentThumbnails();

    refreshParentRatings();
    saveLibraryCache();

    if (missingParentThumbnailCount > 0) {
        startThumbnailGeneration();
    } else {
        setStatus(
            state.parents.length
            + " parent galleries loaded from cache. Use Refresh library after folder changes."
        );
    }

    return true;
}

function scanLibrary() {
    closeGalleryDialog();
    state.parents = [];
    state.selectedParent = null;
    state.selectedParentPaths = {};
    resetThumbnailQueue();
    state.thumbnailQueueScope = "main";

    if (!state.root || !fso.FolderExists(state.root)) {
        renderParents();
        setStatus("Select an existing galleries root.");
        return;
    }

    setStatus("Scanning parent galleries...");
    loadKeywords();
    primeKeywordMenu();

    var letterFolders = enumerateSubfolders(state.root);
    var i;
    for (i = 0; i < letterFolders.length; i++) {
        var letter = fso.GetFileName(letterFolders[i]);
        if (!/^[A-Z]$/i.test(letter)) {
            continue;
        }
        var parentFolders = enumerateSubfolders(letterFolders[i]);
        var j;
        for (j = 0; j < parentFolders.length; j++) {
            var parentPath = parentFolders[j];
            var galleryFolders = enumerateSubfolders(parentPath);
            var galleries = [];
            var k;
            for (k = 0; k < galleryFolders.length; k++) {
                var galleryName = fso.GetFileName(galleryFolders[k]);
                if (/^(_DELETE|_CROP|_DUPLICATES|_SMALL)$/i.test(galleryName)) {
                    continue;
                }
                var imageInfo = getGalleryImageInfo(galleryFolders[k]);

                if (!imageInfo.hasImages) {
                    continue;
                }

                var galleryThumbnail = getThumbnailPath(imageInfo.preview);

                galleries.push({
                    path: galleryFolders[k],
                    name: galleryName,
                    cover: imageInfo.preview,
                    thumbnail: galleryThumbnail,
                    video: findPairedVideo(parentPath, galleryFolders[k])
                });
            }
            if (!galleries.length) {
                continue;
            }
            var parentCover = fso.FileExists(parentPath + "\\folder.jpg")
                ? parentPath + "\\folder.jpg"
                : "";
            var parentThumbnail = getThumbnailPath(parentCover);
            queueThumbnail(parentCover, parentThumbnail);

            state.parents.push({
                path: parentPath,
                name: fso.GetFileName(parentPath),
                letter: letter.toUpperCase(),
                cover: parentCover,
                thumbnail: parentThumbnail,
                rating: getParentRating(parentPath),
                keywords: getParentKeywords(parentPath),
                galleries: galleries
            });
        }
    }

    state.parents.sort(function(a, b) {
        var ak = a.letter + "\\" + lower(a.name);
        var bk = b.letter + "\\" + lower(b.name);
        return ak < bk ? -1 : (ak > bk ? 1 : 0);
    });

    restoreRememberedParentSelection();
    renderParents();
    saveLibraryCache();

    if (!startThumbnailGeneration()) {
        setStatus(
            state.parents.length
            + " parent galleries scanned and cached. Detail thumbnails will be generated on demand."
        );
    }
}

function uniqueParentPathKey(parentPath) {
    return lower(normalizePath(parentPath || ""));
}

function clearRandomUniqueAvailability() {
    state.randomUniqueSessionActive = false;
    state.randomUniqueParentSeenPaths = {};
    state.randomUniqueParentSeenSignature = "";
    state.randomUniqueActiveParentPath = "";
    state.randomUniquePendingParentPath = "";
    return true;
}

function pauseRandomUniqueAvailability() {
    state.randomUniqueSessionActive = false;
    state.randomUniqueActiveParentPath = "";
    state.randomUniquePendingParentPath = "";
    return true;
}

function randomUniqueAvailabilityIsActive() {
    return !!state.uniqueRandom;
}

function randomUniqueParentSeenMap(pathText) {
    var seenPaths = {};
    var paths = String(pathText || "").split("|");
    var i;

    for (i = 0; i < paths.length; i++) {
        var pathKey = uniqueParentPathKey(paths[i]);

        if (
            pathKey
            && pathKey !== "error"
            && pathKey !== "__empty__"
        ) {
            seenPaths[pathKey] = true;
        }
    }

    return seenPaths;
}

function getPersistentRandomUniqueParentSeenText() {
    var settingsData = readIni(settingsPath);

    state.persistentRandomUniqueParentSeenText = String(
        getIniValue(
            settingsData,
            "Options",
            "UniqueRandomParentSeen",
            ""
        )
    );

    if (
        lower(state.persistentRandomUniqueParentSeenText) === "error"
        || state.persistentRandomUniqueParentSeenText === "__EMPTY__"
    ) {
        state.persistentRandomUniqueParentSeenText = "";
    }

    return state.persistentRandomUniqueParentSeenText;
}

function getRandomUniqueParentSeenText(sessionData) {
    var sessionText = String(
        getIniValue(
            sessionData,
            "Session",
            "RandomUniqueParentSeen",
            ""
        )
    );

    if (lower(sessionText) === "error") {
        sessionText = "";
    }

    if (sessionText) {
        state.persistentRandomUniqueParentSeenText =
            sessionText;
        return sessionText;
    }

    return getPersistentRandomUniqueParentSeenText();
}

function randomUniqueParentSeenSignature(seenPaths) {
    var paths = [];
    var pathKey;

    for (pathKey in seenPaths) {
        if (seenPaths.hasOwnProperty(pathKey)) {
            paths.push(pathKey);
        }
    }

    paths.sort();
    return paths.join("|");
}

function resetCompletedUniqueParentsIfRoundFinished() {
    var filteredParents = getFilteredParents();
    var shownCount = 0;
    var i;

    if (!filteredParents.length) {
        return false;
    }

    for (i = 0; i < filteredParents.length; i++) {
        if (state.randomUniqueParentSeenPaths[
            uniqueParentPathKey(filteredParents[i].path)
        ]) {
            shownCount++;
        }
    }

    if (shownCount < filteredParents.length) {
        return false;
    }

    state.randomUniqueParentSeenPaths = {};
    state.randomUniqueParentSeenSignature = "";
    return true;
}

function completeUniqueParent(parentPath) {
    if (!markUniqueParentSeenLocally(parentPath)) {
        return false;
    }

    resetCompletedUniqueParentsIfRoundFinished();
    return true;
}

function syncRandomUniqueAvailability(sessionData) {
    var sessionActiveValue = String(
        getIniValue(
            sessionData,
            "Session",
            "RandomUnique",
            ""
        )
    );
    var sessionActive = sessionActiveValue
        ? sessionActiveValue === "1"
        : !!state.uniqueRandom;
    var parentSeenText =
        getRandomUniqueParentSeenText(sessionData);
    var currentParentKey = uniqueParentPathKey(
        getIniValue(
            sessionData,
            "Session",
            "CurrentParent",
            ""
        )
    );

    if (!currentParentKey && state.uniqueRandom) {
        sessionActive = true;
    }

    var pendingParentKey =
        state.randomUniquePendingParentPath;
    var previousSignature =
        state.randomUniqueParentSeenSignature;
    var previousActiveParent =
        state.randomUniqueActiveParentPath;

    if (pendingParentKey) {
        if (
            sessionActive
            && currentParentKey === pendingParentKey
        ) {
            state.randomUniqueActiveParentPath =
                currentParentKey;
            state.randomUniquePendingParentPath = "";
        }
    } else if (sessionActive && currentParentKey) {
        if (!previousActiveParent) {
            var restoredSeenPaths =
                randomUniqueParentSeenMap(
                    parentSeenText
                );

            if (restoredSeenPaths[currentParentKey]) {
                delete restoredSeenPaths[currentParentKey];
            }

            state.randomUniqueParentSeenPaths =
                restoredSeenPaths;
        } else if (previousActiveParent !== currentParentKey) {
            completeUniqueParent(previousActiveParent);
        }

        state.randomUniqueActiveParentPath =
            currentParentKey;
    } else if (sessionActive && !currentParentKey) {
        // Escape is not a parent transition. Keep completed parents hidden,
        // but leave the last active parent unmarked and available next time.
        state.randomUniqueParentSeenPaths =
            randomUniqueParentSeenMap(
                parentSeenText
            );
        state.randomUniqueActiveParentPath = "";
        state.randomUniquePendingParentPath = "";
    } else if (!sessionActive) {
        pauseRandomUniqueAvailability();
    }

    state.randomUniqueParentSeenSignature =
        randomUniqueParentSeenSignature(
            state.randomUniqueParentSeenPaths
        );

    var changed =
        sessionActive
            !== state.randomUniqueSessionActive
        || previousSignature
            !== state.randomUniqueParentSeenSignature
        || previousActiveParent
            !== state.randomUniqueActiveParentPath;

    // RandomUnique remains enabled after Escape so the completed-parent
    // round can resume. Store that stable session flag even with no current
    // parent; otherwise every poll looks changed and rebuilds all thumbnails.
    state.randomUniqueSessionActive = sessionActive;
    return changed;
}

function markUniqueParentSeenLocally(parentPath) {
    var pathKey = uniqueParentPathKey(parentPath);

    if (!pathKey) {
        return false;
    }

    state.randomUniqueParentSeenPaths[pathKey] = true;
    state.randomUniqueParentSeenSignature =
        randomUniqueParentSeenSignature(
            state.randomUniqueParentSeenPaths
        );
    return true;
}

function isGalleryAvailableForRandom(gallery) {
    return !!(gallery && gallery.path);
}

function isParentAvailableForRandom(parent) {
    if (!parent || !parent.path) {
        return false;
    }

    return !randomUniqueAvailabilityIsActive()
        || !state.randomUniqueParentSeenPaths[
            uniqueParentPathKey(parent.path)
        ];
}

function getAvailableParentGalleries(parent) {
    var galleries = [];
    var i;

    if (!parent || !parent.galleries) {
        return galleries;
    }

    for (i = 0; i < parent.galleries.length; i++) {
        galleries.push(parent.galleries[i]);
    }

    return galleries;
}

function firstAvailableParentGallery(parent) {
    var galleries = getAvailableParentGalleries(
        parent
    );
    return galleries.length ? galleries[0] : null;
}

function getFilteredParents() {
    var filteredParents = [];
    var i;

    for (i = 0; i < state.parents.length; i++) {
        if (parentMatches(state.parents[i])) {
            filteredParents.push(state.parents[i]);
        }
    }

    return filteredParents;
}

function getVisibleParents(filteredParents) {
    var candidates = filteredParents
        || getFilteredParents();
    var visibleParents = [];
    var i;

    for (i = 0; i < candidates.length; i++) {
        if (isParentAvailableForRandom(candidates[i])) {
            visibleParents.push(candidates[i]);
        }
    }

    return visibleParents;
}

function navigationMembershipSignature(visibleParents) {
    var parts = [];
    var parentIndex;
    var galleryIndex;

    for (
        parentIndex = 0;
        parentIndex < visibleParents.length;
        parentIndex++
    ) {
        var parent = visibleParents[parentIndex];
        parts.push("P:" + lower(parent.path));

        for (
            galleryIndex = 0;
            galleryIndex < parent.galleries.length;
            galleryIndex++
        ) {
            parts.push(
                "G:"
                + lower(
                    normalizePath(
                        parent.galleries[galleryIndex].path
                    )
                )
            );
        }
    }

    return parts.join("\n");
}

function shuffledCopyDifferent(sourceItems) {
    var original = sourceItems.slice(0);
    var shuffled = sourceItems.slice(0);
    var index;

    for (
        index = shuffled.length - 1;
        index > 0;
        index--
    ) {
        var swapIndex = Math.floor(
            Math.random() * (index + 1)
        );
        var temporary = shuffled[index];
        shuffled[index] = shuffled[swapIndex];
        shuffled[swapIndex] = temporary;
    }

    if (shuffled.length > 1) {
        var unchanged = true;

        for (index = 0; index < shuffled.length; index++) {
            if (shuffled[index] !== original[index]) {
                unchanged = false;
                break;
            }
        }

        // A valid random shuffle can equal the source order.
        // Rotate once so RANDOM SLIDESHOW visibly changes the order.
        if (unchanged) {
            shuffled.push(shuffled.shift());
        }
    }

    return shuffled;
}

function findVisibleParentByPath(
    visibleParents,
    parentPath
) {
    var normalizedTarget = lower(
        normalizePath(parentPath || "")
    );
    var i;

    if (!normalizedTarget) {
        return null;
    }

    for (i = 0; i < visibleParents.length; i++) {
        if (
            lower(normalizePath(visibleParents[i].path))
            === normalizedTarget
        ) {
            return visibleParents[i];
        }
    }

    return null;
}

function establishRandomNavigationOrder(
    visibleParents,
    preferredParentPath,
    preferredGalleryPath
) {
    var preferredParent = findVisibleParentByPath(
        visibleParents,
        preferredParentPath
    );
    var remainingParents = [];
    var parentIndex;

    for (
        parentIndex = 0;
        parentIndex < visibleParents.length;
        parentIndex++
    ) {
        if (
            preferredParent
            && lower(visibleParents[parentIndex].path)
                === lower(preferredParent.path)
        ) {
            continue;
        }

        remainingParents.push(visibleParents[parentIndex]);
    }

    var orderedParents =
        shuffledCopyDifferent(remainingParents);

    if (preferredParent) {
        orderedParents.unshift(preferredParent);
    } else {
        orderedParents =
            shuffledCopyDifferent(visibleParents);
    }

    state.navigationOrderMode = "random";
    state.randomMembershipSignature =
        navigationMembershipSignature(visibleParents);
    state.randomParentOrder = [];
    state.randomGalleryOrders = {};

    var preferredGalleryKey = lower(
        normalizePath(preferredGalleryPath || "")
    );

    for (
        parentIndex = 0;
        parentIndex < orderedParents.length;
        parentIndex++
    ) {
        var parent = orderedParents[parentIndex];
        var parentKey = lower(normalizePath(parent.path));
        var preferredGallery = null;
        var remainingGalleries = [];
        var galleryIndex;

        for (
            galleryIndex = 0;
            galleryIndex < parent.galleries.length;
            galleryIndex++
        ) {
            var gallery = parent.galleries[galleryIndex];
            var galleryKey = lower(
                normalizePath(gallery.path)
            );

            if (
                preferredGalleryKey
                && galleryKey === preferredGalleryKey
            ) {
                preferredGallery = gallery;
            } else {
                remainingGalleries.push(gallery);
            }
        }

        var orderedGalleries =
            shuffledCopyDifferent(remainingGalleries);

        if (preferredGallery) {
            orderedGalleries.unshift(preferredGallery);
        } else {
            orderedGalleries = shuffledCopyDifferent(
                parent.galleries
            );
        }

        state.randomParentOrder.push(parent.path);
        state.randomGalleryOrders[parentKey] = [];

        for (
            galleryIndex = 0;
            galleryIndex < orderedGalleries.length;
            galleryIndex++
        ) {
            state.randomGalleryOrders[parentKey].push(
                normalizePath(
                    orderedGalleries[galleryIndex].path
                )
            );
        }
    }

    return buildRandomNavigationPaths(visibleParents);
}

function buildRandomNavigationPaths(visibleParents) {
    var parentLookup = {};
    var parentIndex;
    var galleryIndex;

    for (
        parentIndex = 0;
        parentIndex < visibleParents.length;
        parentIndex++
    ) {
        parentLookup[
            lower(normalizePath(visibleParents[parentIndex].path))
        ] = visibleParents[parentIndex];
    }

    var paths = [];

    for (
        parentIndex = 0;
        parentIndex < state.randomParentOrder.length;
        parentIndex++
    ) {
        var parentPath =
            state.randomParentOrder[parentIndex];
        var parentKey = lower(normalizePath(parentPath));
        var parent = parentLookup[parentKey];
        var orderedGalleryPaths =
            state.randomGalleryOrders[parentKey] || [];

        if (!parent) {
            continue;
        }

        var galleryLookup = {};

        for (
            galleryIndex = 0;
            galleryIndex < parent.galleries.length;
            galleryIndex++
        ) {
            galleryLookup[
                lower(
                    normalizePath(
                        parent.galleries[galleryIndex].path
                    )
                )
            ] = normalizePath(
                parent.galleries[galleryIndex].path
            );
        }

        for (
            galleryIndex = 0;
            galleryIndex < orderedGalleryPaths.length;
            galleryIndex++
        ) {
            var galleryKey = lower(
                normalizePath(
                    orderedGalleryPaths[galleryIndex]
                )
            );

            if (galleryLookup[galleryKey]) {
                paths.push(galleryLookup[galleryKey]);
            }
        }
    }

    return paths;
}

function resolveNavigationGalleryPaths(visibleParents) {
    if (state.navigationOrderMode !== "random") {
        return buildFilteredGalleryPaths(visibleParents);
    }

    var membership =
        navigationMembershipSignature(visibleParents);
    var currentPaths =
        buildRandomNavigationPaths(visibleParents);
    var expectedGalleryCount =
        buildFilteredGalleryPaths(visibleParents).length;

    if (
        membership !== state.randomMembershipSignature
        || currentPaths.length !== expectedGalleryCount
    ) {
        return establishRandomNavigationOrder(
            visibleParents,
            state.currentParentPath,
            state.currentGalleryPath
        );
    }

    return currentPaths;
}

function activateRandomNavigation(
    visibleParents,
    preferredParentPath,
    preferredGalleryPath
) {
    var paths = establishRandomNavigationOrder(
        visibleParents,
        preferredParentPath,
        preferredGalleryPath
    );

    state.filteredQueueSignature = null;
    updateFilteredNavigationQueue(visibleParents);
    return paths;
}

function activateNormalNavigation(visibleParents) {
    state.navigationOrderMode = "normal";
    state.randomMembershipSignature = "";
    state.randomParentOrder = [];
    state.randomGalleryOrders = {};
    state.filteredQueueSignature = null;
    updateFilteredNavigationQueue(visibleParents);
    return true;
}

function findGalleryEntryByPath(galleryPath) {
    var target = lower(normalizePath(galleryPath || ""));
    var parentIndex;
    var galleryIndex;

    for (
        parentIndex = 0;
        parentIndex < state.parents.length;
        parentIndex++
    ) {
        for (
            galleryIndex = 0;
            galleryIndex
                < state.parents[parentIndex].galleries.length;
            galleryIndex++
        ) {
            var gallery =
                state.parents[parentIndex].galleries[galleryIndex];

            if (
                lower(normalizePath(gallery.path))
                === target
            ) {
                return {
                    parent: state.parents[parentIndex],
                    gallery: gallery
                };
            }
        }
    }

    return null;
}

function buildFilteredGalleryPaths(visibleParents) {
    var paths = [];
    var parentIndex;
    var galleryIndex;

    for (
        parentIndex = 0;
        parentIndex < visibleParents.length;
        parentIndex++
    ) {
        var galleries = visibleParents[parentIndex].galleries;

        for (
            galleryIndex = 0;
            galleryIndex < galleries.length;
            galleryIndex++
        ) {
            if (galleries[galleryIndex].path) {
                paths.push(
                    normalizePath(galleries[galleryIndex].path)
                );
            }
        }
    }

    return paths;
}

function buildParentPathsFromGalleryPaths(paths) {
    var parentPaths = [];
    var seenParents = {};
    var i;

    for (i = 0; i < paths.length; i++) {
        var parentPath = normalizePath(
            fso.GetParentFolderName(paths[i])
        );
        var parentKey = lower(parentPath);

        if (parentPath && !seenParents[parentKey]) {
            seenParents[parentKey] = true;
            parentPaths.push(parentPath);
        }
    }

    return parentPaths;
}

function updateFilteredNavigationQueue(visibleParents) {
    var paths =
        resolveNavigationGalleryPaths(visibleParents);
    var parentPaths =
        buildParentPathsFromGalleryPaths(paths);
    var signatureParts = [
        state.navigationOrderMode
    ];
    var i;

    for (i = 0; i < paths.length; i++) {
        signatureParts.push(lower(paths[i]));
    }

    var signature = signatureParts.join("\n");

    if (
        signature === state.filteredQueueSignature
        && nonEmptyFileExists(filteredNavigationPath)
    ) {
        return true;
    }

    var data = {
        Queue: {
            Valid: "1",
            Revision:
                String(new Date().getTime())
                + "-"
                + String(Math.floor(Math.random() * 100000)),
            Count: String(paths.length),
            ParentCount: String(parentPaths.length),
            Mode: state.navigationOrderMode
        }
    };

    for (i = 0; i < paths.length; i++) {
        data.Queue["Item" + (i + 1)] = paths[i];
    }

    for (i = 0; i < parentPaths.length; i++) {
        data.Queue["ParentItem" + (i + 1)] =
            parentPaths[i];
    }

    if (
        !writeTextAtomically(
            filteredNavigationPath,
            serializeIni(data)
        )
    ) {
        setStatus(
            "Could not update the filtered navigation queue."
        );
        return false;
    }

    state.filteredQueueSignature = signature;
    sendCommand("refreshnavigation", "");
    return true;
}

function parentMatches(parent) {
    var search = lower(state.searchText);
    if (search && lower(parent.name).indexOf(search) < 0) {
        return false;
    }

    var parentRating = parseInt(parent.rating, 10) || 0;

    if (state.ratingFilterMode === "exact"
        && state.ratingFilterValue >= 0
        && parentRating !== state.ratingFilterValue) {
        return false;
    }

    if (state.ratingFilterMode === "upto"
        && state.ratingFilterValue >= 0
        && parentRating > state.ratingFilterValue) {
        return false;
    }

    if (state.ratingFilterMode === "multiple"
        && !state.ratingFilterValues[parentRating]) {
        return false;
    }

    var parentKeywordSet = {};
    var i;

    for (i = 0; i < parent.keywords.length; i++) {
        parentKeywordSet[lower(parent.keywords[i])] = true;
    }

    var includeFilterCount = 0;
    var matchedIncludeFilterCount = 0;
    var key;

    for (key in state.activeFilters) {
        if (state.activeFilters.hasOwnProperty(key)) {
            var filterMode = normalizeKeywordFilterMode(
                state.activeFilters[key]
            );

            if (filterMode === "exclude" && parentKeywordSet[key]) {
                return false;
            }

            if (filterMode === "include") {
                includeFilterCount++;

                if (parentKeywordSet[key]) {
                    matchedIncludeFilterCount++;
                }
            }
        }
    }

    if (!includeFilterCount) {
        return true;
    }

    return normalizeKeywordMatchMode(state.keywordMatchMode) === "all"
        ? matchedIncludeFilterCount === includeFilterCount
        : matchedIncludeFilterCount > 0;
}

function renderParents() {
    var grid = document.getElementById("parentGrid");
    grid.innerHTML = "";

    var filtered = getFilteredParents();
    var visible = getVisibleParents(filtered);
    var groups = {};
    var letters = [];
    var i;

    for (i = 0; i < visible.length; i++) {
        var parent = visible[i];

        var letter = parent.letter
            ? String(parent.letter).toUpperCase()
            : "#";

        if (!groups[letter]) {
            groups[letter] = [];
            letters.push(letter);
        }

        groups[letter].push(parent);
    }

    // UNIQUE availability changes only the presentation. The bridge needs
    // the complete filtered pool so it can detect and reset a full round.
    updateFilteredNavigationQueue(filtered);

    document.getElementById("summaryTitle").innerText = "Parent galleries";
    var emptyState = document.getElementById(
        "emptyState"
    );
    emptyState.style.display =
        visible.length ? "none" : "block";
    emptyState.innerText =
        randomUniqueAvailabilityIsActive()
        ? "No unshown parent galleries remain in the current UNIQUE round."
        : "No parent galleries match the current filters.";

    if (state.displayMode === "tile") {
        grid.className = "tileView";
        document.getElementById("summaryText").innerText =
            visible.length
            + " shown / "
            + state.parents.length
            + " total · Tile view";

        for (i = 0; i < visible.length; i++) {
            grid.appendChild(createParentTile(visible[i]));
        }

        scheduleVisibleThumbnailRefresh();
        return;
    }

    grid.className = "sectionView";
    document.getElementById("summaryText").innerText =
        visible.length
        + " shown / "
        + state.parents.length
        + " total · "
        + letters.length
        + " letter groups";

    if (!visible.length) {
        state.expandedLetter = "";
        scheduleVisibleThumbnailRefresh();
        return;
    }

    if (!state.expandedLetter || !groups[state.expandedLetter]) {
        var preferredLetter = "";

        if (state.selectedParent && state.selectedParent.letter) {
            preferredLetter = String(
                state.selectedParent.letter
            ).toUpperCase();
        } else if (state.currentParentPath) {
            for (i = 0; i < visible.length; i++) {
                if (lower(visible[i].path) === lower(state.currentParentPath)) {
                    preferredLetter = String(
                        visible[i].letter || ""
                    ).toUpperCase();
                    break;
                }
            }
        }

        state.expandedLetter = groups[preferredLetter]
            ? preferredLetter
            : letters[0];
    }

    for (i = 0; i < letters.length; i++) {
        grid.appendChild(
            createLetterRollout(
                letters[i],
                groups[letters[i]]
            )
        );
    }

    scheduleVisibleThumbnailRefresh();
}

function createLetterRollout(letter, parents) {
    var rollout = document.createElement("div");
    var isOpen = state.expandedLetter === letter;

    rollout.className =
        "letterRollout"
        + (isOpen ? " open" : "");

    var header = document.createElement("div");
    header.className = "letterRolloutHeader";
    header.title = isOpen
        ? "Collapse " + letter
        : "Show galleries beginning with " + letter;

    header.innerHTML =
        '<span class="letterRolloutArrow">'
        + (isOpen ? "▼" : "▶")
        + '</span>'
        + '<span class="letterRolloutName">'
        + escapeHtml(letter)
        + '</span>'
        + '<span class="letterRolloutCount">'
        + parents.length
        + (parents.length === 1 ? " parent" : " parents")
        + '</span>'
        + '<span class="letterRolloutHint">'
        + (isOpen ? "click to collapse" : "click to expand")
        + '</span>';

    header.onclick = function() {
        toggleLetterRollout(letter);
        window.event.cancelBubble = true;
        window.event.returnValue = false;
        return false;
    };

    rollout.appendChild(header);

    if (isOpen) {
        var body = document.createElement("div");
        body.className = "letterRolloutBody";

        var i;

        for (i = 0; i < parents.length; i++) {
            body.appendChild(createParentTile(parents[i]));
        }

        rollout.appendChild(body);
    }

    return rollout;
}

function toggleLetterRollout(letter) {
    state.expandedLetter =
        state.expandedLetter === letter
        ? ""
        : letter;

    renderParents();
}

function createParentTile(parent) {
    var tile = document.createElement("div");
    var selected = isParentSelected(parent);
    var running = lower(state.currentParentPath) === lower(parent.path);
    tile.className = "parentTile" + (selected ? " selected" : "") + (running ? " running" : "");
    tile.title = parent.path;
    tile.tabIndex = -1;
    tile._parentPath = normalizePath(parent.path);

    var cover = document.createElement("div");
    cover.className = "parentCover";
    configureLazyCover(
        cover,
        parent.thumbnail,
        parent.cover,
        parent.name.charAt(0).toUpperCase()
    );
    var badge = document.createElement("span");
    badge.className = "letterBadge";
    badge.innerText = parent.letter;
    cover.appendChild(badge);

    var body = document.createElement("div");
    body.className = "parentBody";
    var availableGalleries =
        getAvailableParentGalleries(parent);
    var mediaCounts = getParentMediaCounts(parent, availableGalleries);
    var parentRating = parseInt(parent.rating, 10) || 0;

    body.innerHTML =
        '<div class="parentHeading">' +
            '<div class="parentName">' + escapeHtml(parent.name) + '</div>' +
            '<span class="ratingBadge' + (parentRating === 0 ? ' zero' : '') + '"' +
                ' title="' + escapeHtml(ratingText(parentRating)) + '">' +
                parentRating + '★' +
            '</span>' +
        '</div>' +
        '<div class="parentStats" title="Paired gallery/video items, unpaired galleries, and unpaired videos">' +
            '<span class="parentStat pairs"><span class="parentStatCount">' +
                mediaCounts.pairs + '</span>' +
                (mediaCounts.pairs === 1 ? 'pair' : 'pairs') + '</span>' +
            '<span class="parentStat galleries"><span class="parentStatCount">' +
                mediaCounts.galleries + '</span>' +
                (mediaCounts.galleries === 1 ? 'gallery' : 'galleries') + '</span>' +
            '<span class="parentStat videos"><span class="parentStatCount">' +
                mediaCounts.videos + '</span>' +
                (mediaCounts.videos === 1 ? 'video' : 'videos') + '</span>' +
        '</div>' +
        '<div class="keywordBadges">' + keywordBadgeHtml(parent.keywords) + '</div>';

    tile.appendChild(cover);
    tile.appendChild(body);

    tile.onclick = function() {
        var eventObject = window.event;
        var preserveSelection = !!(eventObject && eventObject.ctrlKey);

        // In legacy IE events left can be 1; in standards mode it is 0.
        if (eventObject
            && typeof eventObject.button !== "undefined"
            && eventObject.button !== 0
            && eventObject.button !== 1) {
            eventObject.returnValue = false;
            return false;
        }

        if (state.parentClickTimer) {
            window.clearTimeout(state.parentClickTimer);
        }

        state.parentClickTimer = window.setTimeout(function() {
            state.parentClickTimer = 0;
            if (preserveSelection) {
                toggleParentSelection(parent);
            } else {
                selectParent(parent);
            }
        }, 260);

        return true;
    };
    tile.ondblclick = function() {
        var eventObject = window.event;

        if (eventObject
            && typeof eventObject.button !== "undefined"
            && eventObject.button !== 0
            && eventObject.button !== 1) {
            eventObject.returnValue = false;
            return false;
        }

        if (state.parentClickTimer) {
            window.clearTimeout(state.parentClickTimer);
            state.parentClickTimer = 0;
        }

        setOnlyParentSelected(parent);
        rememberParentSelection(parent);
        state.expandedLetter = parent.letter
            ? String(parent.letter).toUpperCase()
            : state.expandedLetter;
        renderParents();
        openGalleryDialog(parent);

        return true;
    };
    tile.oncontextmenu = function() {
        if (state.parentClickTimer) {
            window.clearTimeout(state.parentClickTimer);
            state.parentClickTimer = 0;
        }

        if (!isParentSelected(parent)) {
            setOnlyParentSelected(parent);
            renderParents();
        } else {
            state.selectedParent = parent;
        }
        rememberParentSelection(parent);
        state.expandedLetter = parent.letter
            ? String(parent.letter).toUpperCase()
            : state.expandedLetter;
        showKeywordContext(
            parent,
            window.event.clientX,
            window.event.clientY,
            false,
            getSelectedParents()
        );
        window.event.cancelBubble = true;
        window.event.returnValue = false;
        return false;
    };
    return tile;
}

function keywordBadgeHtml(words) {
    var html = "";
    var i;
    for (i = 0; i < words.length; i++) {
        html +=
            '<span class="keywordBadge">'
            + escapeHtml(keywordControlText(words[i]))
            + '</span>';
    }
    return html;
}

function rememberParentSelection(parent) {
    if (!parent || !parent.path) {
        return false;
    }

    state.rememberedParentPath = normalizePath(parent.path);
    setIniValue(
        settingsPath,
        "Selection",
        "ParentPath",
        state.rememberedParentPath
    );
    return true;
}

function parentSelectionKey(parentOrPath) {
    var path = typeof parentOrPath === "string"
        ? parentOrPath
        : (parentOrPath && parentOrPath.path ? parentOrPath.path : "");
    return lower(normalizePath(path));
}

function isParentSelected(parent) {
    return !!state.selectedParentPaths[parentSelectionKey(parent)];
}

function setOnlyParentSelected(parent) {
    state.selectedParentPaths = {};

    if (!parent) {
        state.selectedParent = null;
        return false;
    }

    state.selectedParentPaths[parentSelectionKey(parent)] = true;
    state.selectedParent = parent;
    return true;
}

function getSelectedParents() {
    var selected = [];
    var i;

    for (i = 0; i < state.parents.length; i++) {
        if (isParentSelected(state.parents[i])) {
            selected.push(state.parents[i]);
        }
    }

    if (!selected.length && state.selectedParent) {
        setOnlyParentSelected(state.selectedParent);
        selected.push(state.selectedParent);
    }

    return selected;
}

function toggleParentSelection(parent) {
    var key = parentSelectionKey(parent);

    if (state.selectedParentPaths[key]) {
        delete state.selectedParentPaths[key];

        if (
            state.selectedParent
            && parentSelectionKey(state.selectedParent) === key
        ) {
            state.selectedParent = null;
            var remaining = getSelectedParents();
            state.selectedParent = remaining.length
                ? remaining[remaining.length - 1]
                : null;
        }
    } else {
        state.selectedParentPaths[key] = true;
        state.selectedParent = parent;
        rememberParentSelection(parent);
    }

    renderParents();
    setStatus(
        getSelectedParents().length
        + " parent thumbnail(s) selected. Ctrl+0–9 assigns a rating; right-click sets keywords."
    );
    return true;
}

function restoreRememberedParentSelection() {
    var rememberedPath = lower(
        normalizePath(state.rememberedParentPath)
    );
    var i;

    if (!rememberedPath) {
        return false;
    }

    for (i = 0; i < state.parents.length; i++) {
        if (
            lower(normalizePath(state.parents[i].path))
            === rememberedPath
        ) {
            state.selectedParent = state.parents[i];
            state.selectedParentPaths = {};
            state.selectedParentPaths[
                parentSelectionKey(state.parents[i])
            ] = true;
            state.expandedLetter = state.parents[i].letter
                ? String(state.parents[i].letter).toUpperCase()
                : state.expandedLetter;

            window.setTimeout(function() {
                focusParentThumbnail(
                    state.rememberedParentPath
                );
            }, 0);
            return true;
        }
    }

    return false;
}

function selectParent(parent) {
    setOnlyParentSelected(parent);
    rememberParentSelection(parent);
    state.expandedLetter = parent.letter
        ? String(parent.letter).toUpperCase()
        : state.expandedLetter;
    renderParents();

    window.setTimeout(function() {
        focusParentThumbnail(parent.path);
    }, 0);

    setStatus(
        "Selected gallery: "
        + parent.name
    );
    return true;
}

function sizeGalleryDialog(galleryCount) {
    var dialog = document.getElementById("galleryDialog");

    if (!dialog) {
        return false;
    }

    var viewportWidth = Math.max(
        320,
        document.documentElement.clientWidth
    );
    var viewportHeight = Math.max(
        240,
        document.documentElement.clientHeight
    );

    var outerMargin = 24;
    var headerHeight = 92;
    var gridPadding = 24;
    var cardOuterWidth = 224;
    var cardOuterHeight = 198;
    var count = Math.max(0, parseInt(galleryCount, 10) || 0);

    var maximumWidth = Math.max(
        320,
        viewportWidth - (outerMargin * 2)
    );
    var maximumHeight = Math.max(
        240,
        viewportHeight - (outerMargin * 2)
    );

    var maximumColumns = Math.max(
        1,
        Math.floor(
            (maximumWidth - gridPadding)
            / cardOuterWidth
        )
    );
    maximumColumns = Math.min(maximumColumns, 5);

    var preferredColumns = count > 0
        ? Math.ceil(Math.sqrt(count * 1.45))
        : 1;
    var columns = Math.max(
        1,
        Math.min(count || 1, preferredColumns, maximumColumns)
    );
    var rows = count > 0
        ? Math.ceil(count / columns)
        : 1;

    var minimumDialogWidth = Math.min(540, maximumWidth);
    var desiredWidth = Math.max(
        minimumDialogWidth,
        gridPadding + (columns * cardOuterWidth)
    );
    var desiredHeight =
        headerHeight
        + gridPadding
        + (rows * cardOuterHeight);

    var dialogWidth = Math.min(maximumWidth, desiredWidth);
    var dialogHeight = Math.min(
        maximumHeight,
        Math.max(270, desiredHeight)
    );

    var dialogLeft = Math.max(
        outerMargin,
        Math.floor((viewportWidth - dialogWidth) / 2)
    );
    var dialogTop = Math.max(
        outerMargin,
        Math.floor((viewportHeight - dialogHeight) / 2)
    );

    dialog.style.left = dialogLeft + "px";
    dialog.style.top = dialogTop + "px";
    dialog.style.right = "auto";
    dialog.style.bottom = "auto";
    dialog.style.width = dialogWidth + "px";
    dialog.style.height = dialogHeight + "px";

    return true;
}

function focusGalleryCardElement(card) {
    if (!card) {
        return false;
    }

    try {
        card.focus();
    } catch (error) {
    }

    try {
        card.scrollIntoView(false);
    } catch (scrollError) {
        var grid = document.getElementById(
            "galleryGrid"
        );

        if (grid) {
            grid.scrollTop =
                Math.max(
                    0,
                    card.offsetTop
                    - Math.floor(
                        grid.clientHeight / 2
                    )
                );
        }
    }

    scheduleVisibleThumbnailRefresh();
    return true;
}

function findParentTileByPath(parentPath) {
    var normalizedParent = lower(
        normalizePath(parentPath || "")
    );
    var grid = document.getElementById(
        "parentGrid"
    );

    if (!normalizedParent || !grid) {
        return null;
    }

    var elements = grid.getElementsByTagName(
        "div"
    );
    var i;

    for (i = 0; i < elements.length; i++) {
        var element = elements[i];
        var className =
            " " + (element.className || "") + " ";

        if (
            className.indexOf(" parentTile ") < 0
            || !element._parentPath
        ) {
            continue;
        }

        if (
            lower(element._parentPath)
            === normalizedParent
        ) {
            return element;
        }
    }

    return null;
}

function setParentTileSelectedFast(tile, selected) {
    if (!tile) {
        return false;
    }

    var className = (" " + (tile.className || "") + " ")
        .replace(/\sselected\s/g, " ")
        .replace(/^\s+|\s+$/g, "")
        .replace(/\s+/g, " ");

    if (selected) {
        className += (className ? " " : "") + "selected";
    }

    tile.className = className;
    return true;
}

function refreshParentKeywordPresentation(parent, words) {
    var normalizedParent = lower(normalizePath(parent.path));
    var actualParent = parent;
    var i;

    parent.keywords = words;

    for (i = 0; i < state.parents.length; i++) {
        if (lower(normalizePath(state.parents[i].path)) === normalizedParent) {
            state.parents[i].keywords = words;
            actualParent = state.parents[i];
            break;
        }
    }

    if (
        state.selectedParent
        && lower(normalizePath(state.selectedParent.path)) === normalizedParent
    ) {
        state.selectedParent = actualParent;
        document.getElementById("galleryKeywords").innerText =
            words.join(", ");
    }

    var tile = findParentTileByPath(parent.path);

    if (!tile) {
        return true;
    }

    var elements = tile.getElementsByTagName("div");

    for (i = 0; i < elements.length; i++) {
        var className = " " + (elements[i].className || "") + " ";

        if (className.indexOf(" keywordBadges ") >= 0) {
            elements[i].innerHTML = keywordBadgeHtml(words);
            break;
        }
    }

    return true;
}

function focusParentThumbnail(parentPath) {
    var tile = findParentTileByPath(parentPath);

    if (!tile) {
        return false;
    }

    try {
        tile.focus();
    } catch (error) {
    }

    try {
        tile.scrollIntoView(false);
    } catch (scrollError) {
        var content = document.getElementById(
            "content"
        );

        if (content) {
            content.scrollTop =
                Math.max(
                    0,
                    tile.offsetTop
                    - Math.floor(
                        content.clientHeight / 2
                    )
                );
        }
    }

    scheduleVisibleThumbnailRefresh();
    return true;
}

function focusRunningGalleryThumbnail(galleryPath) {
    var normalizedGallery = normalizePath(
        galleryPath || ""
    );

    if (!normalizedGallery) {
        return false;
    }

    var entry = findGalleryEntryByPath(
        normalizedGallery
    );

    if (!entry) {
        return false;
    }

    setOnlyParentSelected(entry.parent);
    rememberParentSelection(entry.parent);
    state.expandedLetter = entry.parent.letter
        ? String(entry.parent.letter).toUpperCase()
        : state.expandedLetter;

    renderParents();

    window.setTimeout(function() {
        focusParentThumbnail(
            entry.parent.path
        );
    }, 0);

    return true;
}

function refreshUniqueAvailabilityPresentation() {
    var dialogWasOpen = isGalleryDialogOpen();
    var dialogParent = state.selectedParent;
    var selectedGalleryPath = state.selectedGallery
        ? state.selectedGallery.path
        : "";

    renderParents();

    if (!dialogWasOpen || !dialogParent) {
        return true;
    }

    if (
        randomUniqueAvailabilityIsActive()
        && state.randomUniqueParentSeenPaths[
            uniqueParentPathKey(dialogParent.path)
        ]
    ) {
        closeGalleryDialog();
        return true;
    }

    openGalleryDialog(
        dialogParent,
        selectedGalleryPath
    );
    return true;
}

function startFirstAvailableGallery() {
    var gallery = firstAvailableParentGallery(
        state.selectedParent
    );

    if (!gallery) {
        setStatus(
            "This parent has no available galleries."
        );
        return false;
    }

    return startGallery(gallery);
}

function openGalleryDialog(parent, focusGalleryPath) {
    state.selectedGallery = null;
    document.getElementById("galleryTitle").innerText =
        parent.name;
    document.getElementById("galleryKeywords").innerText =
        parent.keywords.length
        ? parent.keywords.join(", ")
        : "";

    var grid = document.getElementById(
        "galleryGrid"
    );
    grid.innerHTML = "";

    var normalizedFocusPath = lower(
        normalizePath(focusGalleryPath || "")
    );
    var focusGallery = null;
    var focusCard = null;
    var availableGalleries =
        getAvailableParentGalleries(parent);
    var i;

    for (i = 0; i < availableGalleries.length; i++) {
        var gallery = availableGalleries[i];
        var card = createGalleryCard(gallery);
        grid.appendChild(card);

        if (
            normalizedFocusPath
            && lower(normalizePath(gallery.path))
                === normalizedFocusPath
        ) {
            focusGallery = gallery;
            focusCard = card;
        }
    }

    sizeGalleryDialog(availableGalleries.length);
    document.getElementById(
        "galleryOverlay"
    ).style.display = "block";

    if (focusGallery && focusCard) {
        selectGalleryCard(
            focusGallery,
            focusCard,
            true
        );
        window.setTimeout(function() {
            focusGalleryCardElement(focusCard);
        }, 0);
    } else {
        updateSelectedGalleryButton();
    }

    scheduleVisibleThumbnailRefresh();

    if (
        !state.thumbnailBuildRunning
        && collectMissingGalleryThumbnails(parent) > 0
    ) {
        startThumbnailGeneration();
    }
}

function closeGalleryDialog() {
    document.getElementById("galleryOverlay").style.display = "none";
    state.selectedGallery = null;
    updateSelectedGalleryButton();
    hideContextMenu();
}

function isGalleryDialogOpen() {
    return document.getElementById("galleryOverlay").style.display === "block";
}

function updateSelectedGalleryButton() {
    var button = document.getElementById(
        "startSelectedRandomButton"
    );

    if (!button) {
        return false;
    }

    var hasParentGalleries = !!(
        state.selectedParent
        && getAvailableParentGalleries(
            state.selectedParent
        ).length
    );

    button.disabled = !hasParentGalleries;

    if (button.disabled) {
        button.title =
            "This parent has no available galleries.";
    } else if (
        state.selectedGallery
        && state.selectedGallery.path
    ) {
        button.title =
            "Start random slideshow from "
            + state.selectedGallery.name;
    } else {
        button.title =
            "Start random slideshow from a random "
            + "gallery in this parent.";
    }

    return true;
}

function clearSelectedGallery() {
    state.selectedGallery = null;

    var grid = document.getElementById("galleryGrid");

    if (grid) {
        var cards = grid.getElementsByTagName("div");
        var i;

        for (i = 0; i < cards.length; i++) {
            if (
                (" " + cards[i].className + " ")
                    .indexOf(" galleryCard ") >= 0
            ) {
                cards[i].className =
                    cards[i].className
                        .replace(/\s*selected\b/g, "");
            }
        }
    }

    updateSelectedGalleryButton();
    return true;
}

function selectGalleryCard(
    gallery,
    card,
    suppressStatus
) {
    clearSelectedGallery();

    state.selectedGallery = gallery;

    if (
        (" " + card.className + " ")
            .indexOf(" selected ") < 0
    ) {
        card.className += " selected";
    }

    updateSelectedGalleryButton();

    if (!suppressStatus) {
        setStatus(
            "Selected gallery: "
            + gallery.name
        );
    }

    return true;
}

function startRandomFromSelectedGallery() {
    var parent = state.selectedParent;
    var availableGalleries =
        getAvailableParentGalleries(parent);

    if (
        !parent
        || !availableGalleries.length
    ) {
        setStatus(
            "This parent has no available galleries."
        );
        return false;
    }

    var gallery = state.selectedGallery;

    if (
        !gallery
        || !gallery.path
        || !isGalleryAvailableForRandom(gallery)
    ) {
        gallery = availableGalleries[
            Math.floor(
                Math.random()
                * availableGalleries.length
            )
        ];
    }

    var filteredParents = getFilteredParents();

    if (
        !parentMatches(parent)
        || !isParentAvailableForRandom(parent)
    ) {
        setStatus(
            "The selected parent does not match "
            + "the current filters."
        );
        return false;
    }

    var shuffledPaths = activateRandomNavigation(
        filteredParents,
        parent.path,
        gallery.path
    );

    setActiveSlideshowType("random");
    closeGalleryDialog();
    startGallery(gallery, "preserve");
    setStatus(
        "Random slideshow starts from "
        + gallery.name
        + "; "
        + Math.max(0, shuffledPaths.length - 1)
        + " following galleries were shuffled."
    );
    return true;
}

function createGalleryCard(gallery) {
    var card = document.createElement("div");
    card.className = "galleryCard" + (gallery.video ? " video" : "");
    card.title = gallery.path;
    card.tabIndex = -1;
    card._galleryPath = normalizePath(gallery.path);

    var imagePanel = document.createElement("div");
    imagePanel.className = "galleryImage";
    configureLazyCover(
        imagePanel,
        gallery.thumbnail,
        gallery.cover,
        gallery.name
    );

    var infoPanel = document.createElement("div");
    infoPanel.className = "galleryInfo";
    infoPanel.innerHTML =
        '<div class="galleryName">' + escapeHtml(gallery.name) + '</div>' +
        '<div class="galleryFlags">' + (gallery.video ? "Paired video" : "Images only") + '</div>';

    card.appendChild(imagePanel);
    card.appendChild(infoPanel);

    card.onclick = function() {
        selectGalleryCard(gallery, card);
    };
    card.ondblclick = function() {
        selectGalleryCard(gallery, card);
        startGallery(gallery);
    };
    card.oncontextmenu = function() {
        if (state.selectedParent) {
            showKeywordContext(
                state.selectedParent,
                window.event.clientX,
                window.event.clientY
            );
        }

        window.event.cancelBubble = true;
        window.event.returnValue = false;
        return false;
    };
    return card;
}

function startGallery(gallery, slideshowMode) {
    if (!gallery || !gallery.path) {
        return false;
    }

    slideshowMode = slideshowMode || "random";

    if (slideshowMode === "normal") {
        activateNormalNavigation(
            getFilteredParents()
        );
        setActiveSlideshowType("normal");
        pauseRandomUniqueAvailability();
    } else if (slideshowMode === "random") {
        var galleryEntry = findGalleryEntryByPath(
            gallery.path
        );
        var preferredParentPath = galleryEntry
            ? galleryEntry.parent.path
            : fso.GetParentFolderName(gallery.path);

        activateRandomNavigation(
            getFilteredParents(),
            preferredParentPath,
            gallery.path
        );
        setActiveSlideshowType("random");
    }

    ensureBridge();

    var commandAction =
        state.activeSlideshowType === "random"
        ? (
            state.uniqueRandom
            ? "startrandomunique"
            : "startrandom"
        )
        : "start";

    sendCommand(commandAction, gallery.path);
    state.currentGalleryPath = gallery.path;
    state.currentParentPath =
        fso.GetParentFolderName(gallery.path);

    if (
        state.activeSlideshowType === "random"
        && state.uniqueRandom
    ) {
        // Starting another slideshow resumes the same durable parent round.
        // The active parent stays visible until a different parent opens.
        state.randomUniqueSessionActive = true;
        state.randomUniqueActiveParentPath =
            uniqueParentPathKey(
                state.currentParentPath
            );
        state.randomUniquePendingParentPath =
            uniqueParentPathKey(
                state.currentParentPath
            );
    } else {
        pauseRandomUniqueAvailability();
    }

    refreshUniqueAvailabilityPresentation();
    focusRunningGalleryThumbnail(gallery.path);
    setStatus("Starting: " + gallery.name);
    return true;
}

function firstFilteredParentGallery() {
    var i;

    for (i = 0; i < state.parents.length; i++) {
        if (
            parentMatches(state.parents[i])
            && isParentAvailableForRandom(
                state.parents[i]
            )
            && getAvailableParentGalleries(
                state.parents[i]
            ).length
        ) {
            return {
                parent: state.parents[i],
                gallery: firstAvailableParentGallery(
                    state.parents[i]
                )
            };
        }
    }

    return null;
}

function startMainSlideshow() {
    var parent = null;
    var gallery = null;

    if (
        state.selectedGallery
        && state.selectedParent
        && parentMatches(state.selectedParent)
        && isParentAvailableForRandom(
            state.selectedParent
        )
        && isGalleryAvailableForRandom(
            state.selectedGallery
        )
    ) {
        parent = state.selectedParent;
        gallery = state.selectedGallery;
    } else if (
        state.selectedParent
        && parentMatches(state.selectedParent)
        && isParentAvailableForRandom(
            state.selectedParent
        )
        && getAvailableParentGalleries(
            state.selectedParent
        ).length
    ) {
        parent = state.selectedParent;
        gallery = firstAvailableParentGallery(
            state.selectedParent
        );
    } else {
        var firstMatch = firstFilteredParentGallery();

        if (firstMatch) {
            parent = firstMatch.parent;
            gallery = firstMatch.gallery;
        }
    }

    if (!gallery) {
        alert(
            "No gallery matches the current keyword and rating filters."
        );
        return false;
    }

    setOnlyParentSelected(parent);
    state.expandedLetter = parent.letter
        ? String(parent.letter).toUpperCase()
        : state.expandedLetter;

    if (isGalleryDialogOpen()) {
        closeGalleryDialog();
    }

    startGallery(gallery, "normal");
    return true;
}

function startRandom() {
    var candidates = getVisibleParents();
    var filteredParents = getFilteredParents();

    if (!candidates.length) {
        alert(
            "No parent gallery matches the current filters."
        );
        return false;
    }

    var preferredEntry = null;

    if (
        state.selectedGallery
        && state.selectedGallery.path
    ) {
        var selectedEntry = findGalleryEntryByPath(
            state.selectedGallery.path
        );

        if (
            selectedEntry
            && parentMatches(selectedEntry.parent)
            && isParentAvailableForRandom(
                selectedEntry.parent
            )
            && isGalleryAvailableForRandom(
                selectedEntry.gallery
            )
        ) {
            preferredEntry = selectedEntry;
        }
    }

    if (
        !preferredEntry
        && state.selectedParent
        && parentMatches(state.selectedParent)
        && isParentAvailableForRandom(
            state.selectedParent
        )
        && getAvailableParentGalleries(
            state.selectedParent
        ).length
    ) {
        preferredEntry = {
            parent: state.selectedParent,
            gallery: firstAvailableParentGallery(
                state.selectedParent
            )
        };
    }

    var shuffledPaths = activateRandomNavigation(
        filteredParents,
        preferredEntry
            ? preferredEntry.parent.path
            : "",
        preferredEntry
            ? preferredEntry.gallery.path
            : ""
    );

    var firstEntry = preferredEntry;

    if (!firstEntry) {
        var randomParent = candidates[
            Math.floor(Math.random() * candidates.length)
        ];

        var randomParentGalleries =
            getAvailableParentGalleries(
                randomParent
            );

        if (randomParentGalleries.length) {
            firstEntry = {
                parent: randomParent,
                gallery: randomParentGalleries[
                    Math.floor(
                        Math.random()
                        * randomParentGalleries.length
                    )
                ]
            };
        }
    }

    if (!firstEntry) {
        alert(
            "No gallery could be added to the random queue."
        );
        return false;
    }

    setOnlyParentSelected(firstEntry.parent);
    state.expandedLetter = firstEntry.parent.letter
        ? String(firstEntry.parent.letter).toUpperCase()
        : state.expandedLetter;

    if (isGalleryDialogOpen()) {
        closeGalleryDialog();
    }

    setActiveSlideshowType("random");
    startGallery(firstEntry.gallery, "preserve");
    setStatus(
        "Random slideshow starts on selected parent: "
        + firstEntry.parent.name
        + ", gallery: "
        + firstEntry.gallery.name
        + ". Next parent will be chosen randomly from "
        + candidates.length
        + " filtered parents."
    );
    return true;
}

function uniqueCropRestoreDestinationPath(destinationPath) {
    if (!fso.FileExists(destinationPath)) {
        return destinationPath;
    }

    var directory = fso.GetParentFolderName(destinationPath);
    var baseName = fso.GetBaseName(destinationPath);
    var extension = fso.GetExtensionName(destinationPath);
    var extensionText = extension ? "." + extension : "";
    var candidate =
        directory
        + "\\"
        + baseName
        + " - Restored"
        + extensionText;
    var suffix = 2;

    while (fso.FileExists(candidate)) {
        candidate =
            directory
            + "\\"
            + baseName
            + " - Restored "
            + suffix
            + extensionText;
        suffix++;
    }

    return candidate;
}

function restoreSelectedCropBackups() {
    var selectedParents = getSelectedParents();

    if (!selectedParents.length) {
        alert("Select at least one parent thumbnail first.");
        return false;
    }

    if (!confirm(
        "Restore image backups from every gallery _CROP folder in "
        + selectedParents.length
        + " selected parent(s)?\n\n"
        + "Existing files will never be overwritten. Backup sources will remain in _CROP."
    )) {
        return false;
    }

    var selectedPathMap = {};
    var restoredParentMap = {};
    var restoredCount = 0;
    var restoredGalleryCount = 0;
    var failedCount = 0;
    var parentIndex;

    for (parentIndex = 0; parentIndex < selectedParents.length; parentIndex++) {
        var parent = selectedParents[parentIndex];
        var parentKey = parentSelectionKey(parent);
        selectedPathMap[parentKey] = true;

        if (!parent.path || !fso.FolderExists(parent.path)) {
            failedCount++;
            continue;
        }

        var galleryFolders = enumerateSubfolders(parent.path);
        var galleryIndex;

        for (galleryIndex = 0; galleryIndex < galleryFolders.length; galleryIndex++) {
            var galleryPath = galleryFolders[galleryIndex];
            var galleryName = fso.GetFileName(galleryPath);

            if (/^(_DELETE|_CROP|_DUPLICATES|_SMALL)$/i.test(galleryName)) {
                continue;
            }

            var cropPath = galleryPath + "\\_CROP";

            if (!fso.FolderExists(cropPath)) {
                continue;
            }

            var cropFiles = enumerateFiles(cropPath);
            var restoredInGallery = 0;
            var fileIndex;

            for (fileIndex = 0; fileIndex < cropFiles.length; fileIndex++) {
                var sourcePath = cropFiles[fileIndex];

                if (!isSupportedImage(sourcePath)) {
                    continue;
                }

                var requestedDestination =
                    galleryPath
                    + "\\"
                    + fso.GetFileName(sourcePath);
                var destinationPath =
                    uniqueCropRestoreDestinationPath(requestedDestination);

                try {
                    fso.CopyFile(sourcePath, destinationPath, false);

                    if (fso.FileExists(destinationPath)) {
                        restoredCount++;
                        restoredInGallery++;
                        restoredParentMap[parentKey] = true;
                    } else {
                        failedCount++;
                    }
                } catch (error) {
                    failedCount++;
                }
            }

            if (restoredInGallery > 0) {
                restoredGalleryCount++;
            }
        }
    }

    if (!restoredCount) {
        var emptyMessage = failedCount
            ? "No crop backups were restored; " + failedCount + " file operation(s) failed."
            : "No supported image backups were found in the selected parents’ gallery _CROP folders.";
        alert(emptyMessage);
        setStatus(emptyMessage);
        return false;
    }

    scanLibrary();
    state.selectedParentPaths = {};
    state.selectedParent = null;

    for (parentIndex = 0; parentIndex < state.parents.length; parentIndex++) {
        var refreshedParent = state.parents[parentIndex];
        var refreshedKey = parentSelectionKey(refreshedParent);

        if (selectedPathMap[refreshedKey]) {
            state.selectedParentPaths[refreshedKey] = true;
            state.selectedParent = refreshedParent;
        }
    }

    renderParents();

    var parentCount = 0;
    var restoredParentKey;
    for (restoredParentKey in restoredParentMap) {
        if (restoredParentMap.hasOwnProperty(restoredParentKey)) {
            parentCount++;
        }
    }

    var message =
        "Restored "
        + restoredCount
        + " image backup(s) across "
        + restoredGalleryCount
        + " gallery folder(s) in "
        + parentCount
        + " selected parent(s). Sources remain in _CROP.";

    if (failedCount) {
        message += " " + failedCount + " file operation(s) failed.";
        alert(message);
    }

    setStatus(message);
    return true;
}

function openCurrentParent() {
    var parent = state.selectedParent;
    if (!parent && state.currentParentPath) {
        parent = { path: state.currentParentPath };
    }
    if (!parent || !parent.path) {
        alert("Select a parent gallery first.");
        return;
    }
    shell.Run('explorer.exe "' + parent.path.replace(/"/g, '""') + '"', 1, false);
}

function searchChanged() {
    state.searchText = document.getElementById("searchInput").value;
    renderParents();
}

function getCachedKeywordGroups() {
    var signature = joinKeywords(state.keywords);

    if (keywordGroupCacheSignature !== signature) {
        keywordGroupCacheSignature = signature;
        keywordGroupCache = groupedKeywords(state.keywords);
        keywordMenuMarkupSignature = "";
        keywordMenuMarkupCache = "";
        keywordMenuWordCache = [];
    }

    return keywordGroupCache;
}

function normalizeKeywordMenuTargets(parent, targetParents) {
    var source = targetParents && targetParents.length
        ? targetParents
        : [parent];
    var targets = [];
    var seen = {};
    var i;

    for (i = 0; i < source.length; i++) {
        if (!source[i] || !source[i].path) {
            continue;
        }

        var key = parentSelectionKey(source[i]);

        if (!seen[key]) {
            seen[key] = true;
            targets.push(source[i]);
        }
    }

    if (!targets.length && parent) {
        targets.push(parent);
    }

    return targets;
}

function updateKeywordMenuButtonState(
    button,
    assignedAll,
    assignedAny,
    targetCount
) {
    var active = !!assignedAll[button._keywordKey];
    var mixed = !active && !!assignedAny[button._keywordKey];
    var count = Math.max(1, parseInt(targetCount, 10) || 1);
    var targetLabel = count === 1
        ? "parent"
        : count + " selected parents";

    button.className =
        "contextKeywordButton"
        + (active ? " active" : (mixed ? " mixed" : ""));
    button.title =
        active
        ? "Remove from " + targetLabel + ": " + button._keywordWord
        : "Assign to " + targetLabel + ": " + button._keywordWord
            + (mixed ? " (currently assigned to some)" : "");
}

function keywordMenuButtonClicked() {
    var button = this;
    var menu = button._keywordMenu;
    var targets = menu && menu._keywordTargets;
    var assignedAll = menu && menu._keywordAssignedAll;
    var assignedAny = menu && menu._keywordAssignedAny;

    if (!targets || !targets.length || !assignedAll || !assignedAny) {
        return false;
    }

    var newChecked = !assignedAll[button._keywordKey];
    if (!toggleParentsKeyword(
        targets,
        button._keywordWord,
        newChecked
    )) {
        return false;
    }

    assignedAll[button._keywordKey] = newChecked;
    assignedAny[button._keywordKey] = newChecked;
    updateKeywordMenuButtonState(
        button,
        assignedAll,
        assignedAny,
        targets.length
    );

    var clickEvent =
        button.ownerDocument.parentWindow
        && button.ownerDocument.parentWindow.event;

    if (clickEvent) {
        clickEvent.cancelBubble = true;
        clickEvent.returnValue = false;
    }

    return false;
}

function hydrateKeywordMenuStructure(menu, signature) {
    menu._keywordButtons = [];

    var spans = menu.getElementsByTagName("span");
    var i;

    for (i = 0; i < spans.length; i++) {
        var className = " " + (spans[i].className || "") + " ";

        if (className.indexOf(" contextRatingStars ") >= 0) {
            menu._keywordRatingStars = spans[i];
        } else if (className.indexOf(" contextRatingCount ") >= 0) {
            menu._keywordRatingCount = spans[i];
        }
    }

    var buttons = menu.getElementsByTagName("button");

    for (i = 0; i < buttons.length; i++) {
        var button = buttons[i];
        var word = keywordMenuWordCache[i] || "";
        button._keywordWord = word;
        button._keywordKey = lower(word);
        button._keywordMenu = menu;
        button.onclick = keywordMenuButtonClicked;
        menu._keywordButtons.push(button);
    }

    menu._keywordSignature = signature;
}

function buildKeywordMenuStructure(menu, ownerDocument, signature) {
    if (
        keywordMenuMarkupSignature === signature
        && keywordMenuMarkupCache
    ) {
        menu.innerHTML = keywordMenuMarkupCache;
        hydrateKeywordMenuStructure(menu, signature);
        return;
    }
    menu.innerHTML = "";
    menu._keywordButtons = [];
    keywordMenuWordCache = [];

    var title = ownerDocument.createElement("div");
    title.className = "contextTitle";

    var ratingLabel = ownerDocument.createElement("span");
    ratingLabel.innerText = "Rating:";
    title.appendChild(ratingLabel);

    var ratingStars = ownerDocument.createElement("span");
    ratingStars.className = "contextRatingStars";
    title.appendChild(ratingStars);

    var ratingCount = ownerDocument.createElement("span");
    ratingCount.className = "contextRatingCount";
    title.appendChild(ratingCount);
    menu.appendChild(title);

    menu._keywordRatingStars = ratingStars;
    menu._keywordRatingCount = ratingCount;

    if (!state.keywords.length) {
        var empty = ownerDocument.createElement("div");
        empty.className = "smallMuted";
        empty.style.padding = "8px";
        empty.innerText = "No keywords defined.";
        menu.appendChild(empty);
        menu._keywordSignature = signature;
        keywordMenuMarkupSignature = signature;
        keywordMenuMarkupCache = menu.innerHTML;
        return;
    }

    var groups = getCachedKeywordGroups();
    var groupIndex;

    for (groupIndex = 0; groupIndex < groups.length; groupIndex++) {
        var group = groups[groupIndex];
        var groupElement = ownerDocument.createElement("div");
        groupElement.className = "contextKeywordGroup";

        var buttons = ownerDocument.createElement("div");
        buttons.className = "contextKeywordButtons";

        var wordIndex;

        for (wordIndex = 0; wordIndex < group.words.length; wordIndex++) {
            var word = group.words[wordIndex];
            var button = ownerDocument.createElement("button");
            button.type = "button";
            button._keywordWord = word;
            button._keywordKey = lower(word);
            button._keywordMenu = menu;
            keywordMenuWordCache.push(word);

            var label = ownerDocument.createElement("span");
            label.innerText = keywordControlText(word);
            button.appendChild(label);

            button.onclick = keywordMenuButtonClicked;
            buttons.appendChild(button);
            menu._keywordButtons.push(button);
        }

        groupElement.appendChild(buttons);
        menu.appendChild(groupElement);
    }

    menu._keywordSignature = signature;
    keywordMenuMarkupSignature = signature;
    keywordMenuMarkupCache = menu.innerHTML;
}

function renderKeywordMenu(
    menu,
    ownerDocument,
    parent,
    targetParents
) {
    var signature = joinKeywords(state.keywords);

    if (
        menu._keywordSignature !== signature
        || !menu._keywordButtons
    ) {
        buildKeywordMenuStructure(menu, ownerDocument, signature);
    }

    var parentRating = parseInt(parent.rating, 10) || 0;

    if (parentRating < 0) {
        parentRating = 0;
    } else if (parentRating > 9) {
        parentRating = 9;
    }

    var targets = normalizeKeywordMenuTargets(parent, targetParents);

    menu._keywordParent = parent;
    menu._keywordTargets = targets;
    menu._keywordRatingStars.innerText =
        parentRating ? ratingStarsText(parentRating) : "";
    menu._keywordRatingCount.innerText = String(parentRating);

    var assignedCounts = {};
    var assignedAll = {};
    var assignedAny = {};
    var i;
    var j;

    for (i = 0; i < targets.length; i++) {
        var targetWords = targets[i].keywords || [];

        for (j = 0; j < targetWords.length; j++) {
            var key = lower(targetWords[j]);
            assignedCounts[key] = (assignedCounts[key] || 0) + 1;
        }
    }

    for (i = 0; i < state.keywords.length; i++) {
        key = lower(state.keywords[i]);
        assignedAny[key] = !!assignedCounts[key];
        assignedAll[key] = targets.length > 0
            && assignedCounts[key] === targets.length;
    }

    menu._keywordAssignedAll = assignedAll;
    menu._keywordAssignedAny = assignedAny;

    for (i = 0; i < menu._keywordButtons.length; i++) {
        updateKeywordMenuButtonState(
            menu._keywordButtons[i],
            assignedAll,
            assignedAny,
            targets.length
        );
    }
}

function primeKeywordMenu() {
    var menu = document.getElementById("contextMenu");

    if (!menu) {
        return false;
    }

    renderKeywordMenu(
        menu,
        document,
        { rating: 0, keywords: [], path: "", name: "" }
    );
    menu.style.display = "none";
    return true;
}

function showKeywordContext(
    parent,
    x,
    y,
    centered,
    targetParents
) {
    var menu = document.getElementById("contextMenu");

    renderKeywordMenu(
        menu,
        document,
        parent,
        targetParents
    );

    menu.style.left = "0px";
    menu.style.top = "0px";
    menu.style.display = "block";

    var margin = 8;
    var maximumLeft =
        document.documentElement.clientWidth
        - menu.offsetWidth
        - margin;
    var maximumTop =
        document.documentElement.clientHeight
        - menu.offsetHeight
        - margin;

    if (centered) {
        x = Math.round(
            (document.documentElement.clientWidth - menu.offsetWidth) / 2
        );
        y = Math.round(
            (document.documentElement.clientHeight - menu.offsetHeight) / 2
        );
    }

    menu.style.left =
        Math.max(margin, Math.min(x, maximumLeft))
        + "px";
    menu.style.top =
        Math.max(margin, Math.min(y, maximumTop))
        + "px";
}

function hideInlineKeywordMenu() {
    document.getElementById("contextMenu").style.display = "none";

    if (state.libraryCacheDirty) {
        scheduleLibraryCacheSave(50);
    }
}

function hideContextMenu() {
    hideInlineKeywordMenu();

    if (keywordPopup) {
        try {
            if (!keywordPopup.closed) {
                keywordPopup.close();
            }
        } catch (error) {
        }

        keywordPopup = null;
    }
}

function keywordPopupStyleText() {
    if (keywordPopupCssText) {
        return keywordPopupCssText;
    }

    var cssText = "";
    var i;

    for (i = 0; i < document.styleSheets.length; i++) {
        try {
            cssText += document.styleSheets[i].cssText || "";
        } catch (error) {
        }
    }

    keywordPopupCssText = cssText;
    return keywordPopupCssText;
}

function openKeywordPopupWindow(
    popupWidth,
    screenX,
    screenY,
    popupFeatures
) {
    var popupWindow = null;

    if (window.showModelessDialog) {
        try {
            var dialogFeatures =
                "dialogWidth:" + popupWidth + "px;"
                + "dialogHeight:240px;"
                + "dialogLeft:" + parseInt(screenX, 10) + "px;"
                + "dialogTop:" + parseInt(screenY, 10) + "px;"
                + "center:no;"
                + "dialogHide:no;"
                + "edge:raised;"
                + "help:no;"
                + "resizable:no;"
                + "scroll:no;"
                + "status:no;";

            popupWindow = window.showModelessDialog(
                "about:blank",
                window,
                dialogFeatures
            );
        } catch (dialogError) {
            popupWindow = null;
        }
    }

    if (!popupWindow) {
        popupWindow = window.open(
            "about:blank",
            "GallerySlideshowKeywordWindow",
            popupFeatures
        );
    }

    return popupWindow;
}

function resizeKeywordPopupWindow(
    popupWindow,
    width,
    height
) {
    try {
        popupWindow.resizeTo(width, height);
        return true;
    } catch (error) {
        return false;
    }
}

function moveKeywordPopupWindow(popupWindow, left, top) {
    try {
        popupWindow.moveTo(left, top);
        return true;
    } catch (error) {
        return false;
    }
}

function showKeywordPopup(
    parent,
    screenX,
    screenY,
    workLeft,
    workTop,
    workRight,
    workBottom
) {
    try {
        if (keywordPopup && !keywordPopup.closed) {
            keywordPopup.close();
        }

        var availableLeft = parseInt(workLeft, 10);
        var availableTop = parseInt(workTop, 10);
        var availableRight = parseInt(workRight, 10);
        var availableBottom = parseInt(workBottom, 10);
        var availableWidth = availableRight - availableLeft;
        var availableHeight = availableBottom - availableTop;
        var popupWidth = 460;

        if (
            !isNaN(availableWidth)
            && availableWidth > 0
        ) {
            popupWidth = Math.min(
                Math.max(240, availableWidth - 16),
                Math.max(720, Math.floor(availableWidth * 0.78))
            );
        }

        var popupFeatures =
            "width=" + popupWidth
            + ",height=240"
            + ",left=" + parseInt(screenX, 10)
            + ",top=" + parseInt(screenY, 10)
            + ",toolbar=no"
            + ",location=no"
            + ",directories=no"
            + ",status=no"
            + ",menubar=no"
            + ",scrollbars=no"
            + ",resizable=no";

        keywordPopup = openKeywordPopupWindow(
            popupWidth,
            screenX,
            screenY,
            popupFeatures
        );

        if (!keywordPopup) {
            return false;
        }

        var popupWindow = keywordPopup;
        var popupDocument = popupWindow.document;
        var popupBody = popupDocument.body;
        var styleElement = popupDocument.createElement("style");
        var menu = popupDocument.createElement("div");
        var popupHeight;
        var frameWidth;
        var frameHeight;
        var outerWidth;
        var outerHeight;
        var left = parseInt(screenX, 10);
        var top = parseInt(screenY, 10);

        styleElement.type = "text/css";
        var popupHeads = popupDocument.getElementsByTagName("head");
        (popupHeads.length ? popupHeads[0] : popupBody).appendChild(
            styleElement
        );

        if (styleElement.styleSheet) {
            styleElement.styleSheet.cssText = keywordPopupStyleText();
        } else {
            styleElement.appendChild(
                popupDocument.createTextNode(keywordPopupStyleText())
            );
        }

        popupDocument.title = "Keywords - " + parent.name;
        popupDocument.oncontextmenu = function() {
            try {
                popupWindow.close();
            } catch (error) {
            }

            return false;
        };

        popupBody.style.margin = "0";
        popupBody.style.padding = "0";
        popupBody.style.width = popupWidth + "px";
        popupBody.style.height = "auto";
        popupBody.style.minHeight = "0";
        popupBody.style.overflow = "hidden";
        popupBody.style.background = "#1c2128";

        menu.className = "keywordMenuSurface";
        menu.style.display = "block";
        menu.style.position = "static";
        menu.style.width = popupWidth + "px";
        menu.style.maxWidth = popupWidth + "px";
        popupBody.appendChild(menu);

        renderKeywordMenu(menu, popupDocument, parent);
        popupHeight = Math.max(
            54,
            menu.scrollHeight || 0,
            menu.offsetHeight || 0
        );
        frameWidth = Math.max(
            0,
            (keywordPopup.outerWidth || 0)
            - (popupDocument.documentElement.clientWidth || 0)
        );
        frameHeight = Math.max(
            0,
            (keywordPopup.outerHeight || 0)
            - (popupDocument.documentElement.clientHeight || 0)
        );

        if (
            !isNaN(availableWidth)
            && !isNaN(availableHeight)
            && availableWidth > 0
            && availableHeight > 0
            && popupHeight + frameHeight > availableHeight - 16
            && popupWidth < availableWidth - 16
        ) {
            popupWidth = Math.max(240, availableWidth - 16);
            popupBody.style.width = popupWidth + "px";
            menu.style.width = popupWidth + "px";
            menu.style.maxWidth = popupWidth + "px";
            resizeKeywordPopupWindow(
                keywordPopup,
                popupWidth + frameWidth,
                Math.max(240, keywordPopup.outerHeight || 240)
            );
            popupHeight = Math.max(
                54,
                menu.scrollHeight || 0,
                menu.offsetHeight || 0
            );
        }

        outerWidth = popupWidth + frameWidth;
        outerHeight = popupHeight + frameHeight;

        if (
            !isNaN(availableLeft)
            && !isNaN(availableRight)
            && availableRight > availableLeft
        ) {
            left = Math.max(
                availableLeft,
                Math.min(left, availableRight - outerWidth)
            );
        }

        if (
            !isNaN(availableTop)
            && !isNaN(availableBottom)
            && availableBottom > availableTop
        ) {
            top = Math.max(
                availableTop,
                Math.min(top, availableBottom - outerHeight)
            );
        }

        resizeKeywordPopupWindow(
            popupWindow,
            outerWidth,
            outerHeight
        );
        moveKeywordPopupWindow(popupWindow, left, top);
        popupWindow.focus();

        popupWindow.onblur = function() {
            window.setTimeout(function() {
                try {
                    if (popupWindow.closed) {
                        return;
                    }

                    if (
                        popupWindow.document.hasFocus
                        && popupWindow.document.hasFocus()
                    ) {
                        return;
                    }

                    popupWindow.close();
                } catch (error) {
                }
            }, 80);
        };

        popupWindow.onunload = function() {
            if (keywordPopup === popupWindow) {
                keywordPopup = null;
            }

            if (state.libraryCacheDirty) {
                scheduleLibraryCacheSave(50);
            }
        };

        return true;
    } catch (error) {
        keywordPopup = null;
        return false;
    }
}

function showRequestedKeywordWindow(
    parentPath,
    screenX,
    screenY,
    workLeft,
    workTop,
    workRight,
    workBottom
) {
    var normalizedParentPath = normalizePath(parentPath);
    var parent = null;
    var cursorX = parseInt(screenX, 10);
    var cursorY = parseInt(screenY, 10);
    var hasCursorPosition = !isNaN(cursorX) && !isNaN(cursorY);
    var i;

    if (!normalizedParentPath) {
        return false;
    }

    var keywordData = readIni(keywordIniPath());
    state.keywords = parseKeywordList(
        getIniValue(keywordData, "Keywords", "List", "")
    );

    for (i = 0; i < state.parents.length; i++) {
        if (lower(state.parents[i].path) === lower(normalizedParentPath)) {
            parent = state.parents[i];
            parent.keywords = getParentKeywords(parent.path);
            parent.rating = getParentRating(parent.path);
            break;
        }
    }

    if (!parent) {
        parent = {
            path: normalizedParentPath,
            name: fso.GetFileName(normalizedParentPath),
            keywords: getParentKeywords(normalizedParentPath),
            rating: getParentRating(normalizedParentPath)
        };
    }

    if (hasCursorPosition) {
        if (!showKeywordPopup(
            parent,
            cursorX,
            cursorY,
            workLeft,
            workTop,
            workRight,
            workBottom
        )) {
            showKeywordContext(
                parent,
                cursorX - window.screenLeft,
                cursorY - window.screenTop,
                false
            );
        }
    } else {
        showKeywordContext(parent, 0, 0, true);
    }

    setStatus("Keywords: " + parent.name);
    return true;
}

function keywordWordsWithAssignment(words, word, checked) {
    var result = [];
    var found = false;
    var i;

    for (i = 0; i < words.length; i++) {
        if (lower(words[i]) === lower(word)) {
            found = true;

            if (!checked) {
                continue;
            }
        }

        result.push(words[i]);
    }

    if (checked && !found) {
        result.push(word);
    }

    return parseKeywordList(joinKeywords(result));
}

function toggleParentsKeyword(parents, word, checked) {
    var targets = normalizeKeywordMenuTargets(
        parents && parents.length ? parents[0] : null,
        parents
    );

    if (!targets.length || !state.root) {
        return false;
    }

    var path = keywordIniPath();
    var data = readIni(path);
    var changes = [];
    var rerenderRequired = false;
    var i;

    for (i = 0; i < targets.length; i++) {
        var target = targets[i];
        var section = encodeParentSection(target.path);
        var words = parseKeywordList(
            getIniValue(
                data,
                section,
                "Keywords",
                joinKeywords(target.keywords || [])
            )
        );
        var result = keywordWordsWithAssignment(
            words,
            word,
            checked
        );

        changes.push({
            parent: target,
            words: result,
            matchedBefore: parentMatches(target)
        });

        if (!result.length) {
            delete data[section];
        } else {
            if (!data[section]) {
                data[section] = {};
            }

            data[section].Keywords = joinKeywords(result);
        }
    }

    writeIni(path, data);

    for (i = 0; i < changes.length; i++) {
        refreshParentKeywordPresentation(
            changes[i].parent,
            changes[i].words
        );

        if (
            changes[i].matchedBefore
            !== parentMatches(changes[i].parent)
        ) {
            rerenderRequired = true;
        }
    }

    scheduleLibraryCacheSave(1200);

    if (rerenderRequired) {
        window.setTimeout(function() {
            renderParents();
        }, 0);
    }

    if (targets.length > 1) {
        setStatus(
            "Keyword "
            + (checked ? "assigned to " : "removed from ")
            + targets.length
            + " selected parents: "
            + word
        );
    }

    return true;
}

function toggleParentKeyword(parent, word, checked) {
    return toggleParentsKeyword([parent], word, checked);
}

function ensureBridge() {
    if (!fso.FileExists(bridgePath)) {
        alert("Missing bridge:\n\n" + bridgePath);
        return false;
    }
    try {
        shell.Run(
            '"' + bridgePath + '" --resident --takeover',
            0,
            false
        );
    } catch (error) {
        alert("Could not start the AutoHotkey bridge.\n\n" + error.message);
        return false;
    }
    return true;
}

function sendCommand(action, path) {
    var commandId = String(new Date().getTime()) + String(Math.floor(Math.random() * 10000));
    var tempPath = commandPath + ".tmp";
    var text =
        "[Command]\r\n" +
        "Id=" + commandId + "\r\n" +
        "Action=" + action + "\r\n" +
        "Path=" + (path || "") + "\r\n";

    try {
        if (fso.FileExists(tempPath)) {
            fso.DeleteFile(tempPath, true);
        }
        if (!writeText(tempPath, text, false)) {
            throw new Error("The command file is temporarily locked.");
        }

        if (fso.FileExists(commandPath)) {
            fso.DeleteFile(commandPath, true);
        }
        fso.MoveFile(tempPath, commandPath);
    } catch (error) {
        alert("Could not send command to bridge.\n\n" + error.message);
    }
}

function reloadParentKeywordsFromIni() {
    if (!state.root || !state.parents.length) {
        return false;
    }

    var i;

    for (i = 0; i < state.parents.length; i++) {
        state.parents[i].keywords = getParentKeywords(state.parents[i].path);
    }

    if (state.selectedParent) {
        var selectedPath = lower(state.selectedParent.path);

        for (i = 0; i < state.parents.length; i++) {
            if (lower(state.parents[i].path) === selectedPath) {
                state.selectedParent = state.parents[i];
                document.getElementById("galleryKeywords").innerText =
                    state.selectedParent.keywords.length
                    ? state.selectedParent.keywords.join(", ")
                    : "";
                break;
            }
        }
    }

    renderParents();
    saveLibraryCache();
    return true;
}

function processKeywordWindowRequest(data, currentParent) {
    var keywordWindowRequest = getIniValue(
        data,
        "Session",
        "KeywordWindowRequest",
        ""
    );
    var keywordWindowHandled = getIniValue(
        data,
        "Session",
        "KeywordWindowHandled",
        ""
    );

    if (
        !keywordWindowRequest
        || keywordWindowRequest === keywordWindowHandled
    ) {
        return false;
    }

    var keywordWindowParent = normalizePath(
        getIniValue(data, "Session", "KeywordWindowParent", "")
    );

    if (!showRequestedKeywordWindow(
        keywordWindowParent || currentParent,
        getIniValue(data, "Session", "KeywordWindowScreenX", ""),
        getIniValue(data, "Session", "KeywordWindowScreenY", ""),
        getIniValue(data, "Session", "KeywordWindowWorkLeft", ""),
        getIniValue(data, "Session", "KeywordWindowWorkTop", ""),
        getIniValue(data, "Session", "KeywordWindowWorkRight", ""),
        getIniValue(data, "Session", "KeywordWindowWorkBottom", "")
    )) {
        return false;
    }

    data.Session.KeywordWindowHandled = keywordWindowRequest;
    writeIni(sessionPath, data);
    return true;
}

function pollKeywordWindowRequest() {
    var data = readIni(sessionPath);
    var currentParent = normalizePath(
        getIniValue(data, "Session", "CurrentParent", "")
    );

    processKeywordWindowRequest(data, currentParent);
}

function pollSession() {
    pollThumbnailGeneration();

    var data = readIni(sessionPath);
    var currentParent = normalizePath(getIniValue(data, "Session", "CurrentParent", ""));
    var currentGallery = normalizePath(getIniValue(data, "Session", "CurrentGallery", ""));
    var keywordRevision = getIniValue(data, "Session", "KeywordRevision", "");
    var ratingRevision = getIniValue(data, "Session", "RatingRevision", "");
    var changed = lower(currentParent) !== lower(state.currentParentPath)
        || lower(currentGallery) !== lower(state.currentGalleryPath);
    var keywordsChanged = keywordRevision !== state.keywordRevision;
    var ratingsChanged = ratingRevision !== state.ratingRevision;
    var uniqueAvailabilityChanged =
        syncRandomUniqueAvailability(data);

    state.currentParentPath = currentParent;
    state.currentGalleryPath = currentGallery;
    state.keywordRevision = keywordRevision;
    state.ratingRevision = ratingRevision;

    if (keywordsChanged) {
        reloadParentKeywordsFromIni();
    }

    if (ratingsChanged) {
        refreshParentRatings();
    }

    processKeywordWindowRequest(data, currentParent);

    if (uniqueAvailabilityChanged) {
        refreshUniqueAvailabilityPresentation();
    }

    if (changed && currentGallery) {
        focusRunningGalleryThumbnail(
            currentGallery
        );
    } else if (changed && !keywordsChanged) {
        renderParents();
    }
}

function saveWindowPlacement() {
    try {
        var data = readIni(settingsPath);

        if (!data.HtmlWindow) {
            data.HtmlWindow = {};
        }

        data.HtmlWindow.X = String(window.screenLeft);
        data.HtmlWindow.Y = String(window.screenTop);
        data.HtmlWindow.Width = String(
            document.documentElement.clientWidth
        );
        data.HtmlWindow.Height = String(
            document.documentElement.clientHeight
        );

        writeIni(settingsPath, data);
    } catch (error) {
    }
}

function restoreWindowPlacement() {
    var data = readIni(settingsPath);
    var x = parseInt(getIniValue(data, "HtmlWindow", "X", ""), 10);
    var y = parseInt(getIniValue(data, "HtmlWindow", "Y", ""), 10);
    var width = parseInt(getIniValue(data, "HtmlWindow", "Width", ""), 10);
    var height = parseInt(getIniValue(data, "HtmlWindow", "Height", ""), 10);

    if (!isNaN(width) && !isNaN(height) && width >= 880 && height >= 600) {
        window.resizeTo(width, height);
    }
    if (!isNaN(x) && !isNaN(y)) {
        window.moveTo(x, y);
    }
}

function handleWindowScriptError(message, url, lineNumber) {
    var text = lower(String(message || ""));

    if (text.indexOf("another process") >= 0
        || text.indexOf("locked a portion") >= 0
        || text.indexOf("sharing violation") >= 0) {
        try {
            setStatus("A shared file was temporarily busy; retrying.");
        } catch (error) {
        }

        return true;
    }

    return false;
}

function keyboardShortcutHelpText() {
    return [
        "MANAGER",
        "F1 — Show or close this shortcut reference",
        "Ctrl+0…9 — Rate every selected parent gallery",
        "Ctrl+click — Add or remove a parent from the selection",
        "Esc — Close parent details; from the main view, request Exit",
        "",
        "SLIDESHOW NAVIGATION",
        "F1 — Show this combined shortcut reference",
        "Tab — Next gallery inside the current parent",
        "Ctrl+Tab — Next gallery from another parent",
        "Ctrl+0…9 — Rate the current parent gallery",
        "X — Toggle the current parent’s Keywords window",
        "Windows key tap — Switch between managed IrfanView and VLC; no viewer key is sent",
        "Enter — Close the current slideshow",
        "Esc — Confirm bridge/slideshow exit",
        "",
        "SLIDESHOW ASSISTANT — IMAGE CONTROLS",
        "Space — Next image",
        "Backspace or Ctrl tap — Previous image",
        "Shift tap — Add one slideshow pause step",
        "Shift+Space — Pause and mark the current view for crop capture",
        "Delete — Move the current image safely to _DELETE, then continue",
        "W / A / S / D — Pan the image",
        "Q / E — Zoom in / out",
        "Arrow or numpad navigation — Native pan/zoom; mark view as cropped",
        "L / R / H — Rotate left / rotate right / horizontal flip",
        "Ctrl+F — Copy the current image as the parent folder.jpg",
        "",
        "REMOTE",
        "Tab — Offer the next gallery and start the timeout",
        "Ctrl+Tab — Offer a gallery from the next parent",
        "Esc — Close Remote and cancel its pending offer"
    ].join("\r\n");
}

function isKeyboardShortcutHelpOpen() {
    return document.getElementById("shortcutHelpOverlay").style.display === "block";
}

function openKeyboardShortcutHelp() {
    document.getElementById("shortcutHelpText").innerText =
        keyboardShortcutHelpText();
    document.getElementById("shortcutHelpOverlay").style.display = "block";
    document.getElementById("shortcutHelpClose").focus();
    return false;
}

function closeKeyboardShortcutHelp() {
    document.getElementById("shortcutHelpOverlay").style.display = "none";
    return false;
}

function requestExit() {
    if (confirm(
        "Exit Gallery Slideshow Manager, close the current "
        + "IrfanView slideshow, and close all VLC players?"
    )) {
        managerExitRequested = true;
        sendCommand("exit", "");
        window.close();
    }
}

function setStatus(text) {
    document.getElementById("statusBar").innerText =
        "v" + APP_VERSION + " | " + text;
}

function readEmbeddedVersion(filePath, versionPattern) {
    var stream = null;

    try {
        stream = fso.OpenTextFile(filePath, 1, false);
        var fileText = stream.ReadAll();
        stream.Close();
        stream = null;

        var match = versionPattern.exec(fileText);
        return match ? match[1] : "";
    } catch (error) {
        if (stream) {
            try {
                stream.Close();
            } catch (closeError) {
            }
        }

        return "";
    }
}

function isNewerApplicationVersion(candidateVersion, runningVersion) {
    var candidateParts = String(candidateVersion).split(".");
    var runningParts = String(runningVersion).split(".");
    var partCount = Math.max(candidateParts.length, runningParts.length);
    var i;

    for (i = 0; i < partCount; i++) {
        var candidatePart = parseInt(candidateParts[i] || "0", 10);
        var runningPart = parseInt(runningParts[i] || "0", 10);

        if (isNaN(candidatePart) || isNaN(runningPart)) {
            return false;
        }
        if (candidatePart > runningPart) {
            return true;
        }
        if (candidatePart < runningPart) {
            return false;
        }
    }

    return false;
}

function pollForNewApplicationVersion() {
    if (versionRestartInProgress) {
        return;
    }

    var managerPath = appDir + "\\Gallery-Slideshow-Manager.hta";
    var managerVersion = readEmbeddedVersion(
        managerPath,
        /var\s+APP_VERSION\s*=\s*["']([^"']+)["']/
    );
    var bridgeVersion = readEmbeddedVersion(
        bridgePath,
        /SCRIPT_VERSION\s*:=\s*["']([^"']+)["']/
    );

    if (!managerVersion
        || managerVersion !== bridgeVersion
        || !isNewerApplicationVersion(managerVersion, APP_VERSION)) {
        versionRestartCandidate = "";
        versionRestartStableChecks = 0;
        return;
    }

    if (versionRestartCandidate === managerVersion) {
        versionRestartStableChecks++;
    } else {
        versionRestartCandidate = managerVersion;
        versionRestartStableChecks = 1;
    }

    if (versionRestartStableChecks < 2) {
        return;
    }

    versionRestartInProgress = true;
    setStatus(
        "Version "
        + managerVersion
        + " is ready. Restarting..."
    );

    try {
        shell.Run('"' + managerPath + '"', 1, false);
        window.setTimeout(function() {
            window.close();
        }, 500);
    } catch (error) {
        versionRestartInProgress = false;
        versionRestartCandidate = "";
        versionRestartStableChecks = 0;
        setStatus(
            "Version "
            + managerVersion
            + " is ready, but automatic restart failed."
        );
    }
}

function claimSingleManagerInstance() {
    if (!fso.FileExists(bridgePath)) {
        document.title =
            "Gallery Slideshow Manager "
            + APP_VERSION;
        return false;
    }

    managerInstanceToken =
        String(new Date().getTime())
        + "-"
        + String(
            Math.floor(Math.random() * 1000000)
        );

    document.title =
        "Gallery Slideshow Manager "
        + APP_VERSION
        + " ["
        + managerInstanceToken
        + "]";

    try {
        shell.Run(
            '"'
            + bridgePath
            + '" --claim-manager='
            + managerInstanceToken,
            0,
            false
        );
    } catch (error) {
        document.title =
            "Gallery Slideshow Manager "
            + APP_VERSION;
        return false;
    }

    window.setTimeout(function() {
        if (
            document.title.indexOf(
                "[" + managerInstanceToken + "]"
            ) >= 0
        ) {
            document.title =
                "Gallery Slideshow Manager "
                + APP_VERSION;
        }
    }, 2500);

    return true;
}

function initialize() {
    window.onerror = handleWindowScriptError;
    claimSingleManagerInstance();
    migrateLegacyDataToSharedTemp();
    restoreWindowPlacement();
    loadSettings();
    restoreActiveSlideshowType();
    syncRandomUniqueAvailability(
        readIni(sessionPath)
    );
    ensureBridge();
    renderKeywordFilters();
    renderRatingFilters();

    if (state.root && fso.FolderExists(state.root)) {
        loadKeywords();

        if (!loadLibraryCache()) {
            scanLibrary();
        }
    } else {
        renderParents();
        setStatus("Select the galleries root folder.");
    }

    primeKeywordMenu();

    document.onclick = function() {
        hideContextMenu();
    };

    document.oncontextmenu = function() {
        var menu = document.getElementById("contextMenu");

        if (menu && menu.style.display === "block") {
            hideContextMenu();
            window.event.cancelBubble = true;
            window.event.returnValue = false;
            return false;
        }

        return true;
    };

    window.onblur = function() {
        hideInlineKeywordMenu();
    };

    window.onresize = function() {
        updateFixedControlsLayout();

        if (isGalleryDialogOpen() && state.selectedParent) {
            sizeGalleryDialog(
                getAvailableParentGalleries(
                    state.selectedParent
                ).length
            );
        }
    };

    var content = document.getElementById("content");
    content.onscroll = scheduleVisibleThumbnailRefresh;

    var galleryGrid = document.getElementById("galleryGrid");
    galleryGrid.onscroll = scheduleVisibleThumbnailRefresh;

    document.onkeydown = function() {
        var eventObject = window.event;
        var keyCode = eventObject.keyCode;

        if (keyCode === 112) {
            eventObject.returnValue = false;

            if (isKeyboardShortcutHelpOpen()) {
                closeKeyboardShortcutHelp();
            } else {
                openKeyboardShortcutHelp();
            }

            return false;
        }

        if (
            eventObject.ctrlKey
            && !eventObject.altKey
            && !eventObject.shiftKey
            && (
                (keyCode >= 48 && keyCode <= 57)
                || (keyCode >= 96 && keyCode <= 105)
            )
        ) {
            eventObject.returnValue = false;
            assignSelectedParentRating(
                keyCode >= 96 ? keyCode - 96 : keyCode - 48
            );
            return false;
        }

        if (keyCode === 27) {
            eventObject.returnValue = false;

            if (isKeyboardShortcutHelpOpen()) {
                closeKeyboardShortcutHelp();
            } else if (isGalleryDialogOpen()) {
                closeGalleryDialog();
            } else {
                requestExit();
            }

            return false;
        }
    };

    window.onbeforeunload = function() {
        flushLibraryCacheIfDirty();
        saveWindowPlacement();

        if (!managerExitRequested) {
            sendCommand("managerclosed", "");
        }
    };

    updateFixedControlsLayout();
    scheduleVisibleThumbnailRefresh();
    pollSession();
    window.setInterval(pollSession, 1000);
    window.setInterval(pollKeywordWindowRequest, 100);
    window.setInterval(pollForNewApplicationVersion, 1000);
}
</script>
</head>
<body onload="initialize()">
<div id="appShell">
    <div id="fixedControls">
        <div id="topBar">
        <div id="optionsRollout">
            <button id="optionsRolloutHeader" type="button" aria-expanded="false" onclick="return toggleOptionsRollout();">
                <span id="optionsRolloutArrow">▸</span>
                <span id="optionsRolloutTitle">Options</span>
                <span id="optionsRolloutSummary">Gallery, backup and remote settings</span>
            </button>
            <div id="optionsRolloutBody">
                <div class="row">
                    <span class="label">Galleries root</span>
                    <input id="rootPath" class="grow" type="text" />
                    <button onclick="browseRoot()">Browse</button>
                    <button onclick="saveRoot()">Save &amp; refresh</button>
                </div>
                <div class="row">
                    <span class="label">Remote timeout</span>
                    <input id="remoteTimeoutSeconds" type="text" onkeyup="saveRemoteTimeout();" onchange="saveRemoteTimeout();" onblur="updateRemoteTimeoutOption();" />
                    <span class="label">seconds</span>
                    <span id="remoteTimeoutHint"></span>
                </div>
                <div class="row">
                    <span class="label">Backup directory</span>
                    <input id="backupPath" class="grow" type="text" />
                    <button onclick="browseBackupDirectory()">Browse</button>
                    <button onclick="saveBackupSettings()">Save backup path</button>
                    <button onclick="createBackups()">Back up now</button>
                    <button class="danger" onclick="revertFromBackups()">Revert from backup</button>
                </div>
            </div>
        </div>
        <div id="keywordsRollout">
            <button id="keywordsRolloutHeader" type="button" aria-expanded="false" onclick="return toggleKeywordsRollout();">
                <span id="keywordsRolloutArrow">▸</span>
                <span id="keywordsRolloutTitle">Keywords</span>
                <span id="keywordsRolloutSummary">Manage, include, exclude and save keyword filters</span>
            </button>
            <div id="keywordsRolloutBody">
                <div class="row">
                    <button id="keywordMatchModeButton" class="keywordMatchModeButton matchAny" type="button" onclick="return toggleKeywordMatchMode();"><span class="keywordMatchModeChoice matchAll">ALL</span><span class="keywordMatchModeSeparator">\</span><span class="keywordMatchModeChoice matchAny">ANY</span></button>
                    <span class="label">Keyword</span>
                    <input id="keywordName" type="text" />
                    <button onclick="addKeyword()">Add keyword</button>
                    <button onclick="renameKeyword()">Rename</button>
                    <button onclick="clearUnusedKeywords()">Clear unused</button>
                </div>
                <div class="row keywordFilterRow">
                    <div id="keywordFilters" class="grow"></div>
                </div>
            </div>
        </div>
        <div class="row filterPresetRow">
            <span class="label">Filter preset</span>
            <select id="filterPresetSelect" onchange="loadSelectedFilterPreset()"></select>
            <input id="filterPresetName" type="text" placeholder="New preset name" />
            <button id="saveFilterPresetButton" onclick="saveCurrentFilterPreset()">Save current filter</button>
            <button id="deleteFilterPresetButton" class="danger" onclick="deleteSelectedFilterPreset()">Delete filter</button>
            <span id="filterPresetHint"></span>
        </div>
        <div class="row">
            <span class="label">Search</span>
            <input id="searchInput" type="text" onkeyup="searchChanged()" />
        </div>
        <div class="row">
            <span class="label">Rating</span>
            <div id="ratingFilters"></div>
            <span id="ratingFilterHint"></span>
        </div>
        </div>

        <div id="toolbar">
            <div class="toolbarZone left">
                <button id="displayModeButton" class="toolbarControl toolbarCheckButton" type="button" onclick="displayModeChanged()"><span class="checkbuttonMark">✓</span><span>TILES</span></button>
                <button id="videoModeButton" class="toolbarControl toolbarCheckButton" type="button" onclick="toggleVideoMode()" title="Choose how videos open in VLC"><span class="checkbuttonMark">✓</span><span>VIDEOS</span></button>
                <button id="uniqueRandomButton" class="toolbarControl toolbarCheckButton" type="button" onclick="toggleUniqueRandom()"><span class="checkbuttonMark">✓</span><span>UNIQUE</span></button>
            </div>

            <div id="slideshowActions">
                <button id="mainSlideshowButton" class="toolbarControl toolbarCheckButton slideshowActionButton" type="button" onclick="startMainSlideshow()"><span class="checkbuttonMark">✓</span><span>SLIDESHOW</span></button>
                <button id="mainRandomSlideshowButton" class="toolbarControl toolbarCheckButton slideshowActionButton" type="button" onclick="startRandom()"><span class="checkbuttonMark">✓</span><span>RANDOM SLIDESHOW</span></button>
            </div>

            <div class="toolbarZone right">
                <button class="toolbarControl" type="button" onclick="openCurrentParent()">Open parent folder</button>
                <button id="restoreCropButton" class="toolbarControl" type="button" onclick="restoreSelectedCropBackups()" title="Copy every selected parent’s gallery _CROP images back without overwriting files">Restore Crop</button>
                <button class="toolbarControl" type="button" onclick="scanLibrary()" title="Rescan folders and rebuild the persistent cache">Refresh library</button>
                <button class="toolbarControl danger" type="button" onclick="requestExit()">Exit</button>
            </div>
        </div>
    </div>

    <div id="content">
        <div id="summaryBar">
            <div id="summaryTitle">Parent galleries</div>
            <div id="summaryText"></div>
        </div>
        <div id="parentGrid"></div>
        <div id="emptyState">No parent galleries match the current filters.</div>
    </div>

    <div id="statusBar">v1.02 | Ready.</div>
</div>

<div id="shortcutHelpOverlay" onclick="if (window.event.srcElement === this) closeKeyboardShortcutHelp();">
    <div id="shortcutHelpDialog" onclick="window.event.cancelBubble=true;">
        <div id="shortcutHelpHeader">
            <div id="shortcutHelpTitle">Keyboard shortcuts</div>
            <button id="shortcutHelpClose" type="button" onclick="return closeKeyboardShortcutHelp();">Close</button>
        </div>
        <pre id="shortcutHelpText"></pre>
    </div>
</div>

<div id="galleryOverlay" onclick="if (window.event.srcElement === this) closeGalleryDialog();">
    <div id="galleryDialog">
        <div id="galleryHeader">
            <div id="galleryHeaderText">
                <div id="galleryTitle"></div>
                <div id="galleryKeywords"></div>
            </div>
            <button onclick="openCurrentParent()">Open folder</button>
            <button class="primary" onclick="return startFirstAvailableGallery();">Start first gallery</button>
            <button id="startSelectedRandomButton" class="primary" onclick="startRandomFromSelectedGallery()">Start random slideshow</button>
            <button onclick="closeGalleryDialog()">Close</button>
        </div>
        <div id="galleryGrid"></div>
    </div>
</div>

<div id="contextMenu" class="keywordMenuSurface" onclick="window.event.cancelBubble=true;"></div>
</body>
</html>
